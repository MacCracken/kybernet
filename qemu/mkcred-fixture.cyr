# qemu/mkcred-fixture.cyr — generate the harness's argon2id credential fixture
# using kybernet's OWN Argon2id, with no external crypto dependency. (1.6.1)
#
# WHY THIS EXISTS
# ---------------
# build-initramfs.sh used to call scripts/mkcred.sh, which drives
# `openssl kdf ... ARGON2ID`. That is the right tool for an OPERATOR — a
# person provisioning a board has openssl, not a Cyrius toolchain — but it is
# the wrong dependency for a release gate: ARGON2ID landed in OpenSSL 3.2 and
# Ubuntu 24.04 runners ship 3.0.x, so the fixture was silently dropped, the
# argon2id credential pass skipped, and HARNESS_STRICT=1 (correctly) failed
# the build. The gate was demanding a property the environment could not
# supply.
#
# The repo already contains a byte-exact Argon2id: sigil's, the same one
# emergency_auth.cyr verifies with. Any machine that can build kybernet can
# therefore mint the fixture, which is exactly the set of machines that can
# run the harness.
#
# ⚠ THIS IS NOT A CROSS-CHECK, AND MUST NOT BE MISTAKEN FOR ONE. Generating
# and verifying with the same implementation proves they agree with each
# other, not that either is right. The independent check lives where it
# belongs: src/test.cyr carries records generated by OpenSSL 3.6 and asserts
# kybernet verifies them, so a sigil regression fails the unit suite. This
# file's job is narrower — produce a valid record on any build host.
#
# Prints one `v1$t$m$p$salt-hex$tag-hex` line to stdout. The password is fixed
# because the harness types it over the serial line; see qemu/boot-test.sh.

var g_log_fd = 0;
include "lib/thread_local.cyr"

# Matches scripts/mkcred.sh's defaults and emergency_auth.cyr's bounds:
# RFC 9106's memory-constrained option as OWASP states it.
var FIX_T = 2;
var FIX_M = 19456;
var FIX_P = 1;
var FIX_SALT = 16;
var FIX_TAG = 32;

# The harness's password. Deliberately the same string the legacy fixture
# uses, so the two auth passes differ in exactly one variable: the stored
# credential format.
var FIX_PW = "hunter2";

fn main(): i64 {
    alloc_init();

    var salt = alloc(FIX_SALT);
    # getrandom(2) via the stdlib. Fails closed rather than falling back to
    # anything weaker — a predictable salt in a fixture would quietly make the
    # gate assert less than it claims.
    if (random_bytes(salt, FIX_SALT) != FIX_SALT) {
        println("mkcred-fixture: CSPRNG failed");
        return 1;
    }

    var need = argon2_mem_bytes(FIX_M, FIX_P);
    if (need <= 0) {
        println("mkcred-fixture: bad parameters");
        return 1;
    }
    # alloc(), never fl_alloc — audit rule 24. This is not PID 1, but the
    # arena contract is the same one emergency_auth.cyr relies on and there is
    # no reason to demonstrate the wrong idiom here.
    var mem = alloc(need);
    if (mem == 0) {
        println("mkcred-fixture: arena allocation failed");
        return 1;
    }

    var tag = alloc(FIX_TAG);
    var rc = argon2id_into(mem, FIX_PW, strlen(FIX_PW), salt, FIX_SALT,
      FIX_T, FIX_M, FIX_P, tag, FIX_TAG);
    if (rc != 0) {
        println("mkcred-fixture: argon2id_into failed");
        return 1;
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "v1$");
    str_builder_add_int(sb, FIX_T);
    str_builder_add_cstr(sb, "$");
    str_builder_add_int(sb, FIX_M);
    str_builder_add_cstr(sb, "$");
    str_builder_add_int(sb, FIX_P);
    str_builder_add_cstr(sb, "$");
    str_builder_add_cstr(sb, hex_encode(salt, FIX_SALT));
    str_builder_add_cstr(sb, "$");
    str_builder_add_cstr(sb, hex_encode(tag, FIX_TAG));
    var rec = str_builder_build(sb);
    str_print(rec);
    println("");
    return 0;
}
var exit_code = main();
syscall(60, exit_code);
