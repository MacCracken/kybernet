# Build output
/build/
/rust-old/target/

# Resolved dependencies — populated by `cyrius deps` from `cyrius.cyml`
# and pinned by sha256 in `cyrius.lock`. Match the AGNOS-wide convention
# (agnosys / agnostik / libro / argonaut all gitignore lib/).
/lib/

# QEMU harness build artifacts — `qemu/build-initramfs.sh` stages a
# tree under `qemu/initramfs/` and bundles `initramfs.cpio.gz`. The
# checked-in shape lives in `qemu/build-initramfs.sh` only; the
# artifacts regenerate from it. Matches argonaut's qemu/ convention.
/qemu/initramfs/
/qemu/initramfs.cpio.gz

# Edge-boot harness fixture (1.5.7) — a second initramfs plus the
# dm-verity data/hash image pair, generated by build-initramfs.sh when
# veritysetup is available on the build host. Regenerates from the script;
# the images are random bytes and the root hash changes every build.
/qemu/initramfs-edge/
/qemu/initramfs-auth/
/qemu/initramfs-auth.cpio.gz
# The KDF-format auth fixture (1.5.9). Its credential is generated fresh by
# scripts/mkcred.sh on every build — a new CSPRNG salt each time — so it is
# an artifact by construction and must never be checked in.
/qemu/initramfs-auth-kdf/
/qemu/initramfs-auth-kdf.cpio.gz
/qemu/initramfs-edge.cpio.gz
/qemu/edge/

