[package]
name = "kybernet"
version = "${file:VERSION}"
description = "PID 1 init system for AGNOS"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/kybernet"
language = "cyrius"
cyrius = "6.5.35"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "build/kybernet"

# Cyrius-stdlib modules copied into lib/ by `cyrius deps`. Order matters:
# `syscalls` stays ahead of `io`/`process`, and `atomic` ahead of `sync`.
#
# Never put a `#` comment inside the array — the manifest parser stops
# collecting entries at one and silently truncates the list.
#
# Rationale for individual entries: CHANGELOG.md. Build rules: CLAUDE.md.
[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "syscalls",
    "io",
    "fs",
    "process",
    "hashmap",
    "tagged",
    "bayan",
    "fnptr",
    "callback",
    "freelist",
    "mmap",
    "chrono",
    "ct",
    "keccak",
    "thread",
    "thread_local",
    "atomic",
    "sync",
    "sakshi",
    "patra",
    "random",
    "slice",
    "trait",
    "net",
    "result",
    "assert",
    "bench",
]

# THIN sigil surface — kybernet must NOT pull the monolithic dist/sigil.cyr,
# whose x509/RSA/authenticode bignum banks add static .bss that DCE cannot
# strip. Two disjoint pieces:
#   1. mldsa + sha_ni + sha256 + hex — the crypto set libro's merkle/audit
#      path needs transitively. Mirrors libro's own `deps.sigil` block, and
#      must stay in sync with it: cyrius dedups both same-named sigil deps to
#      this root list, so this list has to cover libro's ed25519/hex too.
#   2. sigil-tpm — kybernet's own TPM surface (src/lib/edge_boot.cyr).
# dm-verity is deliberately not sourced from sigil; see CHANGELOG.md [1.4.0].
[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
tag = "3.12.9"
modules = ["dist/sigil-mldsa.cyr", "src/sha_ni.cyr", "src/sha256.cyr", "src/hex.cyr", "dist/sigil-tpm.cyr"]

[deps.agnostik]
git = "https://github.com/MacCracken/agnostik.git"
tag = "1.5.0"
modules = ["dist/agnostik.cyr"]

[deps.libro]
git = "https://github.com/MacCracken/libro.git"
tag = "2.8.12"
modules = ["dist/libro.cyr"]

# argonaut ships no dist bundle, so imports stay selective. Order mirrors
# argonaut's own src/main.cyr include order (cyrius resolves forward
# references in a single pass). src/pid1_harness.cyr is intentionally
# omitted — kybernet IS PID 1; that harness is argonaut's own test rig.
[deps.argonaut]
git = "https://github.com/MacCracken/argonaut.git"
tag = "1.12.0"
modules = [
    "src/types.cyr",
    "src/boot.cyr",
    "src/services.cyr",
    "src/process_mgmt.cyr",
    "src/resolver.cyr",
    "src/health.cyr",
    "src/notify.cyr",
    "src/tmpfiles.cyr",
    "src/audit.cyr",
    "src/audit_ext.cyr",
    "src/init.cyr",
    "src/security.cyr",
]
