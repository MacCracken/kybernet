# kybernet_test.cyr — integration test for upgraded kybernet modules
# Tests: Result returns, Option types, str_builder, callbacks

# Kybernet modules (stdlib + deps resolved via cyrius.toml)
# thread_local explicit include — see src/main.cyr for rationale (6.2.x no
# longer auto-includes the stdlib-pinned module into sigil's dep chain).
include "lib/thread_local.cyr"
include "src/lib/cmdline.cyr"
include "src/lib/log.cyr"
include "src/lib/console.cyr"
include "src/lib/console_io.cyr"
include "src/lib/termios.cyr"
include "src/lib/signals.cyr"
include "src/lib/reaper.cyr"
include "src/lib/privdrop.cyr"
include "src/lib/mount.cyr"
include "src/lib/cgroup.cyr"
include "src/lib/eventloop.cyr"
include "src/lib/notify.cyr"
include "src/lib/seccomp.cyr"
include "src/lib/sandbox.cyr"
include "src/lib/edge_boot.cyr"
include "src/lib/svc_config.cyr"
include "src/lib/emergency_auth.cyr"
include "src/lib/service_sandbox.cyr"
include "src/lib/restart_queue.cyr"
include "src/lib/boot_stages.cyr"

# log.cyr's slog() short-circuits on g_log_fd <= 0; we never call
# slog_init() in tests so the default 0 is the right starting state.
var g_log_fd = 0;

fn test_constants() {
    println("--- constants ---");
    assert_eq(SYS_READ, 0, "SYS_READ");
    assert_eq(SYS_MOUNT, 165, "SYS_MOUNT");
    assert_eq(SIGCHLD, 17, "SIGCHLD");
    assert_eq(EPOLLIN, 1, "EPOLLIN");
    assert_eq(TOKEN_SIGNAL, 1, "TOKEN_SIGNAL");
    assert_eq(TOKEN_HEALTH, 2, "TOKEN_HEALTH");
    return 0;
}

fn test_process() {
    println("--- process ---");
    var pid = sys_getpid();
    assert(pid > 0, "getpid");
    var ppid = sys_getppid();
    assert(ppid > 0, "getppid");
    return 0;
}

fn test_wait_macros() {
    println("--- wait ---");
    assert(WIFEXITED(0) == 1, "WIFEXITED(0)");
    assert_eq(WEXITSTATUS(256), 1, "WEXITSTATUS(256)");
    assert(WIFSIGNALED(9) == 1, "WIFSIG(9)");
    assert_eq(WTERMSIG(9), 9, "WTERMSIG(9)");
    return 0;
}

fn test_signals() {
    println("--- signals ---");
    var set = sigset_new();
    sigset_add(set, SIGCHLD);
    sigset_add(set, SIGTERM);
    sigset_add(set, SIGPWR);
    assert(sigset_has(set, SIGCHLD) == 1, "has SIGCHLD");
    assert(sigset_has(set, SIGKILL) == 0, "!has SIGKILL");
    assert_eq(classify_signal(SIGCHLD), SIG_CLASS_CHILD, "class CHLD");
    assert_eq(classify_signal(SIGTERM), SIG_CLASS_TERM, "class TERM");
    assert_eq(classify_signal(99), SIG_CLASS_NONE, "class unknown");
    assert(is_handled_signal(SIGCHLD) == 1, "handled SIGCHLD");
    assert(is_handled_signal(SIGKILL) == 0, "!handled SIGKILL");
    return 0;
}

fn test_epoll() {
    println("--- epoll ---");
    var ev = epoll_event_new(EPOLLIN, 42);
    assert_eq(load32(ev), EPOLLIN, "ev events");
    assert_eq(load64(ev + 4), 42, "ev data");
    var ts = timerspec_new(10, 1);
    assert_eq(load64(ts), 10, "interval");

    # Live epoll test
    var epfd_r = epoll_new();
    assert(is_ok(epfd_r) == 1, "epoll_create");
    if (is_ok(epfd_r) == 1) {
        var epfd = result_unwrap(epfd_r);
        var tfd_r = timer_new(1);
        if (is_ok(tfd_r) == 1) {
            var r = epoll_add_read(epfd, result_unwrap(tfd_r), TOKEN_WATCHDOG);
            assert(is_ok(r) == 1, "epoll_add");
            sys_close(result_unwrap(tfd_r));
        }
        owned_fd_close(epfd);
    }
    return 0;
}

# Regression test for 1.4.2 audit CRITICAL-1 — the level-triggered
# timerfd busy-spin that pinned PID 1 at 100% CPU forever.
#
# The shape that mattered: an armed timerfd registered EPOLLIN stays
# readable once it expires, so epoll_wait returns immediately on every
# subsequent call until the 8-byte expiration counter is read. Nothing
# in the tree read it. This asserts the two halves of the fix:
#   1. an expired, UNDRAINED timerfd reports ready repeatedly (the bug's
#      mechanism — proving the test actually exercises the condition),
#   2. after a drain, epoll_wait with timeout 0 reports nothing.
# Without (2) passing, the reactor spins.
fn test_timerfd_drain_clears_readiness() {
    println("--- timerfd drain (CRITICAL-1 regression) ---");
    var epfd_r = epoll_new();
    assert(is_ok(epfd_r) == 1, "drain: epoll_create");
    if (is_ok(epfd_r) == 0) { return 0; }
    var epfd = result_unwrap(epfd_r);

    # 1-second repeating timer, registered exactly as eventloop_setup does.
    var tfd_r = timer_new(1);
    assert(is_ok(tfd_r) == 1, "drain: timer_new");
    if (is_ok(tfd_r) == 0) { owned_fd_close(epfd); return 0; }
    var tfd = result_unwrap(tfd_r);
    assert(is_ok(epoll_add_read(epfd, tfd, TOKEN_WATCHDOG)) == 1, "drain: epoll_add");

    # Block until it fires (timeout well past the 1s interval).
    var first = epoll_wait_events(epfd, 8, 3000);
    assert_eq(vec_len(first), 1, "drain: timer fired");

    # UNDRAINED: still ready immediately. This is the busy-spin.
    var again = epoll_wait_events(epfd, 8, 0);
    assert_eq(vec_len(again), 1, "drain: undrained fd still ready (spin condition)");

    # Drain the expiration counter, then the fd must go quiet.
    var exp = timerfd_drain(tfd);
    assert(exp > 0, "drain: expiration count read");
    var quiet = epoll_wait_events(epfd, 8, 0);
    assert_eq(vec_len(quiet), 0, "drain: cleared readiness");

    sys_close(tfd);
    owned_fd_close(epfd);
    return 0;
}

# ---------------------------------------------------------------------
# 1.4.3 — per-service sandbox hook (audit HIGH-1) + the sandbox_from_config
# fail-open it depends on (audit MEDIUM-1).
fn test_pre_exec_hook() {
    println("--- pre_exec hook (HIGH-1) ---");

    # A service with NO policy must be a strict no-op: return 0 (proceed to
    # exec) without imposing no_new_privs on something that never asked to
    # be confined. This is what keeps 1.4.3 behaviour-identical for every
    # service that has not opted in.
    var plain = svc_def_new(str_from("plain"), str_from("t"), str_from("/bin/true"));
    assert_eq(svc_def_seccomp(plain), 0, "hook: no seccomp by default");
    assert_eq(svc_def_landlock(plain), 0, "hook: no landlock by default");
    assert_eq(svc_def_capabilities(plain), 0, "hook: no caps by default");
    assert_eq(kyb_pre_exec(plain), 0, "hook: no policy is a no-op");

    # A null definition must not fault — the hook runs in a forked child of
    # PID 1, where a fault is a dead service, not an exception.
    assert_eq(kyb_pre_exec(0), 0, "hook: null svc_def safe");

    # Capability policy while unprivileged must FAIL CLOSED. drop_caps_from_set
    # returns Err(PRIV_NOT_ROOT) off-root, and the hook must turn that into a
    # non-zero return so argonaut aborts the child (exit 126) rather than
    # exec'ing the service unconfined.
    if (is_root() == 0) {
        var confined = svc_def_new(str_from("confined"), str_from("t"), str_from("/bin/true"));
        svc_def_set_capabilities(confined, capability_set_new());
        assert_eq(kyb_pre_exec(confined), 1, "hook: cap drop failure fails closed");
    }
    return 0;
}

fn test_sandbox_from_config_fail_closed() {
    println("--- sandbox_from_config (MEDIUM-1) ---");

    # Empty config: nothing to confine, Ok.
    var empty = sandbox_config_new();
    assert(is_ok(sandbox_from_config(empty)) == 1, "sbx: empty is Ok");

    # An FS_NO_ACCESS rule used to `return 0` — a bare non-Result that
    # aborted the whole loop, so every LATER rule went unapplied and the
    # caller read 0 as success. Assert it is a Result now.
    var withnone = sandbox_config_new();
    vec_push(sandbox_fs_rules(withnone), filesystem_rule_new("/etc", FS_NO_ACCESS));
    var r_none = sandbox_from_config(withnone);
    assert(is_ok(r_none) == 1 || is_err_result(r_none) == 1, "sbx: NO_ACCESS returns a Result");

    # An unrecognised access must fail CLOSED with a real Err, never a bare 0
    # that reads as success.
    var bogus = sandbox_config_new();
    var br = filesystem_rule_new("/etc", 99);
    vec_push(sandbox_fs_rules(bogus), br);
    assert(is_err_result(sandbox_from_config(bogus)) == 1, "sbx: unknown access fails closed");
    return 0;
}

# Assemble a JSON document from short fragments. The service documents
# below would otherwise be single 150-260 character lines, which trips
# cyrlint's 120-column rule (and is unreadable besides).
fn _json_doc(parts) {
    var sb = str_builder_new();
    for (var i = 0; i < vec_len(parts); i = i + 1) {
        str_builder_add_cstr(sb, vec_get(parts, i));
    }
    return str_builder_build(sb);
}

fn _doc2(a, b) {
    var v = vec_new(); vec_push(v, a); vec_push(v, b);
    return _json_doc(v);
}

fn _doc3(a, b, c) {
    var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c);
    return _json_doc(v);
}

# ---------------------------------------------------------------------
# v1.5.0 — services actually come from config.
#
# Before 1.5.0 `load_config` never populated the services array, so
# `config_services(cfg)` was always empty, `resolve_service_waves`
# short-circuited, and start_services() was a no-op on every real boot.
# These assertions are the regression wall for that.
fn test_svc_config_parse() {
    println("--- svc config parse (1.5.0) ---");

    var doc = _doc3(
      "{\"services\":[{\"name\":\"alpha\",\"binary\":\"/bin/a\",",
      "\"args\":[\"-x\",\"1\"],\"depends_on\":[\"beta\"],\"type\":\"oneshot\",",
      "\"restart\":\"never\",\"enabled\":false,\"description\":\"A\"},{\"name\":\"beta\",\"binary\":\"/bin/b\"}]}");
    var root = json_v_parse(doc);
    assert(root != 0, "cfg: doc parses");

    var defs = svc_defs_from_json(root);
    assert_eq(vec_len(defs), 2, "cfg: two services parsed");

    var a = vec_get(defs, 0);
    assert(str_eq(svc_def_name(a), str_from("alpha")) == 1, "cfg: name");
    assert(str_eq(svc_def_binary(a), str_from("/bin/a")) == 1, "cfg: binary");
    assert(str_eq(svc_def_desc(a), str_from("A")) == 1, "cfg: description");
    assert_eq(vec_len(svc_def_args(a)), 2, "cfg: two args");
    assert(str_eq(vec_get(svc_def_args(a), 0), str_from("-x")) == 1, "cfg: arg0");
    assert_eq(vec_len(svc_def_deps(a)), 1, "cfg: one dep");
    assert_eq(svc_def_service_type(a), SVC_ONESHOT, "cfg: type parsed");
    assert_eq(svc_def_restart_policy(a), RESTART_NEVER, "cfg: restart parsed");
    # A real JSON `false` must disable the service. The pre-1.5.0 config
    # path compared against the STRING "false", so the spelling an operator
    # would actually write was ignored.
    assert_eq(svc_def_enabled(a), 0, "cfg: enabled:false honoured");

    # Defaults for the minimal entry.
    var b = vec_get(defs, 1);
    assert_eq(svc_def_enabled(b), 1, "cfg: enabled defaults on");
    assert_eq(vec_len(svc_def_args(b)), 0, "cfg: no args");
    assert_eq(svc_def_health_check(b), 0, "cfg: no health check");

    # --- rejection: entries that cannot be run must be skipped, not
    # --- silently registered half-built.
    var bad = json_v_parse(_doc2(
        "{\"services\":[{\"binary\":\"/bin/x\"},{\"name\":\"n\"},",
        "{\"name\":\"\",\"binary\":\"/bin/y\"},{\"name\":\"ok\",\"binary\":\"/bin/ok\"}]}"));
    assert_eq(vec_len(svc_defs_from_json(bad)), 1, "cfg: malformed entries skipped");

    # An unrecognised enum must reject the SERVICE, not default it — a typo
    # in `restart` should not silently become RESTART_ALWAYS.
    var typo = json_v_parse(_doc2(
        "{\"services\":[{\"name\":\"t\",\"binary\":\"/bin/t\",",
        "\"restart\":\"on_failure\"}]}"));
    assert_eq(vec_len(svc_defs_from_json(typo)), 0, "cfg: bad restart rejects service");
    var typo2 = json_v_parse(_doc2(
        "{\"services\":[{\"name\":\"t\",\"binary\":\"/bin/t\",",
        "\"type\":\"Simple\"}]}"));
    assert_eq(vec_len(svc_defs_from_json(typo2)), 0, "cfg: bad type rejects service");

    # Absent / wrong-typed services key yields an empty vec, never a crash.
    assert_eq(vec_len(svc_defs_from_json(json_v_parse(str_from("{}")))), 0, "cfg: no services key");
    assert_eq(vec_len(svc_defs_from_json(json_v_parse(str_from("{\"services\":5}")))), 0, "cfg: services not an array");
    assert_eq(vec_len(svc_defs_from_json(0)), 0, "cfg: null root safe");
    return 0;
}

# Per-service cgroup limits (1.5.5).
fn test_svc_config_limits() {
    println("--- svc config limits (1.5.5) ---");

    # No limits block -> field stays 0 ("no limits"), service still valid.
    var d0 = _doc3("{\"services\":[{\"name\":\"n\",\"binary\":\"/bin/n\"}", "]}", "");
    var r0 = json_v_parse(d0);
    var f0 = svc_defs_from_json(r0);
    assert_eq(vec_len(f0), 1, "lim: no-limits service parses");
    assert_eq(svc_def_cgroup_limits(vec_get(f0, 0)), 0, "lim: absent block -> 0");

    # A full block lands on the right fields. Distinct values so a wrong
    # offset shows as a collision rather than passing.
    var d1 = _doc3(
      "{\"services\":[{\"name\":\"c\",\"binary\":\"/bin/c\",\"limits\":{",
      "\"memory_max\":67108864,\"memory_high\":50331648,",
      "\"cpu_weight\":250,\"pids_max\":32}}]}");
    var r1 = json_v_parse(d1);
    var f1 = svc_defs_from_json(r1);
    assert_eq(vec_len(f1), 1, "lim: limited service parses");
    var cl = svc_def_cgroup_limits(vec_get(f1, 0));
    assert(cl != 0, "lim: cgroup_limits attached");
    assert_eq(cglim_memory_max(cl), 67108864, "lim: memory_max");
    assert_eq(cglim_memory_high(cl), 50331648, "lim: memory_high");
    assert_eq(cglim_cpu_weight(cl), 250, "lim: cpu_weight");
    assert_eq(cglim_pids_max(cl), 32, "lim: pids_max");
    # cpu_max is deliberately NOT settable from config yet. A single integer
    # to cpu.max is accepted by the kernel (cpu_max_write keeps the cgroup's
    # existing period and sets only the quota), so this is a scope choice,
    # not a technical block: "quota with an implicit period" is a confusing
    # thing to expose, and the file also takes the literal "max", which
    # _cgroup_write_u64 cannot emit. cpu_weight covers proportional sharing,
    # which is what a service config usually wants.
    assert_eq(cglim_cpu_max(cl), 0, "lim: cpu_max left unset");

    # An all-zero block carries no policy — leave the field null so the
    # start path sees "no limits" rather than "limits, none set".
    var d2 = _doc3("{\"services\":[{\"name\":\"z\",\"binary\":\"/bin/z\",",
      "\"limits\":{\"memory_max\":0,\"pids_max\":0}}]}", "");
    var f2 = svc_defs_from_json(json_v_parse(d2));
    assert_eq(vec_len(f2), 1, "lim: all-zero block still valid");
    assert_eq(svc_def_cgroup_limits(vec_get(f2, 0)), 0, "lim: all-zero -> no limits");
    return 0;
}

# Malformed limits must REJECT the service, not start it unlimited — the
# same contract the security block uses. An operator who configured a
# memory cap and silently got none is in the position 1.5.2 refused to
# leave them in for capabilities.
fn test_svc_config_limits_rejects() {
    println("--- svc config limits rejection (1.5.5) ---");

    # Not an object.
    var a = svc_defs_from_json(json_v_parse(_doc3(
          "{\"services\":[{\"name\":\"a\",\"binary\":\"/bin/a\",\"limits\":7}]}", "", "")));
    assert_eq(vec_len(a), 0, "lim: non-object block rejected");

    # Non-integer value.
    var b = svc_defs_from_json(json_v_parse(_doc3(
          "{\"services\":[{\"name\":\"b\",\"binary\":\"/bin/b\",",
          "\"limits\":{\"memory_max\":\"64M\"}}]}", "")));
    assert_eq(vec_len(b), 0, "lim: string value rejected (no suffix parsing)");

    # Negative. fmt_int_buf would write "-1", which the kernel rejects with
    # EINVAL — leaving the service silently unlimited. Catch it at parse.
    var c = svc_defs_from_json(json_v_parse(_doc3(
          "{\"services\":[{\"name\":\"c\",\"binary\":\"/bin/c\",",
          "\"limits\":{\"pids_max\":-1}}]}", "")));
    assert_eq(vec_len(c), 0, "lim: negative rejected");

    # cpu.weight is 1..10000 in cgroup v2; outside that the kernel EINVALs.
    var d = svc_defs_from_json(json_v_parse(_doc3(
          "{\"services\":[{\"name\":\"d\",\"binary\":\"/bin/d\",",
          "\"limits\":{\"cpu_weight\":20000}}]}", "")));
    assert_eq(vec_len(d), 0, "lim: cpu_weight above 10000 rejected");

    # memory.high above memory.max can never take effect.
    var e = svc_defs_from_json(json_v_parse(_doc3(
          "{\"services\":[{\"name\":\"e\",\"binary\":\"/bin/e\",\"limits\":{",
          "\"memory_max\":1000,\"memory_high\":2000}}]}", "")));
    assert_eq(vec_len(e), 0, "lim: memory_high above memory_max rejected");

    # And the boundary values that must be ACCEPTED.
    var ok = svc_defs_from_json(json_v_parse(_doc3(
          "{\"services\":[{\"name\":\"o\",\"binary\":\"/bin/o\",\"limits\":{",
          "\"cpu_weight\":1,\"memory_max\":2000,\"memory_high\":2000}}]}", "")));
    assert_eq(vec_len(ok), 1, "lim: cpu_weight 1 and high==max accepted");
    return 0;
}

fn test_svc_config_health_check() {
    println("--- svc config health check (1.5.0) ---");
    var doc = json_v_parse(_doc3(
        "{\"services\":[{\"name\":\"h\",\"binary\":\"/bin/h\",\"health_check\":{",
        "\"type\":\"tcp\",\"target\":\"127.0.0.1\",\"port\":8090,",
        "\"interval_ms\":5000,\"timeout_ms\":2000,\"retries\":4}}]}"));
    var defs = svc_defs_from_json(doc);
    assert_eq(vec_len(defs), 1, "hc: service parsed");
    var hc = svc_def_health_check(vec_get(defs, 0));
    assert(hc != 0, "hc: health check built");
    assert_eq(svc_hc_type(hc), HC_TCP_CONNECT, "hc: type");
    assert_eq(svc_hc_port(hc), 8090, "hc: port");
    assert_eq(svc_hc_retries(hc), 4, "hc: retries");

    # A malformed health_check must reject the service rather than start it
    # silently unmonitored.
    var badhc = json_v_parse(_doc2(
        "{\"services\":[{\"name\":\"h\",\"binary\":\"/bin/h\",",
        "\"health_check\":{\"type\":\"https\"}}]}"));
    assert_eq(vec_len(svc_defs_from_json(badhc)), 0, "hc: unknown type rejects service");
    return 0;
}

# The end-to-end property v1.5.0 exists to deliver: N services in config
# become N services argonaut has registered and can start by name.
fn test_config_services_reach_argonaut() {
    println("--- config -> argonaut registration (1.5.0) ---");
    var root = json_v_parse(_doc2(
        "{\"services\":[{\"name\":\"kyb-t1\",\"binary\":\"/bin/true\"},",
        "{\"name\":\"kyb-t2\",\"binary\":\"/bin/true\"}]}"));
    var cfg = argonaut_config_default();
    var dst = config_services(cfg);
    var parsed = svc_defs_from_json(root);
    for (var i = 0; i < vec_len(parsed); i = i + 1) { vec_push(dst, vec_get(parsed, i)); }
    assert_eq(vec_len(config_services(cfg)), 2, "e2e: config carries 2 services");

    var init = argonaut_init_new(cfg);

    # Registered set must include BOTH our config services and the mode
    # defaults — start_services resolves waves over this, and walking
    # config_services alone is what dropped every default before 1.5.0.
    var all = init_service_defs(init);
    assert(vec_len(all) >= 2, "e2e: registered set includes config services");

    # Lookup by cstr must resolve — this is the Str/cstr seam that made
    # every init_start_service return -1.
    assert(init_get_service(init, "kyb-t1") != 0, "e2e: t1 resolves by cstr");
    assert(init_get_service(init, "kyb-t2") != 0, "e2e: t2 resolves by cstr");

    # And the waves argonaut hands back must convert cleanly to those keys.
    var waves = resolve_service_waves(all);
    assert(waves != 0, "e2e: waves resolve (no dependency cycle)");
    var found = 0;
    for (var wi = 0; wi < vec_len(waves); wi = wi + 1) {
        var wave = vec_get(waves, wi);
        for (var si = 0; si < vec_len(wave); si = si + 1) {
            if (init_get_service(init, str_data(vec_get(wave, si))) != 0) { found = found + 1; }
        }
    }
    assert_eq(found, vec_len(all), "e2e: every wave name resolves via str_data");
    return 0;
}

# ---------------------------------------------------------------------
# v1.5.1 — boot stages that do something.
#
# Before 1.5.1 execute_boot_stage was `return 1` for all eleven arms plus
# default, so run_boot_stages always took the success branch,
# init_mark_step_failed was unreachable, and the caller's emergency path
# could never fire. These assert that each stage now produces an honest
# answer and that a required failure actually propagates.
fn test_boot_stage_results() {
    println("--- boot stages (1.5.1) ---");

    # Mounts: /proc and /sys are mounted wherever this test runs, so the
    # real check must pass rather than being hardcoded.
    assert_eq(execute_boot_stage_for(0, 0, STAGE_MOUNT_FS), STAGE_OK, "stage: mount_fs verifies");

    # udev is genuinely not performed by kybernet — devtmpfs covers /dev.
    # SKIP, not a false COMPLETE and not a failure.
    assert_eq(execute_boot_stage_for(0, 0, STAGE_DEVICE_MGR), STAGE_SKIP, "stage: device_mgr skips");

    # Rootfs verification only applies to an edge boot that asked for it.
    var plain = argonaut_config_default();
    assert_eq(execute_boot_stage_for(0, plain, STAGE_VERIFY_ROOTFS), STAGE_SKIP, "stage: verify skipped off-edge");
    assert_eq(execute_boot_stage_for(0, 0, STAGE_VERIFY_ROOTFS), STAGE_SKIP, "stage: verify skipped w/o config");

    # Reaching the final stage is its completion.
    assert_eq(execute_boot_stage_for(0, 0, STAGE_BOOT_COMPLETE), STAGE_OK, "stage: boot_complete");

    # An unknown stage must not silently pass as COMPLETE.
    assert_eq(execute_boot_stage_for(0, 0, 999), STAGE_SKIP, "stage: unknown does not pass");

    # Only service-group stages need services started first.
    assert_eq(boot_stage_needs_services(STAGE_MOUNT_FS), 0, "needs_services: mount no");
    assert_eq(boot_stage_needs_services(STAGE_SECURITY), 0, "needs_services: security no");
    assert_eq(boot_stage_needs_services(STAGE_DATABASE), 1, "needs_services: database yes");
    assert_eq(boot_stage_needs_services(STAGE_AGENT_RUNTIME), 1, "needs_services: agent yes");
    assert_eq(boot_stage_needs_services(STAGE_SHELL), 1, "needs_services: shell yes");
    return 0;
}

fn test_boot_stage_security_requires_hook() {
    println("--- boot stage: security (1.5.1) ---");
    # The security stage's real assertion is that the per-service sandbox
    # is armed BEFORE any service can spawn — a hook registered after the
    # first spawn confines nothing, so this is an ordering check.
    var prev = argonaut_set_pre_exec_hook(0);
    assert_eq(execute_boot_stage_for(0, 0, STAGE_SECURITY), STAGE_FAIL, "stage: security fails w/o hook");

    argonaut_set_pre_exec_hook(&kyb_pre_exec);
    assert_eq(execute_boot_stage_for(0, 0, STAGE_SECURITY), STAGE_OK, "stage: security ok with hook");
    argonaut_set_pre_exec_hook(prev);
    return 0;
}

fn test_boot_stage_service_groups() {
    println("--- boot stage: service groups (1.5.1) ---");
    # BOOT_RECOVERY so default_services() is empty — otherwise argonaut
    # registers its OWN `daimon` first and argonaut_init_new skips the
    # same-named one below (map_has guard), leaving the stage checking a
    # default that was never started.
    var cfg = config_set_boot_mode(argonaut_config_default(), BOOT_RECOVERY);

    # A oneshot that has run to completion counts as up.
    var ok_svc = svc_def_new(str_from("daimon"), str_from("d"), str_from("/bin/true"));
    svc_def_set_service_type(ok_svc, SVC_ONESHOT);
    vec_push(config_services(cfg), ok_svc);

    var init = argonaut_init_new(cfg);

    # Not yet started: the stage must report failure, not success.
    assert_eq(execute_boot_stage_for(init, cfg, STAGE_AGENT_RUNTIME), STAGE_FAIL, "group: not started fails");

    init_start_service(init, "daimon");
    assert_eq(execute_boot_stage_for(init, cfg, STAGE_AGENT_RUNTIME), STAGE_OK, "group: completed oneshot ok");

    # A group with no services in this deployment is SKIP — BOOT_MINIMAL
    # has no postgres, and that is not a failure.
    assert_eq(execute_boot_stage_for(init, cfg, STAGE_COMPOSITOR), STAGE_SKIP, "group: absent group skips");
    return 0;
}

# The property 1.5.1 exists to restore: a FAILING REQUIRED stage must be
# recorded as failed and must be visible to the caller. Before 1.5.1 no
# stage could fail, so init_mark_step_failed and the emergency path were
# both dead code.
fn test_required_stage_failure_propagates() {
    println("--- required stage failure (1.5.1) ---");
    var cfg = argonaut_config_default();
    var init = argonaut_init_new(cfg);

    # STAGE_MOUNT_FS is required=1 in every mode's sequence.
    assert_eq(init_mark_step_failed(init, STAGE_MOUNT_FS, "test"), 1, "fail: step marked failed");
    assert_eq(init_is_boot_complete(init), 0, "fail: required failure blocks boot-complete");

    # A SKIPPED step, by contrast, must NOT block boot completion —
    # that is the whole reason argonaut 1.10.1 grew the third state.
    var c2 = argonaut_config_default();
    var i2 = argonaut_init_new(c2);
    assert_eq(init_mark_step_skipped(i2, STAGE_DEVICE_MGR, "not performed"), 1, "skip: step marked skipped");
    var steps = init_boot_sequence(i2);
    var found_skipped = 0;
    for (var i = 0; i < vec_len(steps); i = i + 1) {
        if (load64(vec_get(steps, i) + 32) == STEP_SKIPPED) { found_skipped = 1; }
    }
    assert_eq(found_skipped, 1, "skip: status is STEP_SKIPPED");
    return 0;
}

# ---------------------------------------------------------------------
# v1.5.2 — per-service security profiles, expressed as config data.
fn test_security_profile_parse() {
    println("--- security profiles (1.5.2) ---");

    var doc = json_v_parse(_doc3(
        "{\"services\":[{\"name\":\"s\",\"binary\":\"/bin/s\",\"security\":{",
        "\"no_new_privs\":true,\"capabilities\":[\"cap_net_bind_service\",\"cap_kill\"],",
        "\"landlock\":[{\"path\":\"/usr\",\"access\":\"read-exec\"}],\"seccomp\":\"basic\"}}]}"));
    var defs = svc_defs_from_json(doc);
    assert_eq(vec_len(defs), 1, "sec: service parsed");
    var sd = vec_get(defs, 0);

    # Capabilities are a KEEP-list, carried as an agnostik capability_set.
    var caps = svc_def_capabilities(sd);
    assert(caps != 0, "sec: capability set built");
    var keep = capset_bounding(caps);
    assert_eq(vec_len(keep), 2, "sec: two capabilities kept");
    # The values must be KERNEL capability numbers — this is the assertion
    # that would have caught the pre-1.5.2 collision, where argonaut's
    # CAP_NET_BIND_SERVICE was 0 and CAP_SYS_ADMIN was 1.
    assert_eq(vec_get(keep, 0), 10, "sec: cap_net_bind_service = 10 (kernel)");
    assert_eq(vec_get(keep, 1), 5, "sec: cap_kill = 5 (kernel)");

    # Landlock rules land in an agnostik sandbox_config.
    var ll = svc_def_landlock(sd);
    assert(ll != 0, "sec: sandbox config built");
    assert_eq(vec_len(sandbox_fs_rules(ll)), 1, "sec: one fs rule");
    assert_eq(fsrule_access(vec_get(sandbox_fs_rules(ll), 0)), 3, "sec: read-exec = 3");

    # seccomp is a NAMED profile, not a hand-assembled syscall list.
    var pol = svc_def_seccomp(sd);
    assert(pol != 0, "sec: policy built");
    assert_eq(kyb_policy_kind(pol), SECCOMP_BASIC, "sec: seccomp basic");
    assert_eq(kyb_policy_no_new_privs(pol), 1, "sec: no_new_privs on");

    # 1.6.0 — Landlock is REQUIRED unless the operator says otherwise.
    # kyb_pre_exec used to treat sandbox_apply's Ok(1) ("this kernel has no
    # Landlock") as success, so a service with an explicit rule list started
    # completely unconfined while the hook reported it applied. The default
    # here is what makes the fix fail closed.
    assert_eq(kyb_policy_landlock_optional(pol), 0,
      "sec: landlock is REQUIRED by default (fail closed)");
    return 0;
}

# The explicit opt-out for a board on a pre-5.13 kernel. Without it, a
# service carrying landlock rules refuses to start there — which is correct,
# and which an operator must be able to override deliberately.
fn test_landlock_optional_optin() {
    println("--- landlock_optional opt-in (1.6.0) ---");
    var jb = str_builder_new();
    str_builder_add_cstr(jb, "{\"services\":[{\"name\":\"lax\",\"binary\":\"/bin/true\",");
    str_builder_add_cstr(jb, "\"security\":{\"landlock_optional\":true,");
    str_builder_add_cstr(jb, "\"landlock\":[{\"path\":\"/usr\",\"access\":\"read\"}]}}]}");
    var j = str_data(str_builder_build(jb));
    var root = json_v_parse_buf(j, strlen(j));
    assert(root != 0, "ll-opt: config parses");
    var defs = svc_defs_from_json(root);
    assert_eq(vec_len(defs), 1, "ll-opt: one service");
    var pol = svc_def_seccomp(vec_get(defs, 0));
    assert(pol != 0, "ll-opt: policy built");
    assert_eq(kyb_policy_landlock_optional(pol), 1,
      "ll-opt: landlock_optional true is honoured");
    assert_eq(kyb_policy_kind(pol), SECCOMP_NONE,
      "ll-opt: no seccomp key means SECCOMP_NONE, not basic");
    return 0;
}

fn test_security_profile_defaults_and_rejection() {
    println("--- security profile rejection (1.5.2) ---");

    # No security block: all three fields stay 0 and the hook is a no-op,
    # so a service that never opted in behaves exactly as before 1.5.2.
    var plain = svc_defs_from_json(json_v_parse(_doc2(
          "{\"services\":[{\"name\":\"p\",", "\"binary\":\"/bin/p\"}]}")));
    assert_eq(vec_len(plain), 1, "sec: plain service parses");
    assert_eq(svc_def_capabilities(vec_get(plain, 0)), 0, "sec: no caps by default");
    assert_eq(svc_def_seccomp(vec_get(plain, 0)), 0, "sec: no policy by default");

    # An EMPTY capability list means drop everything — distinct from absent.
    var dropall = svc_defs_from_json(json_v_parse(_doc2(
          "{\"services\":[{\"name\":\"d\",\"binary\":\"/bin/d\",",
          "\"security\":{\"capabilities\":[]}}]}")));
    assert_eq(vec_len(dropall), 1, "sec: drop-all parses");
    var dcaps = svc_def_capabilities(vec_get(dropall, 0));
    assert(dcaps != 0, "sec: empty list still builds a set");
    assert_eq(vec_len(capset_bounding(dcaps)), 0, "sec: keep-list empty = drop all");
    # no_new_privs defaults ON for anything that asked to be confined.
    assert_eq(kyb_policy_no_new_privs(svc_def_seccomp(vec_get(dropall, 0))), 1, "sec: nnp defaults on");

    # --- every malformed profile must REJECT THE SERVICE, never start it
    # --- unconfined. Running with confinement that could not be parsed is
    # --- strictly worse than not running.
    var badcap = json_v_parse(_doc2(
        "{\"services\":[{\"name\":\"b\",\"binary\":\"/bin/b\",",
        "\"security\":{\"capabilities\":[\"CAP_SYS_ADMIN\"]}}]}"));
    assert_eq(vec_len(svc_defs_from_json(badcap)), 0, "sec: uppercase cap name rejected");

    var badcap2 = json_v_parse(_doc2(
        "{\"services\":[{\"name\":\"b\",\"binary\":\"/bin/b\",",
        "\"security\":{\"capabilities\":[\"cap_not_real\"]}}]}"));
    assert_eq(vec_len(svc_defs_from_json(badcap2)), 0, "sec: unknown cap rejected");

    var badacc = json_v_parse(_doc2(
        "{\"services\":[{\"name\":\"b\",\"binary\":\"/bin/b\",\"security\":{",
        "\"landlock\":[{\"path\":\"/usr\",\"access\":\"rwx\"}]}}]}"));
    assert_eq(vec_len(svc_defs_from_json(badacc)), 0, "sec: unknown access rejected");

    var badsec = json_v_parse(_doc2(
        "{\"services\":[{\"name\":\"b\",\"binary\":\"/bin/b\",",
        "\"security\":{\"seccomp\":\"paranoid\"}}]}"));
    assert_eq(vec_len(svc_defs_from_json(badsec)), 0, "sec: unknown seccomp profile rejected");

    var nopath = json_v_parse(_doc2(
        "{\"services\":[{\"name\":\"b\",\"binary\":\"/bin/b\",",
        "\"security\":{\"landlock\":[{\"access\":\"read\"}]}}]}"));
    assert_eq(vec_len(svc_defs_from_json(nopath)), 0, "sec: landlock rule without path rejected");
    return 0;
}

# The capability numbers kybernet links must be the KERNEL's. Both agnostik
# and argonaut define `enum LinuxCapability` with the same member names, and
# kybernet links both — so "last definition wins" decided which numbers the
# privilege drop actually used. Before 1.5.2 argonaut's won and they were an
# arbitrary 13-entry ordering: CAP_SYS_ADMIN was 1, so "keep CAP_SYS_ADMIN"
# kept CAP_DAC_OVERRIDE. `1 << cap` goes straight to capset(2).
fn test_capability_numbers_are_kernel() {
    println("--- capability numbers (1.5.2) ---");
    assert_eq(CAP_CHOWN, 0, "cap: chown 0");
    assert_eq(CAP_DAC_OVERRIDE, 1, "cap: dac_override 1");
    assert_eq(CAP_KILL, 5, "cap: kill 5");
    assert_eq(CAP_SETUID, 7, "cap: setuid 7");
    assert_eq(CAP_NET_BIND_SERVICE, 10, "cap: net_bind_service 10");
    assert_eq(CAP_NET_ADMIN, 12, "cap: net_admin 12");
    assert_eq(CAP_SYS_CHROOT, 18, "cap: sys_chroot 18");
    assert_eq(CAP_SYS_PTRACE, 19, "cap: sys_ptrace 19");
    assert_eq(CAP_SYS_ADMIN, 21, "cap: sys_admin 21");
    assert_eq(CAP_SYS_TIME, 25, "cap: sys_time 25");
    assert_eq(CAP_FOWNER, 3, "cap: fowner 3");
    assert_eq(CAP_FSETID, 4, "cap: fsetid 4");
    assert_eq(CAP_SETGID, 6, "cap: setgid 6");
    assert_eq(CAP_NET_RAW, 13, "cap: net_raw 13");
    # The tail agnostik had shifted by two before its 1.4.1.
    assert_eq(CAP_SYSLOG, 34, "cap: syslog 34");
    assert_eq(CAP_AUDIT_READ, 37, "cap: audit_read 37");
    assert_eq(CAP_BPF, 39, "cap: bpf 39");
    assert_eq(CAP_CHECKPOINT_RESTORE, 40, "cap: checkpoint_restore 40");
    return 0;
}

# ---------------------------------------------------------------------
# v1.5.3 — lifecycle cleanup and observability.
# _cg_have_controller is the guard that stops kybernet writing "+memory" to
# a kernel that has no memory controller (which returns EINVAL). It is a
# whole-token match, and the substring cases below are the ones that matter:
# "mem" must not match "memory", and "memory" must not match "memory_foo".
fn test_cgroup_controller_probe() {
    println("--- cgroup controller probe (1.5.5) ---");
    var hay = "cpuset cpu io memory hugetlb pids rdma misc dmem";
    var hl = strlen(hay);

    assert_eq(_cg_have_controller(hay, hl, "memory", 6), 1, "ctrl: memory found");
    assert_eq(_cg_have_controller(hay, hl, "pids", 4), 1, "ctrl: pids found");
    assert_eq(_cg_have_controller(hay, hl, "cpuset", 6), 1, "ctrl: first token found");
    assert_eq(_cg_have_controller(hay, hl, "dmem", 4), 1, "ctrl: last token found");
    assert_eq(_cg_have_controller(hay, hl, "cpu", 3), 1, "ctrl: cpu found as its own token");

    # Substring hazards — "mem" is a prefix of "memory" and a suffix of
    # "dmem", and neither may count as a match.
    assert_eq(_cg_have_controller(hay, hl, "mem", 3), 0, "ctrl: prefix does not match");
    assert_eq(_cg_have_controller(hay, hl, "emory", 5), 0, "ctrl: suffix does not match");
    assert_eq(_cg_have_controller(hay, hl, "memoryx", 7), 0, "ctrl: longer does not match");
    assert_eq(_cg_have_controller(hay, hl, "freezer", 7), 0, "ctrl: absent controller");

    # A real cgroup.controllers read ends in a newline; the tokenizer has
    # to treat that as a separator or the last controller is never found.
    var nl = "cpu memory pids\n";
    assert_eq(_cg_have_controller(nl, strlen(nl), "pids", 4), 1, "ctrl: trailing newline ok");

    # Empty contents — a kernel with no controllers at all.
    assert_eq(_cg_have_controller("", 0, "memory", 6), 0, "ctrl: empty haystack");
    return 0;
}

# 1.5.5 hardening. Both of these are reachable from PID 1, where a null
# dereference is a kernel panic rather than a crash report.
fn test_cgroup_apply_null_guard() {
    println("--- cgroup apply null guard (1.5.5) ---");
    # cglim_memory_max(0) would be a load64(0). The live call site guards,
    # but the function must not depend on that.
    var r = cgroup_apply_limits("kyb-null-t", 0);
    assert(is_err_result(r) == 0, "apply: null limits is Ok, not a fault");
    var r2 = cgroup_apply_resource_limits("kyb-null-t", 0);
    assert(is_err_result(r2) == 0, "apply: null rlimits is Ok, not a fault");

    # An all-zero cgroup_limits writes nothing — every field's 0 is the
    # "unset" sentinel, so this must succeed without touching the
    # filesystem (the cgroup does not exist here, so any write would fail).
    var cl = cgroup_limits_new();
    assert(is_err_result(cgroup_apply_limits("kyb-null-t", cl)) == 0,
      "apply: all-zero limits writes nothing");
    return 0;
}

fn test_cgroup_teardown() {
    println("--- cgroup teardown (1.5.3) ---");
    # remove_service_cgroup must go through the SAME cached path builder as
    # create/move, and must invalidate the cache entry on the way out — a
    # re-created service at the same name must not inherit a stale path.
    var before = cgroup_path("kyb-teardown-t");
    assert(str_contains(before, "kyb-teardown-t") == 1, "teardown: path built");

    # Removing a cgroup that was never created fails (ENOENT) rather than
    # reporting success — the shutdown sweep relies on the Result to count
    # what it actually removed.
    var r = remove_service_cgroup("kyb-teardown-t");
    assert(is_err_result(r) == 1, "teardown: absent cgroup errors");

    # Name validation still applies on the teardown path: an unsafe name
    # must never reach rmdir. create/move reject it (1.4.2 MEDIUM-3), so
    # teardown must not be the hole in that guard.
    assert_eq(cgroup_name_is_safe("../../etc"), 0, "teardown: traversal name unsafe");
    assert_eq(cgroup_name_is_safe("good-name_1.svc"), 1, "teardown: normal name safe");
    return 0;
}

fn test_reload_config_is_narrow() {
    println("--- reload scope (1.5.3) ---");
    # The reload applies live-safe scalars and refuses to swap structural
    # state. This asserts the SHAPE of that promise: argonaut derives the
    # boot sequence and service map at construction, so a reload that
    # replaced the config pointer alone would leave them stale — and one
    # that rebuilt them would orphan every running service.
    var cfg = argonaut_config_default();
    var init = argonaut_init_new(cfg);

    var seq_before = init_boot_sequence(init);
    var names_before = vec_len(init_service_names(init));
    assert(seq_before != 0, "reload: boot sequence exists");

    # Simulate what reload_config does to the live config: scalars only.
    var live = load64(init);
    store64(live + 16, 12345);
    store64(live + 24, 6789);
    assert_eq(config_boot_timeout(load64(init)), 12345, "reload: boot timeout applied");
    assert_eq(config_shutdown_timeout(load64(init)), 6789, "reload: shutdown timeout applied");

    # Structural state must be untouched by that.
    assert_eq(init_boot_sequence(init), seq_before, "reload: boot sequence not swapped");
    assert_eq(vec_len(init_service_names(init)), names_before, "reload: service map not swapped");
    return 0;
}

fn test_edge_budget_predicate() {
    println("--- edge boot budget (1.5.3) ---");
    var now = monotonic_ms();
    # max_ms <= 0 means no budget configured — never over.
    assert_eq(_eb_over_budget(now, 0), 0, "budget: unset is never over");
    assert_eq(_eb_over_budget(now, 0 - 1), 0, "budget: negative is never over");
    # A budget that has not elapsed yet.
    assert_eq(_eb_over_budget(now, 600000), 0, "budget: generous is not over");
    # A start time far in the past against a tiny budget is over. This is
    # the case the pre-1.5.3 code could observe but never act on, because
    # it only looked once, after every step it was meant to bound.
    assert_eq(_eb_over_budget(now - 5000, 10), 1, "budget: elapsed is over");
    return 0;
}

# ---------------------------------------------------------------------
# v1.5.4 — completing the Rust port: the deferred-restart queue. (CHANGELOG 1.5.4)
fn test_restart_queue() {
    println("--- restart queue (1.5.4) ---");
    restart_queue_clear();
    assert_eq(restart_queue_len(), 0, "rq: starts empty");
    assert_eq(restart_queue_pop_due(1000000), 0, "rq: empty pops nothing");

    # Schedule two with different delays.
    assert_eq(restart_queue_push("svc-a", 1000), 1, "rq: push a");
    assert_eq(restart_queue_push("svc-b", 5000), 1, "rq: push b");
    assert_eq(restart_queue_len(), 2, "rq: two queued");

    # Dedup by CONTENT, not pointer — a name from a reaped entry and the
    # same name from a health result are different cstr pointers. Without
    # this the health path, which re-evaluates every tick, would exhaust
    # the queue within a minute.
    assert_eq(restart_queue_push("svc-a", 9999), 0, "rq: duplicate rejected");
    assert_eq(restart_queue_len(), 2, "rq: still two");

    # Nothing due yet.
    assert_eq(restart_queue_pop_due(500), 0, "rq: nothing due at t=500");

    # The SHORTER delay was pushed FIRST here, so make the harder case
    # explicit below; at t=2000 only svc-a is due.
    var due = restart_queue_pop_due(2000);
    assert(due != 0, "rq: svc-a due at t=2000");
    assert_eq(streq(due, "svc-a"), 1, "rq: popped svc-a");
    assert_eq(restart_queue_len(), 1, "rq: one left");
    assert_eq(restart_queue_pop_due(2000), 0, "rq: svc-b is not due at t=2000");

    # And later it is.
    assert_eq(streq(restart_queue_pop_due(6000), "svc-b"), 1, "rq: svc-b due at t=6000");
    assert_eq(restart_queue_len(), 0, "rq: drained");
    return 0;
}

# The unsorted-queue invariant the Rust original documented: entries are
# pushed with DIFFERENT delays (an exponential crash backoff, a flat 1 s
# health delay, a 2 s watchdog delay), so the queue is not ordered by
# restart_at. A pop that stopped at the first future entry would let one
# long-backoff service block every shorter one behind it — indefinitely.
fn test_restart_queue_scans_whole_queue() {
    println("--- restart queue ordering (1.5.4) ---");
    restart_queue_clear();
    # LONG delay pushed first, SHORT second — the case that breaks a
    # head-only scan.
    assert_eq(restart_queue_push("slow", 60000), 1, "rq: push slow first");
    assert_eq(restart_queue_push("fast", 1000), 1, "rq: push fast second");

    var due = restart_queue_pop_due(2000);
    assert(due != 0, "rq: found the due entry behind a future one");
    assert_eq(streq(due, "fast"), 1, "rq: popped fast, not blocked by slow");
    assert_eq(restart_queue_len(), 1, "rq: slow still queued");
    assert_eq(restart_queue_pop_due(2000), 0, "rq: slow still not due");
    restart_queue_clear();
    return 0;
}

# Emergency-shell authentication (1.5.4 — the last rust-old port gap).
#
# kybernet builds the config from argonaut's emergency_shell_default() and
# overlays require_auth / auth_password_hash from config.json. The default
# hard-codes both to 0, so without the overlay the gate could never engage
# regardless of what an operator configured. These pin the three verdicts.
# Terminal attribute control (1.5.8). The unit suite has no tty, so what is
# assertable here is the ABI and the not-a-terminal path — the one that must
# never be treated as an error, because a redirected stdin is normal.
# 1.6.1 — the structured-logging path had ZERO coverage.
#
# slog/slog2 run on every klog and klog2, they write into a static 1 KiB
# buffer, and they hand-roll JSON escaping — three properties that want a
# test and had none. The escaper is the part that matters: a service name or
# an error string containing a quote or a control byte would otherwise
# produce a log line no JSON parser can read, and structured logs exist to
# be parsed.
# 1.6.1 — the first unit coverage main.cyr's helpers have ever had.
#
# `_read_line_fd`'s overflow answer is the one that matters: until 1.6.0 it
# returned the TRUNCATED prefix, so a password longer than the buffer was
# verified as a different password, denied, and a denial halts PID 1. It now
# answers -2, and that is a contract worth a test rather than a comment.
fn test_console_io_helpers() {
    println("--- console_io helpers (1.6.1) ---");

    # _u64_str: NUL-terminated, because every cstr logging path calls strlen.
    assert_eq(strlen(_u64_str(0)), 1, "u64_str: 0 is one char");
    assert(streq(_u64_str(0), "0") == 1, "u64_str: 0");
    assert(streq(_u64_str(7), "7") == 1, "u64_str: 7");
    assert(streq(_u64_str(608), "608") == 1, "u64_str: 608");
    assert(streq(_u64_str(4294967296), "4294967296") == 1, "u64_str: past 32 bits");

    # --- _read_line_fd, driven through a real pipe ---------------------
    var fds = alloc(16);
    assert_eq(sys_pipe(fds), 0, "readline: pipe created");
    var rfd = load32(fds);
    var wfd = load32(fds + 4);

    # A whole line: the newline terminates and is not included.
    sys_write(wfd, "hunter2\n", 8);
    var buf = alloc(64);
    assert_eq(_read_line_fd(rfd, buf, 64, 2000), 7, "readline: returns the length without the newline");
    assert(streq(buf, "hunter2") == 1, "readline: NUL-terminates at the newline");

    # A CR terminates too — a serial console sends them.
    sys_write(wfd, "abc\r", 4);
    assert_eq(_read_line_fd(rfd, buf, 64, 2000), 3, "readline: CR also terminates");
    assert(streq(buf, "abc") == 1, "readline: CR content");

    # ⚠ OVERFLOW IS -2, NOT A TRUNCATED PREFIX. cap=8 leaves 7 usable bytes.
    sys_write(wfd, "0123456789abcdef\n", 17);
    assert_eq(_read_line_fd(rfd, buf, 8, 2000), 0 - 2,
      "readline: an over-long line is an ERROR, never a silent truncation");

    sys_close(wfd);
    sys_close(rfd);

    # EOF is -1, distinct from the -2 above. A FRESH pipe, because the
    # overflow case above deliberately left its tail unread.
    var fds2 = alloc(16);
    assert_eq(sys_pipe(fds2), 0, "readline: second pipe created");
    var rfd2 = load32(fds2);
    var wfd2 = load32(fds2 + 4);
    sys_close(wfd2);
    assert_eq(_read_line_fd(rfd2, buf, 64, 200), 0 - 1, "readline: EOF with nothing buffered is -1");
    sys_close(rfd2);
    return 0;
}

fn test_slog_json() {
    println("--- structured logging (1.6.1) ---");

    # Disabled by default: every entry point short-circuits on g_log_fd <= 0,
    # which is the state a board is in when /var/log is unavailable.
    g_log_fd = 0;
    assert_eq(slog("info", "ignored"), 0, "slog: no-ops when the log fd is closed");
    assert_eq(slog2("info", "a", "b"), 0, "slog2: no-ops when the log fd is closed");

    # Point it at a real file and read back what it wrote.
    var path = "/tmp/kyb-slog-test.jsonl";
    sys_unlink(path);
    g_log_fd = sys_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(g_log_fd > 0, "slog: test log opened");

    slog("error", "plain");
    slog2("warn", "two-", "parts");
    # The escaping cases, all in one line: a quote, a backslash, a newline,
    # a tab, and a control byte that must become \u00XX.
    slog("info", "q\"b\\n\tc\x01d");
    sys_close(g_log_fd);
    g_log_fd = 0;

    # ⚠ strstr returns an INDEX, and -1 on a miss — NOT a C-style pointer
    # (string.cyr:154). A match at position 0 therefore returns 0, so the
    # test is `>= 0`; `!= 0` silently treats a match at the very start of the
    # buffer as a failure, which is exactly the first assertion below.
    var buf = alloc(2048);
    var n = file_read_all(path, buf, 2047);
    assert(n > 0, "slog: wrote something");
    store8(buf + n, 0);

    # Line 1: level and msg land in the right fields.
    assert(strstr(buf, "{\"level\":\"error\",\"msg\":\"plain\"}") >= 0,
      "slog: level and msg are separate JSON fields");
    # Line 2: slog2 concatenates its two parts into ONE msg value.
    assert(strstr(buf, "{\"level\":\"warn\",\"msg\":\"two-parts\"}") >= 0,
      "slog2: both parts land in one msg value");
    # Line 3: every metacharacter is escaped, so the line stays parseable.
    assert(strstr(buf, "q\\\"b") >= 0, "slog: a quote is backslash-escaped");
    assert(strstr(buf, "\\n") >= 0, "slog: a newline becomes \\n");
    assert(strstr(buf, "\\t") >= 0, "slog: a tab becomes \\t");
    assert(strstr(buf, "\\u0001") >= 0, "slog: a control byte becomes \\u00XX");
    # A raw newline inside the value would split the record in two.
    assert_eq(_count_lines(buf, n), 3, "slog: exactly three records, none split by a raw newline");

    sys_unlink(path);
    return 0;
}

fn _count_lines(buf, n) {
    var c = 0;
    for (var i = 0; i < n; i = i + 1) {
        if (load8(buf + i) == 10) { c = c + 1; }
    }
    return c;
}

fn test_termios() {
    println("--- termios (1.5.8) ---");

    # Values verified against the installed kernel headers, and arch-uniform:
    # x86's asm/ioctls.h and asm/termbits.h both #include <asm-generic/...>,
    # so these hold on aarch64 too. Pinned here so a future edit that
    # "tidies" them has to argue with a test.
    assert_eq(TCGETS, 0x5401, "termios: TCGETS");
    assert_eq(TCSETS, 0x5402, "termios: TCSETS");
    assert_eq(TCSETSF, 0x5404, "termios: TCSETSF");
    assert_eq(TERMIOS_ECHO, 0x8, "termios: ECHO bit");
    assert_eq(TERMIOS_ECHONL, 0x40, "termios: ECHONL bit");
    # 4*4 + 1 + 19 = 36 BYTES (rule 2), c_lflag the 4th 4-byte field.
    assert_eq(TERMIOS_SIZE, 36, "termios: struct is 36 bytes");
    assert_eq(TERMIOS_LFLAG_OFF, 12, "termios: c_lflag at +12");

    # A non-terminal must report cleanly, not error. /dev/null is exactly the
    # case kybernet hits on fd 0, and mis-handling it is what made the
    # emergency prompt unusable for four releases.
    var nullfd = sys_open("/dev/null", O_RDONLY, 0);
    if (nullfd >= 0) {
        assert_eq(termios_is_tty(nullfd), 0, "termios: /dev/null is not a tty");
        var sbuf = alloc(TERMIOS_SIZE);
        assert_eq(termios_get(nullfd, sbuf), 0, "termios: get on non-tty returns 0");
        # Must return 0, and must NOT fault — callers treat 0 as
        # "carry on with echo on", never as a reason to deny auth.
        assert_eq(termios_echo_off(nullfd, sbuf), 0, "termios: echo_off on non-tty returns 0");
        sys_close(nullfd);
    }

    # A closed/invalid fd is EBADF, same contract.
    var sbuf2 = alloc(TERMIOS_SIZE);
    assert_eq(termios_get(0 - 1, sbuf2), 0, "termios: get on bad fd returns 0");
    assert_eq(termios_is_tty(0 - 1), 0, "termios: bad fd is not a tty");

    # Null buffer must be rejected rather than dereferenced — this runs in
    # PID 1, where a fault is a kernel panic.
    assert_eq(termios_get(0, 0), 0, "termios: null buffer rejected");
    assert_eq(termios_set(0, 0, 0), 0, "termios: null buffer rejected on set");
    return 0;
}

fn test_emergency_auth() {
    println("--- emergency shell auth (1.5.4) ---");
    var esc = emergency_shell_default();

    # Default: no auth required, anything passes. This is the path every
    # existing deployment takes, so it must stay open.
    assert_eq(load64(esc + 24), 0, "emerg: default require_auth is off");
    assert_eq(verify_emergency_auth(esc, str_from("anything")), 1,
      "emerg: no auth required -> granted");

    # require_auth with NO hash must FAIL CLOSED. A misconfiguration that
    # returned "granted" here would hand out an unauthenticated root shell
    # on the console (argonaut 1.8.6 MEDIUM-3).
    store64(esc + 24, 1);
    store64(esc + 32, 0);
    assert_eq(verify_emergency_auth(esc, str_from("anything")), 0,
      "emerg: require_auth without a hash -> DENIED, not granted");

    # Correct password against a real stored hash.
    var pw = "hunter2";
    var good = password_hash(pw, 7);
    assert_eq(str_len(good), 64, "emerg: password_hash is 64 hex chars");
    store64(esc + 32, good);
    assert_eq(verify_emergency_auth(esc, str_from("hunter2")), 1,
      "emerg: correct password -> granted");
    assert_eq(verify_emergency_auth(esc, str_from("hunter3")), 0,
      "emerg: wrong password -> denied");
    assert_eq(verify_emergency_auth(esc, str_from("")), 0,
      "emerg: empty password -> denied");
    # A prefix of the right password must not pass — guards against a
    # length-blind compare.
    assert_eq(verify_emergency_auth(esc, str_from("hunter")), 0,
      "emerg: prefix of the password -> denied");
    return 0;
}

# ================================================================
# Emergency credential: format, bounds, verification (1.5.9)
# ================================================================
#
# The stored credential stopped being a bare unsalted SHA-256 hex digest at
# 1.5.9. These pin three separate things, and the third is the one that
# matters most for the migration:
#   1. the v1 record parses, bounds-checks, and verifies
#   2. the legacy 64-hex digest still verifies, unchanged
#   3. the two are DISJOINT — no input reaches the wrong arm
#
# ⚠ THE VECTORS ARE NOT SELF-GENERATED. Both records were produced by
# OpenSSL 3.6.3's `openssl kdf ... ARGON2ID`, an independent implementation:
#
#   salt=$(printf 'kybernet-test-01' | xxd -p)
#   openssl kdf -keylen 32 -kdfopt pass:hunter2 -kdfopt hexsalt:$salt \
#       -kdfopt iter:2 -kdfopt memcost:19456 -kdfopt lanes:1 -binary ARGON2ID
#
# So a green run here proves sigil's Argon2id agrees with OpenSSL byte for
# byte, not merely that it agrees with itself. It is also exactly what
# scripts/mkcred.sh emits, so the generator and the verifier are checked
# against each other rather than assumed to match.
var TV_SALT_HEX = "6b796265726e65742d746573742d3031";
# m=8192 KiB, t=1 — the cheap vector (~55 ms), so the suite does not pay
# the 230 ms default cost on every negative case. 8192 is the FLOOR: sigil
# would accept m=8, which fits in a GPU SM and buys nothing.
var TV_TAG_8192 = "ec828a05303abe80988a455c9ed2e4b07a0d5f089b1a375c105e96aa9a310640";
# m=19456 KiB, t=2, p=1 — the real default. RFC 9106's memory-constrained
# option as OWASP states it, and what Rust's Argon2::default() emits.
# A 16-byte tag: satisfies sigil's 4-byte floor, not RFC 9106 §4's 32.
var TV_TAG_16B = "182bc4a43ebb6d009ccafa43450d0bf9";
# The top of both accepted length ranges — 32-byte salt, 64-byte tag.
var TV_SALT_32B = "abababababababababababababababababababababababababababababababab";
# One nibble short of a 64-char tag — hex that cannot become whole bytes.
# ⚠ Built as its own cstr rather than str_sub()'d from another: str_sub
# ALIASES its parent without a NUL (str.cyr:42-52), so handing str_data() of
# a substring to str_builder_add_cstr reads straight past the end. That is
# the exact invariant src/lib/emergency_auth.cyr documents, and this test
# tripped over it.
fn TV_TAG_ODD() {
    var b = str_builder_new();
    str_builder_add_cstr(b, "182bc4a43ebb6d009ccafa43450d0bf9");
    str_builder_add_cstr(b, "34f584ab185e714d3d506538fb35399");
    return str_data(str_builder_build(b));
}

fn TV_TAG_64B() {
    var b = str_builder_new();
    str_builder_add_cstr(b, "8f01f7179b97bc3ed0b46c3f0da2c1810685d31f86bcc69463de89c1e");
    str_builder_add_cstr(b, "2b9281ef2ba2d57355ae00099c14617fa71b7251ecedf62d45f5c9d2");
    str_builder_add_cstr(b, "4201cdccdae1527");
    return str_data(str_builder_build(b));
}
# t=4, m=16384 — non-default costs, to prove parameters come from the record.
var TV_TAG_T4M16384 = "bf3417d3d08ca2fd02f0d7a91e2e3a61bc9fec792ac6e498842cddb8315e3373";
var TV_TAG_19456 = "2b314f63f14b4817f38b55e7c5c53e55a4973ce075d7a95ad2da3a4aa7c57c5e";

# Build a v1 record from its parts.
#
# The negative cases below used to be 140-character string literals in which
# the ONE field under test was buried — and they were the only thing keeping
# `cyrius lint` advisory in CI, since all 24 over-length warnings in the tree
# were these. Assembling them means each assertion now reads as the property
# it checks (`_rec("1", "8191", "1")` is "one KiB below the memory floor"),
# and the lint gate can become a hard one. 1.6.1.
fn _rec5(t, m, p, salt, tag) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "v1$");
    str_builder_add_cstr(sb, t);
    str_builder_add_cstr(sb, "$");
    str_builder_add_cstr(sb, m);
    str_builder_add_cstr(sb, "$");
    str_builder_add_cstr(sb, p);
    str_builder_add_cstr(sb, "$");
    str_builder_add_cstr(sb, salt);
    str_builder_add_cstr(sb, "$");
    str_builder_add_cstr(sb, tag);
    return str_builder_build(sb);
}

# The common shape: canonical salt, the cheap m=8192 tag.
fn _rec(t, m, p) { return _rec5(t, m, p, TV_SALT_HEX, TV_TAG_8192); }

fn _kind(rec) { return emerg_cred_kind(rec); }

# The two vectors the verify tests use, assembled the same way. Both were
# generated by OpenSSL 3.6.3's `openssl kdf ... ARGON2ID` — see
# test_emergency_cred_verify for why that matters.
fn TV_CHEAP() { return _rec("1", "8192", "1"); }
fn TV_REAL()  { return _rec5("2", "19456", "1", TV_SALT_HEX, TV_TAG_19456); }

fn _cred_kind_of(cs) {
    return emerg_cred_kind(str_from(cs));
}

fn test_emergency_cred_format() {
    println("--- emergency credential format (1.5.9) ---");

    # --- classification -------------------------------------------------
    assert_eq(emerg_cred_kind(0), EMERG_CRED_NONE, "cred: null is NONE");
    assert_eq(_cred_kind_of(""), EMERG_CRED_NONE, "cred: empty is NONE");
    assert_eq(_kind(TV_CHEAP()), EMERG_CRED_ARGON2ID, "cred: v1 record is ARGON2ID");
    assert_eq(_kind(TV_REAL()), EMERG_CRED_ARGON2ID, "cred: default-param record is ARGON2ID");

    # The 1.5.8 credential — sha256("hunter2"). This exact string is what
    # qemu/build-initramfs.sh has written since 1.5.8.
    var legacy = "f52fbd32b2b3b86ff88ef6c490628285f482af15ddcb29541f94bcf526a3f6c7";
    assert_eq(_cred_kind_of(legacy), EMERG_CRED_LEGACY, "cred: 64-hex is LEGACY");

    # --- the disjointness that makes downgrade impossible ---------------
    # A v1 record can never satisfy the legacy predicate: it contains '$'
    # and 'v', neither of which is a hex digit, and it is far longer than
    # 64 characters. Asserted from both directions so a future edit to
    # either predicate has to argue with a test.
    assert_eq(edge_is_hex64_str(TV_CHEAP()), 0, "cred: v1 record is NOT hex64");
    assert_eq(edge_is_hex64_str(TV_REAL()), 0, "cred: default record is NOT hex64");
    assert_eq(emerg_cred_parse(str_from(legacy), 0), 0, "cred: legacy digest does not parse as v1");

    # --- malformed records are refused, never downgraded ----------------
    # Every one of these is INVALID, not LEGACY — a truncated or corrupt v1
    # record must not fall back onto the unsalted path.
    assert_eq(_cred_kind_of("v1"), EMERG_CRED_INVALID, "cred: bare v1 is INVALID");
    assert_eq(_cred_kind_of("v1$"), EMERG_CRED_INVALID, "cred: v1$ is INVALID");
    assert_eq(_cred_kind_of("v1$2$19456$1"), EMERG_CRED_INVALID, "cred: truncated before salt is INVALID");
    assert_eq(_cred_kind_of("v1$2$19456$1$6b796265726e65742d746573742d3031"), EMERG_CRED_INVALID,
      "cred: missing tag field is INVALID");
    var v9 = _rec5("2", "19456", "1", TV_SALT_HEX, TV_TAG_8192);
    store8(str_data(v9) + 1, 57);      # "v1$..." -> "v9$...": an unknown version
    assert_eq(_kind(v9),
      EMERG_CRED_INVALID, "cred: unknown version is INVALID");
    assert_eq(_cred_kind_of("nonsense"), EMERG_CRED_INVALID, "cred: garbage is INVALID");
    # 63 hex chars — one short of legacy, and not v1 either.
    assert_eq(_cred_kind_of("f52fbd32b2b3b86ff88ef6c490628285f482af15ddcb29541f94bcf526a3f6c"),
      EMERG_CRED_INVALID, "cred: 63 hex chars is INVALID, not LEGACY");
    # A seventh field means the record carries something this version does
    # not understand. Guessing is how a format grows a silent second meaning.
    assert_eq(_kind(str_cat(_rec("1", "8192", "1"), str_from("$extra"))),
      EMERG_CRED_INVALID, "cred: a seventh field is INVALID");
    # Non-hex in the salt / tag.
    assert_eq(_kind(_rec5("1", "8192", "1", "zz796265726e65742d746573742d3031", TV_TAG_8192)),
      EMERG_CRED_INVALID, "cred: non-hex salt is INVALID");
    # Odd-length hex cannot be decoded into bytes.
    assert_eq(_kind(_rec5("1", "8192", "1", "6b796265726e65742d746573742d303", TV_TAG_8192)),
      EMERG_CRED_INVALID, "cred: odd-length salt hex is INVALID");
    assert_eq(_kind(_rec5("1", "8192", "1", TV_SALT_HEX, TV_TAG_ODD())),
      EMERG_CRED_INVALID, "cred: odd-length tag hex is INVALID");

    # --- parameter bounds (the roadmap's ceiling item) ------------------
    # These are the reason the ceiling exists: sigil applies a FLOOR to
    # m_cost and no ceiling at all, and argon2_mem_bytes has no overflow
    # check — m_cost = 2^54 + 1024 wraps its byte count down to 1 MiB, so
    # alloc() succeeds and the fill then runs far out of bounds. Inside
    # PID 1 that is a wild write. The bound is enforced during decimal
    # accumulation, so a long digit run is refused before it can wrap.
    assert_eq(_kind(_rec("2", "18014398509482928", "1")),
      EMERG_CRED_INVALID, "cred: m_cost 2^54+1024 refused (the wrap-to-1MiB wild write)");
    assert_eq(_kind(_rec("2", "99999999999999999999", "1")),
      EMERG_CRED_INVALID, "cred: 20-digit m_cost refused before overflow");
    assert_eq(_kind(_rec("2", "65537", "1")),
      EMERG_CRED_INVALID, "cred: m_cost one above the 64 MiB ceiling refused");
    assert_eq(_kind(_rec("9", "8192", "1")),
      EMERG_CRED_INVALID, "cred: t_cost above ceiling refused");
    # The floor sigil does NOT provide: it accepts m >= 8*p, i.e. 8 KiB at
    # p=1, which fits inside one GPU streaming multiprocessor's shared memory
    # and surrenders the entire memory-hardness argument.
    assert_eq(_kind(_rec("1", "64", "1")),
      EMERG_CRED_INVALID, "cred: m_cost 64 KiB refused (sigil would accept it)");
    assert_eq(_kind(_rec("1", "8191", "1")),
      EMERG_CRED_INVALID, "cred: m_cost one below the 8 MiB floor refused");
    # parallelism > 1: sigil fills lanes serially, so p>1 is free for the
    # attacker and worth nothing to the defender.
    assert_eq(_kind(_rec("1", "8192", "4")),
      EMERG_CRED_INVALID, "cred: parallelism 4 refused (serial fill, no defender gain)");
    # The work cap. Both factors are individually legal here; the product is
    # not — without it phase 6c could stall for tens of seconds on ARM.
    assert_eq(_kind(_rec("8", "65536", "1")),
      EMERG_CRED_INVALID, "cred: m*t above the work cap refused (65536 x 8)");
    assert_eq(_kind(_rec("2", "65536", "1")),
      EMERG_CRED_ARGON2ID, "cred: m*t exactly at the work cap accepted");
    # A 16-byte tag satisfies sigil (floor 4) but not RFC 9106 §4's 256 bits.
    assert_eq(_kind(_rec5("1", "8192", "1", TV_SALT_HEX, TV_TAG_16B)),
      EMERG_CRED_INVALID, "cred: 16-byte tag refused (RFC 9106 §4 wants 32)");
    # An 8-byte salt satisfies sigil (floor 8) but not RFC 9106 §4's 128 bits.
    assert_eq(_kind(_rec5("1", "8192", "1", "6b796265726e6574", TV_TAG_8192)),
      EMERG_CRED_INVALID, "cred: 8-byte salt refused (RFC 9106 §4 wants 16)");
    assert_eq(_kind(_rec("0", "8192", "1")),
      EMERG_CRED_INVALID, "cred: t_cost 0 refused (RFC floor)");
    assert_eq(_kind(_rec("1", "8192", "0")),
      EMERG_CRED_INVALID, "cred: parallelism 0 refused");
    assert_eq(_kind(_rec("1", "-64", "1")),
      EMERG_CRED_INVALID, "cred: negative m_cost refused (no sign accepted)");
    # m < 8*p is sigil's own floor; catching it here turns an unexplained
    # denial at phase 6c into a config error at load.
    assert_eq(_kind(_rec("1", "16", "4")),
      EMERG_CRED_INVALID, "cred: m_cost < 8*parallelism refused");
    # A salt below RFC 9106's 8-byte floor.
    assert_eq(_kind(_rec5("1", "8192", "1", "6b79626572", TV_TAG_8192)),
      EMERG_CRED_INVALID, "cred: 5-byte salt refused");

    # --- the parsed values are the record's, not the defaults -----------
    var prm = alloc(40);
    assert_eq(emerg_cred_parse(TV_REAL(), prm), 1, "cred: default record parses");
    assert_eq(load64(prm), 2, "cred: t_cost read from the record");
    assert_eq(load64(prm + 8), 19456, "cred: m_cost read from the record");
    assert_eq(load64(prm + 16), 1, "cred: parallelism read from the record");
    assert_eq(load64(prm + 24), 16, "cred: 16-byte salt");
    assert_eq(load64(prm + 32), 32, "cred: 32-byte tag");

    # `out` must be untouched on failure — a caller must never read half a
    # record. Poison the buffer and confirm a rejected parse leaves it.
    store64(prm, 0 - 7);
    assert_eq(emerg_cred_parse(str_from("v1$9$8192$1$6b796265726e65742d746573742d3031$182bc4a4"), prm), 0,
      "cred: out-of-range record fails to parse");
    assert_eq(load64(prm), 0 - 7, "cred: failed parse leaves out untouched");

    # --- identity, the predicate reload_config logs on -------------------
    # ⚠ Pointer equality is the wrong test here and this pins it: `_cfg_str`
    # builds a fresh Str box on every parse, so two reloads of an UNCHANGED
    # config produce two different pointers to identical bytes. A pointer
    # compare would announce a credential rotation on every SIGHUP.
    assert_eq(emerg_cred_same(0, 0), 1, "cred: absent equals absent");
    assert_eq(emerg_cred_same(0, TV_CHEAP()), 0, "cred: absent differs from present");
    assert_eq(emerg_cred_same(TV_CHEAP(), 0), 0, "cred: present differs from absent");
    assert_eq(emerg_cred_same(TV_CHEAP(), TV_CHEAP()), 1,
      "cred: identical records compare EQUAL across separate Str boxes");
    assert_eq(emerg_cred_same(TV_CHEAP(), TV_REAL()), 0,
      "cred: different records compare unequal");

    # --- usability gate feeding load_config -----------------------------
    assert_eq(emerg_cred_usable(TV_CHEAP()), 1, "cred: v1 is usable");
    assert_eq(emerg_cred_usable(str_from(legacy)), 1, "cred: legacy is usable");
    assert_eq(emerg_cred_usable(str_from("v1$bogus")), 0, "cred: malformed is NOT usable");
    assert_eq(emerg_cred_usable(0), 0, "cred: absent is NOT usable");
    return 0;
}

fn test_emergency_cred_verify() {
    println("--- emergency credential verification (1.5.9) ---");
    var esc = emergency_shell_default();

    # require_auth off short-circuits before any KDF work — the path every
    # existing deployment takes, and it must not have grown a 230 ms cost.
    store64(esc + 24, 0);
    store64(esc + 32, TV_CHEAP());
    assert_eq(kyb_verify_emergency_auth(esc, str_from("anything")), 1,
      "verify: no auth required -> granted without hashing");

    # Fail closed with no credential, exactly as argonaut 1.8.6 MEDIUM-3
    # established. A misconfiguration must not open a root shell.
    store64(esc + 24, 1);
    store64(esc + 32, 0);
    assert_eq(kyb_verify_emergency_auth(esc, str_from("anything")), 0,
      "verify: require_auth with no credential -> DENIED");

    # --- the v1 path, against an OpenSSL-generated vector ---------------
    store64(esc + 32, TV_CHEAP());
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter2")), 1,
      "verify: correct password against OpenSSL-generated v1 record");
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter3")), 0,
      "verify: wrong password denied");
    assert_eq(kyb_verify_emergency_auth(esc, str_from("")), 0,
      "verify: empty password denied");
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter")), 0,
      "verify: prefix of the password denied");
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter22")), 0,
      "verify: password with a trailing byte denied");

    # The real parameters, once. This is the 19 MiB / ~230 ms arena the
    # roadmap's fl_alloc item is about: it comes from alloc(), sized by
    # argon2_mem_bytes, and it is the only place the suite proves the
    # default-cost path actually runs inside kybernet.
    store64(esc + 32, TV_REAL());
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter2")), 1,
      "verify: m=19456 t=2 p=1 record verifies (19 MiB arena via alloc)");
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter3")), 0,
      "verify: m=19456 wrong password denied");

    # --- NON-DEFAULT parameters, which is the whole point of the format --
    # "Parameters are stored, not assumed." A record written under different
    # costs must still verify, or raising `m` one day silently invalidates
    # every credential already deployed — and the operator sees "wrong
    # password" on a password that is right. Both of these were generated by
    # OpenSSL at costs the module's own defaults do not use.
    store64(esc + 32, _rec5("4", "16384", "1", TV_SALT_HEX, TV_TAG_T4M16384));
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter2")), 1,
      "verify: t=4 m=16384 record verifies (parameters read from the record)");
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter3")), 0,
      "verify: t=4 m=16384 wrong password denied");

    # A 32-byte salt and a 64-byte tag — the top of both accepted ranges.
    # Sizing is driven by the record's own field lengths, not by a constant.
    store64(esc + 32, _rec5("1", "8192", "1", TV_SALT_32B, TV_TAG_64B()));
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter2")), 1,
      "verify: 32-byte salt + 64-byte tag record verifies");
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter3")), 0,
      "verify: 64-byte-tag wrong password denied");

    # --- the legacy path is byte-for-byte the 1.5.8 behaviour -----------
    # kyb_verify_emergency_auth delegates this arm to argonaut's
    # verify_emergency_auth rather than reimplementing SHA-256, so what is
    # asserted here is the same code 1.5.8 shipped.
    store64(esc + 32, password_hash("hunter2", 7));
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter2")), 1,
      "verify: legacy digest still authenticates (one-release migration)");
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter3")), 0,
      "verify: legacy digest rejects a wrong password");

    # --- an UPPERCASE legacy digest must still authenticate --------------
    # Hex is case-insensitive; argonaut's compare is not. `edge_is_hex64_str`
    # accepts A-F, so an uppercase SHA-256 digest — what Windows `certutil`,
    # PowerShell `Get-FileHash` and most online hashers emit — classified
    # LEGACY and was blessed as usable at load, while argonaut recomputed a
    # LOWERCASE digest and compared byte-exact. The verdict was 0 for EVERY
    # password, and a failed emergency authentication halts PID 1 forever.
    # The 1.5.4-1.5.7 brick through a different door, and the 1.5.9 validation
    # was the thing waving it through.
    store64(esc + 32, str_from("F52FBD32B2B3B86FF88EF6C490628285F482AF15DDCB29541F94BCF526A3F6C7"));
    assert_eq(emerg_cred_kind(str_from("F52FBD32B2B3B86FF88EF6C490628285F482AF15DDCB29541F94BCF526A3F6C7")),
      EMERG_CRED_LEGACY, "verify: uppercase digest classifies LEGACY");
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter2")), 1,
      "verify: UPPERCASE legacy digest authenticates (case-insensitive hex)");
    store64(esc + 32, str_from("F52FBD32B2B3B86FF88EF6C490628285F482AF15DDCB29541F94BCF526A3F6C7"));
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter3")), 0,
      "verify: uppercase digest still rejects a wrong password");
    # Mixed case is the same story and is what a hand-edited config produces.
    store64(esc + 32, str_from("f52FBD32b2b3B86ff88EF6c490628285F482af15DDCB29541f94BCF526a3F6C7"));
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter2")), 1,
      "verify: mixed-case legacy digest authenticates");

    # --- a malformed credential denies, it does not fall through --------
    store64(esc + 32, str_from("v1$2$19456$1$deadbeef"));
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter2")), 0,
      "verify: malformed credential denies");
    store64(esc + 32, str_from("not-a-credential"));
    assert_eq(kyb_verify_emergency_auth(esc, str_from("hunter2")), 0,
      "verify: unrecognised credential denies");

    # A null config must not be dereferenced — this runs in PID 1.
    assert_eq(kyb_verify_emergency_auth(0, str_from("hunter2")), 0,
      "verify: null config denied, not dereferenced");

    # Nor a null password, on EITHER arm. The guard used to be on the argon2id
    # arm only; the legacy arm reached argonaut, which does
    # `str_data(password_input)` — load64(0), a kernel panic in PID 1.
    store64(esc + 32, TV_CHEAP());
    assert_eq(kyb_verify_emergency_auth(esc, 0), 0,
      "verify: null password denied on the argon2id arm");
    store64(esc + 32, password_hash("hunter2", 7));
    assert_eq(kyb_verify_emergency_auth(esc, 0), 0,
      "verify: null password denied on the legacy arm, not dereferenced");
    return 0;
}

fn test_restart_queue_bounds() {
    println("--- restart queue bounds (1.5.4) ---");
    restart_queue_clear();
    # Storage is static (PID 1 runs for months; a vec would grow the bump
    # arena on every crash forever), so the queue has a hard ceiling and
    # must refuse rather than overrun it. Names must be distinct or dedup
    # rejects them first.
    var names = vec_new();
    for (var i = 0; i < RESTART_QUEUE_MAX; i = i + 1) {
        var b = alloc(24);
        var l = fmt_int_buf(i, b);
        store8(b + l, 0);
        vec_push(names, b);
        assert_eq(restart_queue_push(b, 100), 1, "rq: fill accepts");
    }
    assert_eq(restart_queue_len(), RESTART_QUEUE_MAX, "rq: at capacity");
    assert_eq(restart_queue_push("one-too-many", 100), 0, "rq: rejects past capacity");
    assert_eq(restart_queue_len(), RESTART_QUEUE_MAX, "rq: capacity not exceeded");

    # And it drains fully rather than wedging at the ceiling.
    var drained = 0;
    while (restart_queue_pop_due(1000) != 0) { drained = drained + 1; }
    assert_eq(drained, RESTART_QUEUE_MAX, "rq: drains completely");
    assert_eq(restart_queue_len(), 0, "rq: empty after drain");
    return 0;
}

fn test_notify_env_entry() {
    println("--- NOTIFY_SOCKET export (1.5.4) ---");
    var e = notify_env_entry();
    assert(e != 0, "notify: entry built");
    assert_eq(str_starts_with_cstr_kyb(e, "NOTIFY_SOCKET="), 1, "notify: KEY=value shape");
    # Cached — the entry must outlive every spawn, so it is built once into
    # arena storage rather than rebuilt per call.
    assert_eq(notify_env_entry(), e, "notify: cached, stable pointer");
    return 0;
}

# Tiny local prefix check — kybernet links both agnostik and yukti-era
# string helpers, so avoid depending on a particular str_starts_with.
fn str_starts_with_cstr_kyb(s, prefix) {
    var i = 0;
    while (1 == 1) {
        var pc = load8(prefix + i);
        if (pc == 0) { return 1; }
        if (load8(s + i) != pc) { return 0; }
        i = i + 1;
    }
    return 1;
}

