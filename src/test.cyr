fn _dbl(x) { return x * 2; }
fn _sum(a, x) { return a + x; }

fn test_callbacks() {
    println("--- callbacks ---");
    var v = vec_new();
    vec_push(v, 1);
    vec_push(v, 2);
    vec_push(v, 3);
    var mapped = vec_map(v, &_dbl);
    assert_eq(vec_get(mapped, 0), 2, "map");
    assert_eq(vec_fold(v, 0, &_sum), 6, "fold");
    return 0;
}

fn test_knotify_classify() {
    println("--- notify ---");
    assert_eq(knotify_classify("READY=1"), NOTIFY_READY, "parse READY");
    assert_eq(knotify_classify("STOPPING=1"), NOTIFY_STOPPING, "parse STOPPING");
    assert_eq(knotify_classify("WATCHDOG=1"), NOTIFY_WATCHDOG, "parse WATCHDOG");
    assert_eq(knotify_classify("RELOADING=1"), NOTIFY_RELOADING, "parse RELOADING");
    assert_eq(knotify_classify("STATUS=running"), NOTIFY_STATUS, "parse STATUS");
    assert_eq(knotify_classify("UNKNOWN"), NOTIFY_UNKNOWN, "parse unknown");
    var sv = notify_status_value("STATUS=all good");
    assert(sv != 0, "status value ptr");
    assert(memeq(sv, "all good", 8) == 1, "status value content");
    var sv2 = notify_status_value("READY=1");
    assert_eq(sv2, 0, "non-status returns 0");
    return 0;
}

fn test_seccomp_builder() {
    println("--- seccomp ---");
    var b = seccomp_builder_new();
    assert_eq(seccomp_count(b), 0, "empty builder");
    seccomp_allow(b, 0);
    seccomp_allow(b, 1);
    seccomp_allow(b, 3);
    assert_eq(seccomp_count(b), 3, "3 allowed");

    # Build filter
    var info_r = seccomp_build(b);
    assert(is_ok(info_r) == 1, "build ok");
    if (is_ok(info_r) == 1) {
        var info = result_unwrap(info_r);
        var fptr = seccomp_filter_ptr(info);
        var flen = seccomp_filter_len(info);
        # 3 allowed + 5 fixed instructions = 8 instructions * 8 bytes = 64.
        # The fixed five are: LD arch, JEQ arch, LD nr, RET KILL, RET ALLOW.
        assert_eq(flen, 64, "filter size");
        assert(fptr != 0, "filter ptr");

        # --- The architecture check (1.4.2 audit HIGH-3) ---
        # These three assertions are the regression test for the seccomp
        # ABI-switch bypass. A filter that loads seccomp_data.nr first and
        # never pins seccomp_data.arch is bypassable by issuing syscalls
        # under a different ABI, where the same numbers mean other calls.
        # insn0 must load arch (offset 4), NOT nr (offset 0).
        assert_eq(load16(fptr), BPF_LD_W_ABS, "insn0 LD");
        assert_eq(load32(fptr + 4), SECCOMP_DATA_ARCH_OFF, "insn0 loads arch");
        # insn1 must compare it against this build's AUDIT_ARCH.
        assert_eq(load16(fptr + 8), BPF_JMP_JEQ_K, "insn1 JEQ");
        assert_eq(load32(fptr + 12), SECCOMP_AUDIT_ARCH, "insn1 pins audit arch");
        # A mismatch must skip the whole allowlist and land on RET KILL.
        assert_eq(load8(fptr + 11), 4, "insn1 jf skips allowlist");
        # insn2 then loads the syscall number.
        assert_eq(load16(fptr + 16), BPF_LD_W_ABS, "insn2 LD");
        assert_eq(load32(fptr + 20), SECCOMP_DATA_NR_OFF, "insn2 loads nr");

        # Deny-by-default: second-to-last is RET KILL_PROCESS.
        assert_eq(load16(fptr + flen - 16), BPF_RET_K, "kill insn RET");
        assert_eq(load32(fptr + flen - 12), SECCOMP_RET_KILL_PROCESS, "default kills");
        # Verify last instruction: BPF_RET_K ALLOW
        assert_eq(load16(fptr + flen - 8), BPF_RET_K, "last insn RET");
        assert_eq(load32(fptr + flen - 4), SECCOMP_RET_ALLOW, "last insn ALLOW");
    }

    # Basic service builder has entries
    var bs = seccomp_basic_service();
    assert(seccomp_count(bs) > 20, "basic service syscalls");

    # Empty builder fails
    var empty = seccomp_builder_new();
    var er = seccomp_build(empty);
    assert(is_err_result(er) == 1, "empty build fails");

    # --- u8 jump-offset overflow guard (1.4.2 audit HIGH-4) ---
    # BPF jt/jf are u8. Past SECCOMP_MAX_ALLOW the offsets this layout
    # emits no longer fit, and store8 would truncate them silently, so
    # build must refuse rather than emit a filter that jumps wrong.
    var big = seccomp_builder_new();
    for (var bi = 0; bi < SECCOMP_MAX_ALLOW + 1; bi = bi + 1) {
        seccomp_allow(big, bi);
    }
    assert(is_err_result(seccomp_build(big)) == 1, "oversized filter rejected");

    # Exactly at the cap still builds.
    var atcap = seccomp_builder_new();
    for (var ci = 0; ci < SECCOMP_MAX_ALLOW; ci = ci + 1) {
        seccomp_allow(atcap, ci);
    }
    assert(is_ok(seccomp_build(atcap)) == 1, "at-cap filter builds");
    return 0;
}

