fn test_mount_table() {
    println("--- mount table ---");
    # Verify mount table init doesn't crash (P(-1) fix: was buffer overflow)
    _init_mount_table();
    assert_eq(_mount_count, 6, "6 mount entries");

    # Verify is_mounted with /proc (should be mounted on test host)
    var r = is_mounted("/proc");
    assert_eq(r, 1, "proc is mounted");

    # Verify is_mounted with nonexistent path
    var r2 = is_mounted("/nonexistent_kybernet_test_mount");
    assert_eq(r2, 0, "nonexistent not mounted");

    # Verify is_mounted with empty target (P(-1) fix: underflow guard)
    var r3 = is_mounted("");
    assert_eq(r3, 0, "empty target not mounted");

    # Verify mount_if_needed returns Ok(1) for already-mounted
    var mr = mount_if_needed("proc", "/proc", "proc", 0, 0);
    assert(is_ok(mr) == 1, "mount_if_needed /proc ok");
    assert_eq(result_unwrap(mr), 1, "already mounted returns 1");
    return 0;
}

fn test_mount_required_flag() {
    println("--- mount required flag ---");
    # 1.1.2: each entry grew from 5 i64s to 6 — the 6th is `required`
    # (1 = fatal on failure, 0 = log + skip + continue). Verify the
    # flag is stored at offset +40 for each entry and matches the
    # design: /proc /sys /run /sys/fs/cgroup = required; /dev/pts
    # /dev/shm = optional. Regression catches re-orderings or stride
    # mistakes the next time someone edits _init_mount_table.
    _init_mount_table();
    var t = &_mount_table;
    # /proc
    assert_eq(load64(t + 0 * 48 + 40), 1, "/proc required");
    # /sys
    assert_eq(load64(t + 1 * 48 + 40), 1, "/sys required");
    # /dev/pts
    assert_eq(load64(t + 2 * 48 + 40), 0, "/dev/pts optional");
    # /dev/shm
    assert_eq(load64(t + 3 * 48 + 40), 0, "/dev/shm optional");
    # /run
    assert_eq(load64(t + 4 * 48 + 40), 1, "/run required");
    # /sys/fs/cgroup
    assert_eq(load64(t + 5 * 48 + 40), 1, "cgroup required");

    # Skipped-mount accessors: no mount has been attempted in this
    # test process, so the counter should be zero and out-of-bounds
    # indices should return 0 (not crash).
    assert_eq(mount_skipped_count(), 0, "no skipped mounts at start");
    assert_eq(mount_skipped_target(0), 0, "skipped[0] OOB → 0");
    assert_eq(mount_skipped_target(0 - 1), 0, "skipped[-1] OOB → 0");
    return 0;
}

fn test_cloexec_fcntl_probe() {
    println("--- cloexec fcntl probe ---");
    # 1.1.2 regression: verify O_CLOEXEC actually sets FD_CLOEXEC on
    # the kernel side. Without this, the source-level audit (every
    # long-lived sys_open carries O_CLOEXEC) could pass while a
    # macro/typo silently turned the flag into a no-op.
    # F_GETFD = 1, FD_CLOEXEC = 1 (POSIX, arch-independent).
    # SYS_FCNTL is defined for both x86_64 (72) and aarch64 (25) —
    # safe to call directly. No sys_fcntl wrapper in stdlib at 5.10.44.

    # Probe 1: O_CLOEXEC set → FD_CLOEXEC bit must be 1.
    var fd1 = sys_open("/dev/null", O_RDONLY | O_CLOEXEC, 0);
    assert(fd1 >= 0, "open /dev/null with CLOEXEC");
    var flags1 = syscall(SYS_FCNTL, fd1, 1, 0);
    assert_eq(flags1 & 1, 1, "FD_CLOEXEC bit set when O_CLOEXEC");
    sys_close(fd1);

    # Probe 2: O_CLOEXEC NOT set → FD_CLOEXEC bit must be 0. This is
    # the control — proves the probe distinguishes set from unset
    # (a bogus probe that always returned 1 would still pass test 1).
    var fd2 = sys_open("/dev/null", O_RDONLY, 0);
    assert(fd2 >= 0, "open /dev/null without CLOEXEC");
    var flags2 = syscall(SYS_FCNTL, fd2, 1, 0);
    assert_eq(flags2 & 1, 0, "FD_CLOEXEC bit clear without O_CLOEXEC");
    sys_close(fd2);
    return 0;
}

fn test_edge_boot_pcr_parser() {
    println("--- edge boot pcr parser ---");
    # 1.2.0 — `_eb_parse_pcr_indices` accepts any non-digit separator
    # (`+`, `,`, space, colon) so consumer convention drift doesn't
    # matter. Test the common shapes.
    var i1 = _eb_parse_pcr_indices(str_from("7+14"));
    assert_eq(vec_len(i1), 2, "7+14 parses to 2 indices");
    assert_eq(vec_get(i1, 0), 7, "first index 7");
    assert_eq(vec_get(i1, 1), 14, "second index 14");

    var i2 = _eb_parse_pcr_indices(str_from("0,7,14,23"));
    assert_eq(vec_len(i2), 4, "comma-separated parses to 4");
    assert_eq(vec_get(i2, 0), 0, "first 0");
    assert_eq(vec_get(i2, 3), 23, "last 23");

    var i3 = _eb_parse_pcr_indices(str_from("  3  "));
    assert_eq(vec_len(i3), 1, "space-padded single value");
    assert_eq(vec_get(i3, 0), 3, "value 3");

    var i4 = _eb_parse_pcr_indices(str_from(""));
    assert_eq(vec_len(i4), 0, "empty string → 0 indices");

    # Multi-digit boundary — 23 must not split as 2,3.
    var i5 = _eb_parse_pcr_indices(str_from("23"));
    assert_eq(vec_len(i5), 1, "23 is one index, not 2+3");
    assert_eq(vec_get(i5, 0), 23, "value 23");
    return 0;
}

fn test_edge_boot_gating() {
    println("--- edge boot gating ---");
    # 1.2.0 — verify the gate logic for the THREE deterministic skip
    # paths: config=0, non-EDGE boot_mode, verify_on_boot=0. All three
    # MUST return 1 (continue) without ever calling tpm_detect or
    # dmverity_supported — i.e., without depending on test-host
    # hardware/tooling state.
    #
    # The actual run path (EDGE + verify_on_boot=1 + tpm_attestation=1)
    # IS environment-dependent — its outcome depends on whether the
    # host has /dev/tpm0 + /usr/bin/tpm2_pcrread + /usr/sbin/veritysetup.
    # That branch is exercised end-to-end by the qemu boot harness when
    # the cmdline carries `kybernet.harness=edge`, not by unit tests.

    # config=0: skip entirely, no subsystem touched.
    assert_eq(edge_boot_run(0), 1, "config=0 → continue");

    # Non-EDGE config: even with verify_on_boot=1, edge subsystem skips.
    # argonaut_config_default() sets boot_mode = BOOT_DESKTOP so we
    # exercise the boot_mode gate without constructing a custom config.
    var cfg_desktop = argonaut_config_default();
    assert_eq(edge_boot_run(cfg_desktop), 1, "BOOT_DESKTOP → continue");

    # EDGE mode + verify_on_boot=0: still skips. We mutate the default
    # config in place — boot_mode=EDGE, verify_on_boot=0.
    var cfg_edge_noverify = argonaut_config_default();
    store64(cfg_edge_noverify, BOOT_EDGE);          # boot_mode @ offset 0
    store64(cfg_edge_noverify + 40, 0);             # verify_on_boot @ +40
    assert_eq(edge_boot_run(cfg_edge_noverify), 1, "EDGE+verify=0 → continue");

    # Accessors are deterministic in their initial state — before
    # edge_boot_run runs through the detection branch, all four
    # status globals are zero. The three calls above all short-
    # circuited before the detection path, so the accessors still
    # reflect zero.
    assert_eq(edge_boot_tpm_present(), 0, "tpm_present accessor 0 after skip-only runs");
    assert_eq(edge_boot_dmverity_supp(), 0, "dmverity_supp accessor 0 after skip-only runs");
    assert_eq(edge_boot_pcr_count(), 0, "pcr_count accessor 0 after skip-only runs");
    return 0;
}

fn test_owned_fd() {
    println("--- owned_fd ---");
    # Create and close an OwnedFd
    var fd = sys_open("/dev/null", O_RDONLY, 0);
    assert(fd >= 0, "open /dev/null");
    var ofd = owned_fd_new(fd);
    assert_eq(owned_fd_raw(ofd), fd, "raw fd matches");
    owned_fd_close(ofd);
    assert_eq(owned_fd_raw(ofd), 0 - 1, "closed fd is -1");

    # Double-close should be safe (fd already -1)
    owned_fd_close(ofd);
    assert_eq(owned_fd_raw(ofd), 0 - 1, "double close safe");
    return 0;
}

fn test_eventloop_lifecycle() {
    println("--- eventloop lifecycle ---");
    # Full lifecycle: create epoll, add timer, close
    var epfd_r = epoll_new();
    assert(is_ok(epfd_r) == 1, "epoll create");
    var epfd = result_unwrap(epfd_r);

    # Add a timer
    var tfd_r = timer_new(1);
    assert(is_ok(tfd_r) == 1, "timer create");
    var tfd = result_unwrap(tfd_r);

    var add_r = epoll_add_read(epfd, tfd, TOKEN_HEALTH);
    assert(is_ok(add_r) == 1, "epoll add timer");

    # Add a second timer
    var tfd2_r = timer_new(5);
    assert(is_ok(tfd2_r) == 1, "timer2 create");
    var tfd2 = result_unwrap(tfd2_r);

    var add_r2 = epoll_add_read(epfd, tfd2, TOKEN_WATCHDOG);
    assert(is_ok(add_r2) == 1, "epoll add timer2");

    # Clean up
    sys_close(tfd);
    sys_close(tfd2);
    owned_fd_close(epfd);
    return 0;
}

fn test_eventloop_setup_full() {
    println("--- eventloop setup ---");
    # Test the full eventloop_setup function
    # Need a pollable fd — use a pipe read end
    var pipefd = alloc(16);
    var pr = sys_pipe(pipefd);
    assert(pr == 0, "pipe create");

    var read_fd = load32(pipefd);
    var write_fd = load32(pipefd + 4);

    var r = eventloop_setup(read_fd, 30, 10, 1);
    assert(is_ok(r) == 1, "eventloop_setup ok");
    if (is_ok(r) == 1) {
        var epfd = result_unwrap(r);
        owned_fd_close(epfd);
    }
    sys_close(read_fd);
    sys_close(write_fd);
    return 0;
}

fn test_reaper_macros() {
    println("--- reaper ---");
    # Test wait status macros with various values
    # Normal exit with code 0
    assert_eq(WIFEXITED(0), 1, "exit(0) exited");
    assert_eq(WEXITSTATUS(0), 0, "exit(0) code 0");

    # Normal exit with code 42 (42 << 8 = 10752)
    assert_eq(WIFEXITED(10752), 1, "exit(42) exited");
    assert_eq(WEXITSTATUS(10752), 42, "exit(42) code");

    # Killed by signal 9 (SIGKILL)
    assert_eq(WIFSIGNALED(9), 1, "sig9 signaled");
    assert_eq(WTERMSIG(9), 9, "sig9 term sig");
    assert_eq(WIFEXITED(9), 0, "sig9 not exited");

    # Killed by signal 15 (SIGTERM)
    assert_eq(WIFSIGNALED(15), 1, "sig15 signaled");
    assert_eq(WTERMSIG(15), 15, "sig15 term sig");
    return 0;
}

fn test_signal_buffer() {
    println("--- signal buffer ---");
    # Verify the read_signal buffer is large enough (P(-1) fix)
    # We can't easily test signalfd reads without root,
    # but we can verify None is returned on invalid fd
    var r = read_signal(0 - 1);
    assert(is_none(r) == 1, "read_signal(-1) is None");
