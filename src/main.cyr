# kybernet — AGNOS PID 1 init system
# Written in Cyrius. Manages system boot, services, and shutdown.
#
# Boot sequence:
#   1. Mount devtmpfs + console setup
#   2. Mount essential filesystems
#   3. Block signals + create signalfd
#   4. Setup epoll event loop + notify socket
#   5. Load config from /etc/kybernet/config.json (or defaults)
#   6. Initialize argonaut
#   7. Run boot stages + start services (wave-based)
#   8. Event loop: signals, health, watchdog, notify, restarts
#   9. Shutdown on SIGTERM/SIGINT (coordinated via argonaut)

# Kybernet modules (stdlib + deps auto-included via cyrius.toml)
#
# sigil (pulled transitively via libro) banks per-thread crypto scratch and
# calls thread_local_{init,get,set}. Under cyrius 6.2.x the manifest stdlib
# pin resolves thread_local.cyr into lib/ but no longer auto-includes it into
# the sigil dependency chain — so include it explicitly here, ahead of the
# module chain that pulls sigil. Without this the binary links but SIGILLs at
# runtime on an uninitialised thread pointer (see CLAUDE.md / libro 2.7.x).
include "lib/thread_local.cyr"
include "src/lib/cmdline.cyr"
include "src/lib/log.cyr"
include "src/lib/console.cyr"
include "src/lib/console_io.cyr"
include "src/lib/termios.cyr"
include "src/lib/signals.cyr"
include "src/lib/reaper.cyr"
include "src/lib/privdrop.cyr"
include "src/lib/mount.cyr"
include "src/lib/cgroup.cyr"
include "src/lib/eventloop.cyr"
include "src/lib/notify.cyr"
include "src/lib/seccomp.cyr"
include "src/lib/sandbox.cyr"
include "src/lib/edge_boot.cyr"
include "src/lib/svc_config.cyr"
include "src/lib/emergency_auth.cyr"
include "src/lib/service_sandbox.cyr"
include "src/lib/restart_queue.cyr"
include "src/lib/boot_stages.cyr"

# ================================================================
# Globals
# ================================================================

var g_init = 0;
var g_health_tracker = 0;
var g_epfd = 0;
var g_nfd = 0;
var g_sfd = 0;
var g_config = 0;
var g_log_fd = 0;
# `kybernet.harness=loop` — set once at phase 5 so the timer intervals and
# the reactor's epoll timeout agree. See kybernet_harness_loop_requested().
var g_loop_harness = 0;
# Create a service's cgroup and write whatever limits its config carried,
# BEFORE argonaut forks it. The child then joins itself in kyb_pre_exec.
#
# Best-effort and deliberately quiet on the common path: a service with no
# limits block still gets a cgroup (accounting, and the shutdown sweep needs
# the directory), and a kernel with no memory controller should run services
# uncapped rather than refuse to boot. A limit that was configured and could
# not be written IS logged — that is the case an operator needs to see.
# 1.5.5.
fn _prepare_service_cgroup(name_cs) {
    if (is_err_result(create_service_cgroup(name_cs)) == 1) {
        klog2("  WARNING: could not create cgroup: ", name_cs);
        return 0;
    }
    # Pre-warm the path the CHILD will look up. The cgroup caches are keyed
    # by content (hash_str / streq), and the arena is COW-shared across the
    # fork, so warming it here turns _kyb_join_cgroup's lookup into a pure
    # map hit on a pre-built Str — no map_new, no str_builder, no allocation
    # between fork and exec. create_service_cgroup only warms the prefix
    # cache, and the limit writes warm "memory.max"/"pids.max"; nothing
    # warms "cgroup.procs".
    cgroup_file(name_cs, "cgroup.procs");
    if (g_init == 0) { return 0; }
    var ms = init_get_service(g_init, name_cs);
    if (ms == 0) { return 0; }
    var cl = svc_def_cgroup_limits(managed_svc_def(ms));
    if (cl == 0) { return 0; }
    if (is_err_result(cgroup_apply_limits(name_cs, cl)) == 1) {
        klog2("  WARNING: could not apply cgroup limits: ", name_cs);
        return 0;
    }
    klog2("  limits applied: ", name_cs);
    return 1;
}

# Guards start_services against a second run. Service-group boot stages
# trigger startup on demand (see run_boot_stages), and phase 8 then covers
# any mode whose sequence has no service stage at all — so the call can
# legitimately arrive from either side, but must only do work once.
var g_services_started = 0;

# Emergency-shell authentication, from config.json. Held as globals rather
# than on ArgonautConfig because EmergencyShellConfig is built on demand in
# drop_to_emergency and argonaut's config struct has no slot for it. 1.5.4.
var g_emerg_require_auth = 0;
var g_emerg_hash = 0;          # Str ptr, 0 = none configured

# sd_notify accounting (1.6.3). Counted rather than logged per event: a
# rejected datagram is attacker-triggerable, so logging each one hands any
# root process on the box a log-flooding primitive against PID 1's console.
# The totals are reported once at shutdown, which is enough to notice
# something is speaking sd_notify at PID 1 that should not be.
# ⚠ THE REJECT REASONS ARE COUNTED SEPARATELY, DELIBERATELY. Collapsing them
# is the exact defect this file criticises in argonaut's
# notify_try_recv_authenticated, which returns a bare 0 for four distinct
# outcomes. A single "rejected: 4" cannot distinguish "SO_PASSCRED is not
# working" from "the sender was not a live service" — and those have opposite
# fixes. Found the hard way: the first harness run reported rejected=4 and the
# counter could not say why.
var g_notify_accepted = 0;
var g_notify_nocred = 0;        # no/invalid SCM_CREDENTIALS, or truncated
var g_notify_baduid = 0;        # authenticated, but not uid 0
var g_notify_unattributed = 0;  # authenticated root, but not a live service pid

# ================================================================
# Logging is factored into src/lib/log.cyr (since 1.2.0). klog,
# klog2, kmsg, slog, slog_init, and _logbuf live there. g_log_fd
# stays in the globals block above so the shutdown path can close it.

# ================================================================
# Config loading from JSON
# ================================================================

# Read and parse /etc/kybernet/config.json.
#
# Returns an ArgonautConfig, or **0 when the file exists but cannot be used**.
# That distinction is the whole point of the signature: "there is no config"
# is a legitimate deployment that should boot on defaults, while "there is a
# config and it is broken" must never be silently downgraded to defaults —
# on a reload that would replace a running board's services, boot mode and
# edge policy wholesale, and at boot it would quietly turn an edge board into
# a normal one. Callers decide; neither may confuse the two.
fn load_config() {
    # One byte of headroom so a full read is distinguishable from a truncated
    # one. `file_read_all` stops at maxlen and returns maxlen with no error
    # (io.cyr:471-476), so without this a config that outgrew the buffer came
    # back as invalid JSON and took the defaults path — a silent 16 KiB
    # cliff with no diagnostic.
    var cap = 16384;
    var buf = alloc(cap + 1);
    var n = file_read_all("/etc/kybernet/config.json", buf, cap + 1);
    if (n <= 0) {
        klog("no config found, using defaults");
        return argonaut_config_default();
    }
    if (n > cap) {
        klog("config: /etc/kybernet/config.json exceeds 16384 bytes - REFUSING to parse a truncated config");
        kmsg("kybernet: config exceeds 16384 bytes, refusing to parse a truncated config");
        return 0;
    }

    klog("loaded config: /etc/kybernet/config.json");

    # 1.5.0: parse the full VALUE TREE, not the flat key/value pairs.
    # `json_parse` only yields top-level scalars, which is why services
    # could never be read — the array was structurally out of reach. bayan
    # has had `json_v_parse` + arr/obj accessors the whole time.
    var root = json_v_parse_buf(buf, n);
    if (root == 0) {
        klog("config: parse FAILED - the file is present and not valid JSON");
        kmsg("kybernet: config parse failed");
        return 0;
    }
    if (json_v_is_obj(root) == 0) {
        klog("config: root is not a JSON object");
        kmsg("kybernet: config root is not an object");
        return 0;
    }

    var cfg = argonaut_config_default();

    # boot_mode — via argonaut's parser (1.10.0) rather than a hand-rolled
    # if-ladder. An unrecognised mode keeps the default instead of silently
    # landing on whichever branch happens to fall through.
    var mode_str = _cfg_str(root, "boot_mode", 0);
    if (mode_str != 0) {
        var mr = boot_mode_parse(mode_str);
        if (is_ok(mr) == 1) {
            store64(cfg, result_unwrap(mr));
        } else {
            klog("config: unrecognised boot_mode - keeping default");
        }
    }

    var bt = _cfg_int(root, "boot_timeout_ms", 0);
    if (bt > 0) { store64(cfg + 16, bt); }
    var st = _cfg_int(root, "shutdown_timeout_ms", 0);
    if (st > 0) { store64(cfg + 24, st); }

    # log_to_console is a real JSON bool now. The old code compared it
    # against the STRING "false", so `"log_to_console": false` — the
    # spelling any operator would actually write — was ignored entirely.
    var lc = _cfg_bool(root, "log_to_console", 1);
    store64(cfg + 32, lc);
    # ⚠ ACTUALLY APPLY IT. From 1.5.0 to 1.6.3 this value was parsed, stored,
    # and copied on reload — and `config_log_console` had exactly two readers in
    # the whole tree: its own definition and that reload copy. `klog`/`klog2`
    # wrote to STDERR_FD unconditionally, so `"log_to_console": false` did
    # nothing at all. The 1.5.0 note said the value "was ignored entirely"; only
    # the SPELLING was fixed then (a string compare against "false"), not the
    # behaviour. Announce the transition on the way out, so the last console
    # line explains the silence that follows.
    if (lc == 0) {
        klog("log_to_console=false - console logging OFF (dmesg + /var/log/kybernet.log unaffected)");
    }
    log_set_console(lc);

    # Emergency-shell auth. Both keys must be present for the gate to
    # engage; verify_emergency_auth FAILS CLOSED if require_auth is set
    # without a hash (argonaut 1.8.6 MEDIUM-3), so a half-configured pair
    # locks the shell rather than opening it. 1.5.4.
    g_emerg_require_auth = _cfg_bool(root, "emergency_require_auth", 0);
    g_emerg_hash = _cfg_str(root, "emergency_password_hash", 0);

    # Validate the credential HERE, not at the prompt. Until 1.5.9 this was
    # the one config key with no validation at all: `_cfg_str` returns
    # whatever string is present, so a truncated or mistyped hash was
    # accepted at load and surfaced months later as an unexplained
    # "AUTHENTICATION FAILED" on the one night an operator needed the shell.
    # Rule 19's principle — a typo should be a readable config error, not a
    # phase-6c lockout.
    #
    # An unusable credential is DROPPED rather than kept. That matters
    # because phase 6c branches on `g_emerg_hash != 0`: with the credential
    # dropped, an edge refusal suppresses the root shell entirely; with it
    # kept, kybernet would prompt for a password that nothing could ever
    # match and then halt. Both are closed, but only one is honest.
    if (g_emerg_hash != 0) {
        if (emerg_cred_usable(g_emerg_hash) == 0) {
            klog("config: emergency_password_hash is malformed - credential REJECTED");
            kmsg("kybernet: config: malformed emergency_password_hash, credential rejected");
            g_emerg_hash = 0;
        } else {
            klog2("config: emergency credential: ", str_data(emerg_cred_describe(g_emerg_hash)));
        }
    }

    if (g_emerg_require_auth == 1) {
        klog("config: emergency shell requires authentication");
    }

    # verify_boot gates the whole edge layer. argonaut defaults it to 1;
    # kybernet now lets an operator say otherwise. 1.5.7.
    store64(cfg + 40, _cfg_bool(root, "verify_boot", 1));

    # Edge policy. edge_config_from_json FLIPS argonaut's defaults: an
    # absent `edge` block means detection-only, not the strictest possible
    # profile. See its header — the old behaviour turned `"boot_mode":
    # "edge"` into an un-overridable TPM + dm-verity demand whose refusal
    # path powers the machine off. 1.5.7.
    if (edge_config_from_json(root, config_edge(cfg)) == 0) {
        klog("config: malformed edge block - edge verification DISABLED");
        kmsg("kybernet: config: malformed edge block, edge verification disabled");
        edge_apply_defaults(config_edge(cfg));
    }

    # Services (the v1.5.0 headline). See src/lib/svc_config.cyr.
    var svcs = svc_defs_from_json(root);
    var scount = vec_len(svcs);
    if (scount > 0) {
        var dst = config_services(cfg);
        for (var i = 0; i < scount; i = i + 1) { vec_push(dst, vec_get(svcs, i)); }
        klog2("config: services parsed: ", _u64_str(scount));
    }

    return cfg;
}
# SIGHUP config reload.
#
# What this can and cannot do, precisely — because the previous version
# claimed more than it delivered. It did `store64(g_init, new_cfg)`, which
# overwrites field 0 of ArgonautInit and nothing else, under a comment
# reading "Re-initialize argonaut with new config". But argonaut_init_new
# DERIVES two further fields from the config at construction time: the boot
# sequence (build_boot_sequence(mode)) and the service map (from
# default_services(mode) plus config services). Neither was rebuilt, so a
# reload left new config values sitting on top of derived state built from
# the OLD config — a silent mix, with no way for an operator to tell.
# 1.4.2 audit MEDIUM.
#
# Rebuilding them is not the fix. The service map holds live runtime state —
# PIDs, states, restart counts — for processes that are still running.
# Replacing it would orphan every one of them: still executing, no longer
# tracked, never reaped. In PID 1 that is far worse than a stale timeout.
#
# So the reload applies the values that are safe to change while the system
# is up, and says plainly that the rest needs a reboot. Honest and narrow
# beats a reload that appears total and is not.
fn reload_config() {
    # The emergency credential is a side effect of load_config(), and it was
    # an UNDOCUMENTED one until 1.5.9: a SIGHUP silently swapped the password
    # the recovery shell would accept, with nothing in the log to say so.
    # Re-reading it is the right behaviour — an operator rotating the
    # credential should not have to reboot to apply it — but a reload that
    # changes an authentication credential and says nothing is exactly the
    # kind of "appears total and is not" this function was written to avoid.
    # Capture the old value so the change can be named.
    var prev_hash = g_emerg_hash;
    var prev_req = g_emerg_require_auth;

    var new_cfg = load_config();
    if (new_cfg == 0) {
        # ⚠ KEEP THE RUNNING CONFIG. load_config used to answer
        # `argonaut_config_default()` here, so a SIGHUP with a truncated or
        # mistyped file silently replaced a live board's services, boot mode,
        # edge policy and timeouts with defaults — a reload that cannot fail
        # is a reload that can destroy. The old config stays installed and
        # the operator is told, on the console and in dmesg.
        klog("config reload REFUSED: the file is unusable - keeping the running config");
        kmsg("kybernet: config reload refused, keeping the running config");
        return 0;
    }

    var old_cfg = g_config;
    g_config = new_cfg;

    if (prev_req != g_emerg_require_auth) {
        if (g_emerg_require_auth == 1) {
            klog("config reload: emergency shell now REQUIRES authentication");
        } else {
            klog("config reload: emergency shell no longer requires authentication");
        }
    }
    if (emerg_cred_same(prev_hash, g_emerg_hash) == 0) {
        # The describe() output is parameters only — never the salt, never
        # the tag. See emerg_cred_describe.
        klog2("config reload: emergency credential CHANGED: ",
          str_data(emerg_cred_describe(g_emerg_hash)));
    }

    if (g_init != 0) {
        # Live-applicable scalars only. These are read fresh on each use,
        # so updating them in place takes effect immediately.
        var cur = load64(g_init);
        if (cur != 0) {
            store64(cur + 16, config_boot_timeout(new_cfg));
            store64(cur + 24, config_shutdown_timeout(new_cfg));
            store64(cur + 32, config_log_console(new_cfg));
            # Reload can turn console logging back ON as well as off, so this
            # is the one reload arm that can restore its own diagnostics.
            log_set_console(config_log_console(new_cfg));
        }

        # Anything structural is NOT applied — say so rather than let the
        # operator believe a reload took.
        if (old_cfg != 0) {
            if (config_boot_mode(new_cfg) != config_boot_mode(old_cfg)) {
                klog("config reload: boot_mode change requires a reboot - NOT applied");
            }
        }
        if (vec_len(config_services(new_cfg)) > 0) {
            klog("config reload: service definitions require a reboot - NOT applied");
        }
    }

    klog("config reloaded (timeouts + logging; structural changes need a reboot)");
    return 1;
}

# Prompt for the emergency password on a REAL console and return its length,
# or -1. `fd` must be an interactive descriptor from console_open_rw().
#
# Echo suppression is best-effort and deliberately non-fatal: refusing to
# accept a password because the terminal could not be reconfigured would be a
# self-inflicted lockout on the one path an operator reaches when the machine
# is already broken. It is logged instead, so an operator knows their password
# was visible.
fn _prompt_password(fd, buf, cap) {
    sys_write(fd, "Password: ", 10);

    var saved = alloc(TERMIOS_SIZE);
    var quiet = termios_echo_off(fd, saved);
    if (quiet == 0) {
        klog("emergency shell: could not disable echo - password will be VISIBLE");
    }

    # The deadline in _read_line_fd is only real if the descriptor is
    # non-blocking — a canonical-mode tty otherwise parks the first read until
    # a line arrives and the loop never re-tests the clock. Cleared again
    # below, on every path, because this same fd becomes the shell's stdin.
    var nb = console_set_nonblock(fd, 1);

    var plen = _read_line_fd(fd, buf, cap, 120000);
    if (nb == 1) { console_set_nonblock(fd, 0); }

    # Restore on EVERY path — success, wrong password, empty, timeout. Echo
    # left off would hand the operator a shell that shows nothing they type.
    if (quiet == 1) { termios_restore(fd, saved); }
    sys_write(fd, "\n", 1);
    return plen;
}

# Flatten argonaut's EmergencyShellConfig environment map into an execve
# envp array. Returns a NULL-terminated array of "KEY=value" cstrs.
#
# Built here rather than reusing build_default_envp because the recovery
# shell wants argonaut's curated set (HOME, TERM, PATH, SHELL) — TERM in
# particular, without which the shell has no line editing. 1.5.8.
fn _emerg_envp(esc) {
    var envp = alloc(64);          # 7 slots + NULL, generous
    var n = 0;
    var m = load64(esc + 8);       # environment map
    if (m != 0) {
        var keys = map_keys(m);
        var kn = vec_len(keys);
        for (var i = 0; i < kn; i = i + 1) {
            if (n >= 7) { break; }
            var k = vec_get(keys, i);
            var v = map_get(m, k);
            if (v == 0) { continue; }
            var sb = str_builder_new();
            str_builder_add_cstr(sb, k);
            str_builder_add_cstr(sb, "=");
            str_builder_add_str(sb, v);
            store64(envp + n * 8, str_data(str_builder_build(sb)));
            n = n + 1;
        }
    }
    # PS1 marks the shell as the emergency one, matching what the Rust
    # implementation set.
    if (n < 7) {
        store64(envp + n * 8, "PS1=kybernet-emergency# ");
        n = n + 1;
    }
    store64(envp + n * 8, 0);
    return envp;
}

fn drop_to_emergency() {
    klog("=== ENTERING EMERGENCY MODE ===");

    var esc = emergency_shell_default();

    # Overlay the operator's auth policy onto argonaut's default config.
    # emergency_shell_default() hard-codes require_auth = 0 / hash = 0, so
    # without this the gate could never engage no matter what config.json
    # said. Rust read the same two fields off EmergencyShellConfig.
    # 1.5.4 — closes the last rust-old port gap.
    store64(esc + 24, g_emerg_require_auth);
    store64(esc + 32, g_emerg_hash);

    # A REAL console, not fd 0. fd 0 is /dev/null by design (see
    # console_open_rw's header) — reading it returns EOF immediately, which
    # is why no password could ever be entered between 1.5.4 and 1.5.8, and
    # why an edge board with a hash configured reboot-looped. 1.5.8.
    var con = console_open_rw();

    if (g_emerg_require_auth == 1) {
        klog("emergency shell: authentication required");
        if (con < 0) {
            # No console to prompt on. Denying is the only honest answer —
            # but do NOT reboot into the same condition, which is the loop
            # this release exists to end. Hang instead: a machine stopped
            # with a diagnostic on kmsg can be recovered from the
            # bootloader; one power-cycling every few seconds cannot.
            klog("FATAL: authentication required but /dev/console cannot be opened");
            kmsg("kybernet: emergency auth impossible - no console; halting rather than reboot-looping");
            while (1 == 1) { sys_pause(); }
        }
        # 512, not 256: scripts/mkcred.sh recommends a multi-word passphrase
        # and caps the password at 256 bytes, so the prompt must be able to
        # accept every credential the provisioning tool can mint, with room
        # for the NUL. A password that does not fit is now an explicit -2
        # rather than a silent truncation.
        var pbuf = alloc(512);
        var plen = _prompt_password(con, pbuf, 512);
        var granted = 0;
        if (plen == 0 - 2) {
            klog("emergency shell: password too long for the input buffer");
            sys_write(con, "Password too long.\n", 19);
        }
        if (plen >= 0) {
            granted = kyb_verify_emergency_auth(esc, str_new(pbuf, plen));
        }
        # Wipe the plaintext regardless of the verdict. The arena is never
        # reset in PID 1, so anything left here persists for the life of
        # the system in a process that can be core-dumped.
        for (var z = 0; z < 512; z = z + 1) { store8(pbuf + z, 0); }
        if (granted == 0) {
            klog("emergency shell: AUTHENTICATION FAILED");
            sys_write(con, "Authentication failed.\n", 23);
            sys_close(con);
            # Halt, do NOT reboot. Rebooting re-enters whatever refused the
            # boot, which re-enters this prompt — the loop 1.5.8 fixes. A
            # wrong password is also the one case where an attacker could
            # otherwise force an endless reboot cycle on demand.
            kmsg("kybernet: emergency authentication failed - halting");
            while (1 == 1) { sys_pause(); }
        }
        klog("emergency shell: authenticated");
    }

    var shell_path = load64(esc);
    var banner = load64(esc + 16);

    # Print banner
    if (banner != 0) {
        sys_write(STDERR_FD, str_data(banner), str_len(banner));
    }

    # The shell needs a real stdin too. Without this it inherits fd 0 =
    # /dev/null, reads EOF on its first prompt and exits immediately — so
    # even an operator who authenticated got no usable shell. Same root
    # cause as the password read. 1.5.8.
    if (con < 0) { con = console_open_rw(); }

    # Fork and exec the shell
    var pid = sys_fork();
    if (pid == 0) {
        # Drop PID 1's blocked mask before exec. setup_signals blocks
        # SIGCHLD/SIGTERM/SIGINT/SIGHUP/SIGPWR so they can be read from the
        # signalfd; fork inherits that mask and execve preserves it, so
        # without this reset Ctrl-C is inert in the recovery shell and in
        # everything launched from it — the one shell where an operator
        # most needs job control. 1.4.2 audit MEDIUM-4.
        reset_child_signal_mask();

        # Give the shell the console as its stdin/stdout/stderr. It is a
        # session leader's child on a fresh descriptor, so it gets a real
        # terminal rather than /dev/null.
        if (con >= 0) {
            sys_dup2(con, 0);
            sys_dup2(con, 1);
            sys_dup2(con, 2);
            if (con > 2) { sys_close(con); }
        }

        # Child — exec the emergency shell. The raw syscall(59/60,...)
        # this replaces was x86_64-only; sys_execve / sys_exit dispatch
        # per-arch (SYS_EXECVE 59→221, SYS_EXIT 60→93 on aarch64).
        #
        # envp was 0 — a completely empty environment. argonaut's
        # emergency_shell_default() builds HOME/TERM/PATH/SHELL and every
        # one of them was discarded, so the recovery shell had no PATH (no
        # command resolves by name) and no TERM (no line editing). 1.5.8.
        var argv = alloc(16);
        store64(argv, str_data(shell_path));
        store64(argv + 8, 0);
        var envp = _emerg_envp(esc);
        sys_execve(str_data(shell_path), argv, envp);
        # If exec fails, try /bin/sh
        store64(argv, "/bin/sh");
        sys_execve("/bin/sh", argv, envp);
        sys_exit(1);
    } elif (pid > 0) {
        # Parent — wait for shell to exit
        klog("emergency shell started");
        var status = alloc(8);
        sys_waitpid(pid, status, 0);
        klog("emergency shell exited");
    } else {
        klog("FATAL: fork failed for emergency shell");
    }

    # Close the parent's console descriptor. drop_to_emergency can be entered
    # more than once (phase 6c, then again from the service-wave path), and
    # PID 1 never exits — an fd leaked per entry is leaked for the life of
    # the system.
    if (con >= 0) { sys_close(con); }

    return 0;
}

# ================================================================
# Harness mode — QEMU PID-1 boot-validation gate (1.1.4)
# ================================================================
# When `kybernet.harness=1` is on the kernel cmdline, kybernet runs
# its normal boot sequence through phase 8 (services started) and
# then shuts down cleanly instead of entering the event loop. The
# qemu/boot-test.sh harness greps stdout for the phase markers and
# the "harness done" line, asserting the full sequence completed
# before the timeout fires.
#
# Pattern lifted from argonaut's pid1_harness_requested() (1.6.x).
# Substring match with start-/end-boundary checks so
# `kybernet.harness=11` or `nokybernet.harness=1` don't accidentally
# trigger harness mode.

fn kybernet_harness_requested() {
    return _cmdline_has("kybernet.harness=1", 18);
}

# `kybernet.harness=loop` — the REACTOR gate (1.4.2).
#
# The boot-only harness above shuts down at phase 9 without ever entering
# the event loop, so for four audits no release gate executed a single
# reactor iteration. That is precisely how CRITICAL-1 (level-triggered
# timerfds never drained -> PID 1 spinning at 100% CPU forever, ~10 s
# after every boot) reached production and survived: the defect lives
# entirely past the boot-only gate's shutdown point.
#
# Loop mode runs the real event loop with short timer intervals for a
# bounded wall time, then prints the wakeup count and shuts down. A
# correct reactor sleeps between ticks, so the count is single digits; a
# spinning one reports hundreds of thousands. boot-test.sh asserts on it.
fn kybernet_harness_loop_requested() {
    return _cmdline_has("kybernet.harness=loop", 21);
}

# ================================================================
# Shutdown (coordinated via argonaut)
# ================================================================

fn do_shutdown(shutdown_type) {
    # Report the sd_notify tallies once, here, rather than per datagram — a
    # rejected message is attacker-triggerable, so per-event logging would be a
    # console-flooding primitive. A non-zero reject count means something on
    # this box spoke sd_notify at PID 1 without being one of its services.
    var _nrej = g_notify_nocred + g_notify_baduid + g_notify_unattributed;
    if (g_notify_accepted > 0 || _nrej > 0) {
        klog2("notify: accepted: ", _u64_str(g_notify_accepted));
        klog2("notify: rejected: ", _u64_str(_nrej));
        klog2("notify: rejected-nocred: ", _u64_str(g_notify_nocred));
        klog2("notify: rejected-baduid: ", _u64_str(g_notify_baduid));
        klog2("notify: rejected-unattributed: ", _u64_str(g_notify_unattributed));
    }

    if (g_init != 0) {
        var plan = init_plan_shutdown(g_init, shutdown_type);
        if (plan != 0) {
            klog("stopping services...");
            var timeout = 5000;
            if (g_config != 0) {
                timeout = config_shutdown_timeout(g_config);
            }
            init_stop_all(g_init, timeout);
            remove_all_service_cgroups();
        }
    }

    klog("syncing filesystems...");
    sys_sync();

    slog("info", "shutdown complete");

    klog("shutdown");
    # Clear the global along with the close. g_log_fd doubles as slog2's
    # open-flag (src/lib/log.cyr), so a closed-but-nonzero value makes
    # every later klog write to a dead — and eventually recycled —
    # descriptor, and makes the `> 0` guard meaningless. Also note the
    # final klog now lands in the file before the fd goes away.
    # 1.4.2 audit LOW-4.
    if (g_log_fd > 0) { sys_close(g_log_fd); g_log_fd = 0; }
    # All three shutdown kinds dispatch. HALT was unmapped before 1.5.4 and
    # fell through to POWER_OFF — latent, since no caller produces it today,
    # but a silent mismatch the moment one does. Rust dispatched all three.
    if (shutdown_type == SHUTDOWN_REBOOT) {
        sys_reboot(RB_AUTOBOOT);
    } elif (shutdown_type == SHUTDOWN_HALT) {
        sys_reboot(RB_HALT_SYSTEM);
    } else {
        sys_reboot(RB_POWER_OFF);
    }
    # If reboot fails, pause forever
    sys_pause();
    return 0;
}

# ================================================================
# Signal handling
# ================================================================

fn handle_signal(signum) {
    var cls = classify_signal(signum);
    switch (cls) {
        case 1: handle_sigchld();
        case 2: klog("received SIGTERM"); do_shutdown(SHUTDOWN_POWEROFF);
        case 3: klog("received SIGINT"); do_shutdown(SHUTDOWN_REBOOT);
        case 4: handle_sighup();
        case 5: klog("received SIGPWR - power failure"); do_shutdown(SHUTDOWN_POWEROFF);
        default: return 0;
    }
    return 0;
}

fn handle_sigchld() {
    if (g_init == 0) {
        reap_and_log();
        return 0;
    }

    # Reap tracked services first
    var reaped = init_reap_services(g_init);
    var rlen = vec_len(reaped);
    for (var ri = 0; ri < rlen; ri = ri + 1) {
        var entry = vec_get(reaped, ri);
        var name = load64(entry);
        var exit_code = load64(entry + 8);
        var action = load64(entry + 16);

        # argonaut returns service names as Str (boxed); kybernet's
        # logging path expects cstr. Same fix as the 1.1.4 boot-stage
        # `desc` patch — that one was point-only, this pass closes the
        # rest of the surface (handle_sigchld, start_services, health,
        # watchdog).
        var name_cs = str_data(name);
        klog2("service exited: ", name_cs);
        slog("warn", name_cs);

        if (action != 0) {
            var action_type = load64(action);
            if (action_type == CRASH_RESTART) {
                var delay = load64(action + 8);
                # ENQUEUE, do not restart here. argonaut computed `delay`
                # as an exponential backoff; restarting synchronously threw
                # it away and relaunched a crash-looping service as fast as
                # it could die. The reactor's restart tick performs the
                # actual relaunch once the delay has elapsed — see
                # src/lib/restart_queue.cyr. 1.5.4.
                if (restart_queue_push(name_cs, monotonic_ms() + delay) == 1) {
                    klog2("  restart scheduled: ", name_cs);
                }
            } elif (action_type == CRASH_GIVE_UP) {
                var reason = load64(action + 16);
                klog2("  giving up on: ", name_cs);
                if (reason != 0) {
                    klog2("  reason: ", str_data(reason));
                }
                # The service will not be restarted, so its cgroup is dead
                # weight — and not necessarily EMPTY: the main process
                # exited, but anything it forked is still in there and still
                # counted against the slice. Kill the remainder, then remove
                # the directory. Before 1.5.3 neither call had a production
                # call site at all, so give-up left a populated cgroup behind
                # for the life of the system. 1.4.2 audit LOW.
                kill_cgroup(name_cs);
                remove_service_cgroup(name_cs);
            } elif (action_type == CRASH_IGNORE) {
                klog2("  ignoring exit: ", name_cs);
            }
        }
    }

    # Reap orphaned zombies — children of a process that already exited, now
    # reparented to PID 1. Reaping them is half of what an init exists to do.
    #
    # ⚠ LOGGED, not silent — but note what actually reaches here. argonaut's
    # `init_reap_services` above calls `proc_table_reap_orphans()`, which
    # does `waitpid(-1, WNOHANG)` in a loop and discards the count, so in
    # practice IT collects the orphans and this call finds nothing. That is
    # why `reap_and_log` rather than the old silent `reap_zombies()`: on the
    # paths where kybernet does get there first (before `g_init` is set, or
    # if argonaut's sweep ever stops running) a reaped orphan now leaves a
    # `reaped pid=N exit=C` line instead of vanishing. Surfacing argonaut's
    # own count is the real fix and is on the roadmap. 1.6.1.
    reap_and_log();
    return 0;
}

fn handle_sighup() {
    klog("received SIGHUP - reloading config");
    var ok = reload_config();
    if (ok == 1) {
        klog("config reload successful");
    } else {
        klog("config reload failed, keeping current config");
    }
    return 0;
}

# ================================================================
# Boot stages
# ================================================================

# `boot_timeout_ms` — checked at stage boundaries. 1.6.4.
#
# ⚠ THIS IS A BUDGET CHECK, NOT A TIMEOUT, AND THE DIFFERENCE IS THE POINT.
# From 1.5.0 to 1.6.3 `config_boot_timeout` had exactly two readers in the
# tree — the reload copy and one unit test — so the key was parsed and never
# consulted. It is consulted now, but honestly:
#
#   - It CANNOT interrupt a hung stage. Phase 7 runs before the reactor, the
#     signal mask is blocked in favour of signalfd, and there is nothing to
#     deliver an alarm to. A stage that never returns still never returns.
#   - What it CAN do is notice, at each boundary, that the boot has already
#     overrun — which catches a slow board, a retrying dependency or a
#     degrading disk, i.e. the cases that actually show up.
#
# It logs and CONTINUES rather than dropping to the emergency shell: a boot
# that is merely slow is still a boot, and turning a slow disk into an
# unbootable board would be a worse failure than the one being reported.
# Logged once, not per stage, so a long boot cannot flood the console.
var g_boot_deadline = 0;
var g_boot_overrun_logged = 0;

fn _boot_budget_begin() {
    g_boot_overrun_logged = 0;
    g_boot_deadline = 0;
    if (g_config == 0) { return 0; }
    var bt = config_boot_timeout(g_config);
    if (bt <= 0) { return 0; }
    g_boot_deadline = monotonic_ms() + bt;
    return g_boot_deadline;
}

fn _boot_budget_check(desc_cs) {
    if (g_boot_deadline == 0) { return 0; }
    if (g_boot_overrun_logged == 1) { return 1; }
    if (monotonic_ms() <= g_boot_deadline) { return 0; }
    g_boot_overrun_logged = 1;
    klog2("boot: OVER BUDGET (boot_timeout_ms) at stage: ", desc_cs);
    kmsg("kybernet: boot over budget - continuing (advisory, cannot interrupt a hung stage)");
    return 1;
}

fn run_boot_stages() {
    if (g_init == 0) { return 0; }
    _boot_budget_begin();

    var step = init_current_stage(g_init);
    while (step != 0) {
        var stage = load64(step);
        var desc = load64(step + 8);

        # argonaut returns description as a Str (boxed) — klog2/kmsg
        # need a cstr. str_data() reads the underlying buffer ptr.
        # Resolve ONCE here so every use below (including the failure
        # arms) is a cstr; passing the raw Str to klog2 makes strlen()
        # walk the {data,len} box instead of the text. See 1.4.2 audit
        # MEDIUM-2 — the two failure arms had exactly that bug.
        var desc_cs = str_data(desc);
        klog2("boot: ", desc_cs);
        kmsg(desc_cs);

        # Service-group stages report whether their services came up, so
        # the services have to have been attempted first. Starting them
        # here rather than in a separate later phase is what makes those
        # stages mean anything — before 1.5.1 they were evaluated before
        # any service existed, which is part of why they all returned 1.
        if (boot_stage_needs_services(stage) == 1) { ensure_services_started(); }

        var ok = execute_boot_stage_for(g_init, g_config, stage);
        _boot_budget_check(desc_cs);
        if (ok == STAGE_OK) {
            init_mark_step_complete(g_init, stage);
        } elif (ok == STAGE_SKIP) {
            # Not performed by this deployment — recorded as SKIPPED, which
            # init_is_boot_complete accepts. Distinct from claiming success.
            klog2("boot: skipped (not applicable): ", desc_cs);
            init_mark_step_skipped(g_init, stage, "not performed by this deployment");
        } else {
            var required = load64(step + 16);
            if (required == 1) {
                klog2("FATAL: required boot stage failed: ", desc_cs);
                init_mark_step_failed(g_init, stage, "stage execution failed");
                return 0 - 1;
            }
            klog2("WARNING: optional boot stage failed: ", desc_cs);
            init_mark_step_failed(g_init, stage, "stage execution failed");
        }

        step = init_current_stage(g_init);
    }

    return 0;
}

# ================================================================
# Service startup
# ================================================================

# Total wall-clock budget for settling EBUSY on the teardown sweep, across
# ALL services. Deliberately a whole-sweep budget rather than per-cgroup: a
# per-cgroup bound multiplies by the service count, and this runs on the path
# to sys_reboot where the one unacceptable outcome is not arriving.
enum CgroupSettle {
    CG_SETTLE_BUDGET_MS = 150;
    CG_SETTLE_STEP_MS = 5;
}

# Tear down every service cgroup argonaut knows about.
#
# Called from do_shutdown after init_stop_all. Services have been SIGTERMed
# and reaped by then, but a cgroup whose last process is gone is still a
# live directory in the hierarchy — nothing removes it implicitly. Before
# 1.5.3 nothing removed it explicitly either: create_service_cgroup and
# move_to_cgroup were the only cgroup calls with production call sites, so
# directories accumulated for the life of the system across every service
# restart cycle. 1.4.2 audit LOW.
#
# kill_cgroup first, because "stopped" means the tracked PID exited, not
# that the cgroup is empty — anything the service forked and orphaned is
# still in it, and rmdir on a non-empty cgroup fails with EBUSY.
#
# Best-effort throughout: this runs on the shutdown path, where a failed
# rmdir must not stop us reaching sys_reboot. Names come from argonaut's
# registry as cstrs, which is what the cgroup helpers want.
# rmdir a service cgroup, absorbing the SIGKILL-delivery race.
#
# ⚠ `cgroup.kill` is ASYNCHRONOUS. It sets the kill bit and returns; the
# kernel then walks the cgroup delivering SIGKILL and the tasks exit on their
# own schedule. rmdir on a cgroup that still holds a task fails EBUSY. So the
# old `kill_cgroup(); remove_service_cgroup();` pair on adjacent lines was a
# race whose outcome depended on whether the reaping happened to land inside
# the few microseconds between two syscalls.
#
# It was not a harmless one. The harness asserted the racy count as an exact
# literal ("removed service cgroups: 8"), so the gate encoded the bug: 8 meant
# "one cgroup leaked and we expected it to". Measured across kernels, 8 was
# not even stable — the same tree yields 9 on a faster kernel, on a slower
# one, or under load. Retrying EBUSY makes the answer 9 always, and 9 is the
# correct answer: every cgroup torn down.
#
# Only EBUSY is retried. Every other errno is terminal — ENOENT means someone
# else removed it, and retrying either of those just burns the budget.
#
# ⚠ `err_code_of`, NOT `err_code`. They are not variants of each other:
# err_code(ret) is `0 - ret` and takes a RAW negative syscall return, while
# err_code_of(res) reads the payload out of a tagged Result box. remove_service_cgroup
# returns a box, so err_code() on it negates the POINTER — a large negative
# number that never equals EBUSY, so the retry loop silently never ran and the
# teardown behaved exactly as it had before the fix. Both names are in scope
# here (syscalls + result), neither is a compile error at the call site, and
# the only symptom is the bug you were trying to fix appearing to persist.
fn _remove_cgroup_settled(nm, deadline) {
    var r = remove_service_cgroup(nm);
    if (is_ok(r) == 1) { return 1; }
    while (err_code_of(r) == EBUSY && monotonic_ms() < deadline) {
        sleep_ms(CG_SETTLE_STEP_MS);
        r = remove_service_cgroup(nm);
        if (is_ok(r) == 1) { return 1; }
    }
    return 0;
}

fn remove_all_service_cgroups() {
    if (g_init == 0) { return 0; }
    var names = init_service_names(g_init);
    var n = vec_len(names);
    var removed = 0;
    # One deadline for the whole sweep — see CG_SETTLE_BUDGET_MS.
    var deadline = monotonic_ms() + CG_SETTLE_BUDGET_MS;
    for (var i = 0; i < n; i = i + 1) {
        var nm = vec_get(names, i);
        kill_cgroup(nm);
        removed = removed + _remove_cgroup_settled(nm, deadline);
    }
    # Report the shortfall too. "removed 8" on its own reads like a success
    # line; it is the leak that the exact-count gate used to bless.
    if (removed > 0) { klog2("removed service cgroups: ", _u64_str(removed)); }
    if (removed < n) {
        klog2("service cgroups still busy at shutdown: ", _u64_str(n - removed));
    }
    return removed;
}

# Idempotent wrapper — see g_services_started.
fn ensure_services_started() {
    if (g_services_started == 1) { return 0; }
    g_services_started = 1;
    var r = start_services();
    # Build the notify attribution cache ONCE, here, where the service set is
    # final and we are not on an attacker-reachable path. See g_notify_names.
    kyb_notify_names_refresh();
    return r;
}

fn start_services() {
    if (g_init == 0) { return 0; }

    # Resolve waves over EVERY registered service, not just the config
    # half. argonaut_init_new registers default_services(mode) AND the
    # config services; walking `config_services(config)` alone meant the
    # defaults argonaut had just registered were never started. Needs
    # argonaut 1.10.0's init_service_defs. 1.5.0.
    var svc_defs = init_service_defs(g_init);
    var waves = resolve_service_waves(svc_defs);
    if (waves == 0) {
        klog("ERROR: circular dependency in services");
        return 0 - 1;
    }

    var started = 0;
    var failed = 0;
    var nwaves = vec_len(waves);
    for (var wi = 0; wi < nwaves; wi = wi + 1) {
        var wave = vec_get(waves, wi);
        var wlen = vec_len(wave);

        klog2("starting wave ", "...");

        for (var si = 0; si < wlen; si = si + 1) {
            var name = vec_get(wave, si);
            # argonaut's service-name vec is Str; cgroup path builders
            # and klog2 both want cstr. str_data() once, reuse the
            # cstr ptr — cgroup_path's cache also keys on it so we get
            # stable cache hits within the burst.
            var name_cs = str_data(name);

            # ⚠ DISABLED IS NOT FAILED. argonaut's init_start_service returns
            # -1 for a service with `"enabled": false`
            # (argonaut_init.cyr:410) — the same value it returns for a real
            # failure — so a deliberately disabled service was logged "FAILED
            # to start" and counted toward `failed`. A config that disables
            # every service therefore hit `failed > 0 && started == 0` below
            # and dropped the board to the EMERGENCY SHELL, which is a
            # remarkable answer to "I turned my services off".
            #
            # Skipped before the cgroup is created too: a service that will
            # not run has no business owning one, and the shutdown sweep
            # would then have to account for it.
            var msd = init_get_service(g_init, name_cs);
            if (msd != 0) {
                if (svc_def_enabled(managed_svc_def(msd)) == 0) {
                    klog2("  skipped (disabled in config): ", name_cs);
                    continue;
                }
            }

            klog2("  starting: ", name_cs);

            # name_cs, NOT name. resolve_service_waves returns waves of
            # boxed Str, but argonaut's service map is keyed by cstr
            # (`str_data(svc_def_name(sd))` in argonaut_init_new), so
            # passing the Str box makes map_get miss and EVERY start
            # returns -1. Latent until 1.5.0 only because the wave list was
            # always empty. See argonaut's note on init_get_service.
            # init_start_service's return is TRI-STATE, not a plain pid:
            #   > 0  a live process (SVC_SIMPLE / SVC_FORKING)
            #   == 0 a SVC_ONESHOT that ran to completion with exit 0
            #        (init_start_oneshot waits, then returns 0 — there is no
            #        surviving process to place in a cgroup)
            #   < 0  failed to start
            # Treating this as `pid > 0` logged every SUCCESSFUL oneshot as
            # "FAILED to start". Found the first time this loop body ever
            # executed in a real boot — it was unreachable before 1.5.0
            # because the wave list was always empty. 1.5.0.
            # Cgroup FIRST, limits SECOND, start THIRD. 1.5.5.
            #
            # Everything here used to happen after init_start_service, which
            # made it both racy and incomplete: cgroup v2 charges memory on
            # first touch and does NOT migrate charges on move, so pages
            # faulted in before the move stay charged to the root cgroup
            # forever; and a oneshot has already exited by the time
            # init_start_service returns 0, so it never got a cgroup at all.
            # The child now joins itself in kyb_pre_exec, so the cgroup and
            # its limits must already exist when argonaut forks.
            _prepare_service_cgroup(name_cs);

            var pid = init_start_service(g_init, name_cs);
            if (pid > 0) {
                klog2("  started: ", name_cs);
                started = started + 1;
            } elif (pid == 0) {
                klog2("  completed (oneshot): ", name_cs);
                started = started + 1;
            } else {
                klog2("  FAILED to start: ", name_cs);
                failed = failed + 1;
            }
        }
    }

    # A boot in which every service failed still reached the event loop
    # before 1.5.4 — argonaut's own predicate was consulted for a failed
    # boot STAGE but never for the service waves. Ask it here too.
    if (failed > 0 && started == 0) {
        klog("all services failed to start");
        if (init_should_drop_to_emergency(g_init) == 1) {
            drop_to_emergency();
        }
    }

    return 0;
}

# ================================================================
# Event loop handlers
# ================================================================

fn handle_health_tick() {
    # Drain FIRST, and unconditionally — before the g_init guard. The
    # timerfd is level-triggered, so until its expiration counter is read
    # epoll reports it ready forever and the reactor spins at 100% CPU.
    # Returning early without draining is exactly how that happens.
    # 1.4.2 audit CRITICAL-1.
    eventloop_drain_health();
    if (g_init == 0) { return 0; }

    var results = init_poll_health(g_init, g_health_tracker);
    var rlen = vec_len(results);
    for (var ri = 0; ri < rlen; ri = ri + 1) {
        var result = vec_get(results, ri);
        var passed = load64(result + 16);
        if (passed == 0) {
            var svc_name = load64(result);
            var svc_cs = str_data(svc_name);
            klog2("health check failed: ", svc_cs);
            slog("error", svc_cs);

            # Act on it. argonaut's health_tracker_record already decides
            # whether the consecutive-failure count has crossed the
            # service's `retries` threshold — and init_poll_health throws
            # that verdict away — so reconstruct it from the same inputs.
            # Pre-1.5.4 a wedged-but-running service was logged forever and
            # never restarted, which defeats the point of configuring a
            # health check at all. 1.5.4.
            var ms = init_get_service(g_init, svc_cs);
            if (ms != 0) {
                var hc = svc_def_health_check(managed_svc_def(ms));
                if (hc != 0) {
                    var threshold = svc_hc_retries(hc);
                    if (threshold < 1) { threshold = 3; }
                    if (health_tracker_count(g_health_tracker, svc_cs) >= threshold) {
                        # Flat 1 s, as the Rust original used: this is not a
                        # crash backoff, it is "stop waiting and cycle it".
                        if (restart_queue_push(svc_cs, monotonic_ms() + 1000) == 1) {
                            klog2("health threshold exceeded - restart scheduled: ", svc_cs);
                        }
                    }
                }
            }
        }
    }
    return 0;
}

fn handle_watchdog_tick() {
    # See handle_health_tick — drain before any early return.
    eventloop_drain_watchdog();
    if (g_init == 0) { return 0; }

    var killed = init_enforce_watchdog(g_init);
    var klen = vec_len(killed);
    for (var ki = 0; ki < klen; ki = ki + 1) {
        var name = vec_get(killed, ki);
        var name_cs = str_data(name);
        klog2("watchdog killed: ", name_cs);
        slog("error", name_cs);
        # A watchdog kill was a one-way door before 1.5.4: the service was
        # killed and stayed dead for the life of the system, which is worse
        # than not having a watchdog. Rust queued a 2 s restart; same here.
        if (restart_queue_push(name_cs, monotonic_ms() + 2000) == 1) {
            klog2("watchdog restart scheduled: ", name_cs);
        }
    }
    return 0;
}

# Perform any restarts whose backoff has elapsed. Driven by TOKEN_RESTART,
# which existed in the enum since the Rust port with nothing behind it.
# 1.5.4.
fn handle_restart_tick() {
    # Drain FIRST and unconditionally, ahead of every early return — the
    # timerfd is level-triggered, so an undrained one pins the reactor.
    # Same rule as handle_health_tick. 1.4.2 audit CRITICAL-1.
    eventloop_drain_restart();
    if (g_init == 0) { return 0; }

    var now = monotonic_ms();
    while (1 == 1) {
        var name = restart_queue_pop_due(now);
        if (name == 0) { break; }

        klog2("  restarting: ", name);
        # Re-prepare the cgroup BEFORE the relaunch — the old one was torn
        # down when the service exited (1.4.2 audit MEDIUM-5), and the new
        # child joins itself in kyb_pre_exec, so it has to exist and carry
        # its limits by the time argonaut forks. 1.5.5.
        _prepare_service_cgroup(name);
        # 5 s is a real STOP timeout here, which is what this parameter
        # actually is. Pre-1.5.4 the backoff was passed in this slot.
        var rpid = init_restart_service(g_init, name, 5000);
        if (rpid > 0) {
            klog2("  restarted: ", name);
        } elif (rpid == 0) {
            klog2("  restarted (oneshot completed): ", name);
        } else {
            klog2("  FAILED to restart: ", name);
        }
    }
    return 0;
}

# Which service does this pid belong to? Returns a cstr name, or 0.
#
# The authenticated sender pid is the ONLY trustworthy identity in an
# sd_notify datagram — the MAINPID= field inside it is attacker-controlled by
# definition. So attribution goes pid -> service, never message -> service.
#
# ⚠ Rule 3: `init_service_names` hands back **cstrs** (argonaut's own comment
# at init.cyr:319), which is what `init_get_service` and `klog2` both want. Do
# NOT reach for `proc_table_pid` here — that takes a boxed `Str` and calls
# `str_data()` internally, and handing it a cstr is precisely the SIGSEGV
# argonaut 1.13.3 fixed in the watchdog path.
#
# STATE_STARTING is accepted as well as STATE_RUNNING, deliberately: a
# readiness notification arrives exactly during the starting window, so
# filtering to RUNNING only — which is what argonaut's own expected-pid set at
# init.cyr:843 does — would reject every READY=1 that mattered.
# Cached service-name vec for attribution.
#
# ⚠ THIS CACHE IS THE FIX FOR A LEAK THIS RELEASE ALMOST SHIPPED. The first
# version called `init_service_names(g_init)` per datagram — and that is
# `map_keys` (hashmap.cyr:331), which does `vec_new()` (a 24-byte header plus a
# 128-byte 16-slot backing array) plus a push per service, EVERY call, with
# nothing freed. Measured: 152 bytes per datagram at 8 services, 408 above 16
# once the vec grows. In the arena PID 1 never resets (rule 8), reachable by
# any root sender, at 32 datagrams per level-triggered wakeup.
#
# So the "fix" for `notify_read`'s 512-byte-per-datagram leak had replaced it
# with a 152-byte-per-datagram leak on the very same path: same primitive, same
# actor, same terminal failure, 70% smaller. A reduction is not a fix.
#
# Names cannot change without a reboot — `reload_config` explicitly refuses
# service-definition changes — so the list is built once, after services start,
# and reused. The per-datagram path now allocates NOTHING: the receive buffer,
# the status buffer and the scan slot are all static.
var g_notify_names = 0;

fn kyb_notify_names_refresh() {
    if (g_init == 0) { return 0; }
    g_notify_names = init_service_names(g_init);
    return vec_len(g_notify_names);
}

fn kyb_notify_service_for_pid(pid) {
    if (g_init == 0) { return 0; }
    if (pid <= 0) { return 0; }
    # No cache means attribution is impossible; never build one here — this is
    # the attacker-reachable path and building it is exactly the allocation
    # that had to be removed.
    var names = g_notify_names;
    if (names == 0) { return 0; }
    var n = vec_len(names);
    for (var i = 0; i < n; i = i + 1) {
        var nm = vec_get(names, i);
        var ms = init_get_service(g_init, nm);
        if (ms == 0) { continue; }
        if (managed_svc_pid(ms) != pid) { continue; }
        var st = managed_svc_state(ms);
        if (st == STATE_RUNNING) { return nm; }
        if (st == STATE_STARTING) { return nm; }
        return 0;
    }
    return 0;
}

# Drain the notify socket, authenticating and attributing every datagram.
#
# ⚠ THREE CONSTRAINTS HERE ARE LOAD-BEARING, AND EACH HAS A PRIOR INCIDENT.
#
# 1. A REJECTED DATAGRAM HAS ALREADY BEEN CONSUMED. The recvmsg happens before
#    any classification, so every path below has taken the message off the
#    queue. `-1` (EAGAIN) is the ONLY value that ends the loop. Returning early
#    on a rejection would leave the level-triggered fd readable with nothing
#    draining it — the exact 1.4.2 CRITICAL-1 shape that span PID 1 at 100% CPU
#    ten seconds into every boot (standing rule 13).
#
# 2. NEVER `break` ON A REJECTION. argonaut's own drain does (init.cyr:849),
#    because its receive collapses "empty" and "rejected" into the same 0 — so
#    one forged datagram per tick starves every legitimate message queued
#    behind it. kybernet's receive distinguishes them for this reason.
#
# 3. THE BOUND IS A FAIRNESS CEILING, not a formality. Without it a local
#    sender monopolises the reactor and drives the wakeup count that the
#    `kybernet.harness=loop` gate gets to bound at 500 (standing rule 23).
#
# What is honoured, and what is deliberately NOT:
#   READY=1      logged, attributed, audited. At argonaut 1.13.3 it cannot
#                change managed state — `init_start_simple` sets STATE_RUNNING
#                synchronously before returning (init.cyr:466) and there is no
#                notify service type, so no service is ever awaiting one.
#   STATUS=      sanitised, then logged attributed. Raw attacker bytes used to
#                go straight to klog.
#   RELOADING/STOPPING  logged attributed. No state sink exists.
#   WATCHDOG=1   REFUSED. The only refreshable deadline is
#                `managed_svc_last_hc`, which already means "the last health
#                check PASSED". Refreshing it on a self-reported ping would let
#                a wedged service silence a probe kybernet actually ran and saw
#                fail. That is a safety inversion, and authentication does not
#                cure it — auth proves the ping came from the service, not that
#                the service is honest about its own health. Needs a separate
#                last_notify field in argonaut; roadmapped.
#   MAINPID=     REFUSED. `str_to_int` honours a leading '-' and silently skips
#                non-digits ("MAINPID=-1" parses to -1), and `process_kill` has
#                no internal pid > 0 guard — so honouring it could hand PID 1 a
#                kill(-1, SIGKILL), i.e. every process on the machine. Needs a
#                bounded parse plus cgroup-membership proof; roadmapped.
fn handle_notify_msg() {
    var buf = notify_buf_ptr();
    for (var d = 0; d < NOTIFY_DRAIN_MAX; d = d + 1) {
        var n = notify_recv_cred(g_nfd);
        if (n == 0 - 1) { return 0; }               # queue empty: the only exit
        if (n < 0) {                                 # consumed but unauthenticated
            g_notify_nocred = g_notify_nocred + 1;
            continue;
        }

        buf = notify_buf_ptr();
        var pid = notify_cred_pid();
        var uid = notify_cred_uid();

        # Only root may notify, and every service runs as root. A non-zero uid
        # is by construction not one of our services.
        if (uid != 0) {
            g_notify_baduid = g_notify_baduid + 1;
            continue;
        }

        var name = kyb_notify_service_for_pid(pid);
        if (name == 0) {
            # Authenticated by the kernel, but not a live service pid. This is
            # the forgery case worth counting: some other root process on the
            # box is speaking sd_notify at PID 1.
            g_notify_unattributed = g_notify_unattributed + 1;
            continue;
        }

        g_notify_accepted = g_notify_accepted + 1;

        # ONE pass over the datagram, every verb resolved. Four knotify_flag
        # calls plus a sanitize walked the buffer five times per message, on a
        # path bounded at 32 datagrams per reactor wakeup — the benchmark gate
        # flagged the cost the first time it ran (+758% on the classifier).
        var sc[48];
        knotify_scan(buf, n, &sc);

        if (load64(&sc + NS_READY) == 1) {
            # ⚠ HONOURED AS OF 1.6.8, and only because argonaut 1.13.6 gave it
            # somewhere to land. Before that every service was STATE_RUNNING the
            # instant fork+exec succeeded, so no service was ever awaiting a
            # notification and READY could only ever be an observation.
            #
            # `init_notify_ready` transitions STARTING -> RUNNING for SVC_NOTIFY
            # services only, is idempotent, and is one-way — a compromised
            # service cannot declare itself un-ready and cascade restarts. It
            # returns 0 for a service that was not awaiting readiness, which is
            # normal, not an error: a `simple` service sending READY is just
            # being polite.
            if (init_notify_ready(g_init, name) == 1) {
                # ⚠ ASCII ONLY IN ANYTHING THE HARNESS GREPS. The harness builds
                # its capture with `cat -v`, which escapes non-ASCII bytes — an
                # em-dash here became `M-bM-^@M-^T` and the assertion could never
                # match, reporting a broken feature that worked. Console log lines
                # go to a serial port; keep them 7-bit.
                klog2("notify: READY - service is now running: ", name);
            } else {
                klog2("notify: ready: ", name);
            }
        }
        if (load64(&sc + NS_RELOADING) == 1) {
            klog2("notify: reloading: ", name);
        }
        if (load64(&sc + NS_STOPPING) == 1) {
            klog2("notify: stopping: ", name);
        }
        if (load64(&sc + NS_WATCHDOG) == 1) {
            # ⚠ HONOURED AS OF 1.6.8, AND IT REFRESHES ONLY `last_notify`.
            # argonaut 1.13.6 added a deadline a self-report is ALLOWED to
            # satisfy, kept strictly apart from `last_health_check` — which
            # means "a probe argonaut ran and observed passing". Refreshing the
            # health timestamp from a ping would let a wedged service silence a
            # failure that was actually observed, and authentication does not
            # cure that: SCM_CREDENTIALS proves the ping came from the service,
            # not that the service is honest about its own health.
            #
            # A service with no `watchdog_ms` configured has no notify watchdog,
            # so the ping is recorded and simply bounds nothing. That is the
            # default and it preserves pre-1.6.8 behaviour exactly.
            init_notify_watchdog(g_init, name);
            klog2("notify: watchdog ping: ", name);
        }

        if (load64(&sc + NS_STATUS_OFF) >= 0) {
            var sbuf = _notify_status_buf();
            if (sbuf != 0) {
                if (knotify_status_sanitize(buf, n, sbuf, NOTIFY_STATUS_CAP) > 0) {
                    klog2("notify: status: ", name);
                    klog2("notify:   ", sbuf);
                }
            }
        }
    }
    return 0;
}

# ================================================================
# Main boot + event loop
# ================================================================

# Wrapper over the pure `health_interval_from_services` (src/lib/svc_config.cyr),
# which is where the logic lives so src/test.cyr can reach it — main.cyr is not
# included by the test binary (standing rule 34).
fn _health_interval_for_config() {
    if (g_config == 0) { return 30; }
    return health_interval_from_services(config_services(g_config));
}

fn kybernet_run() {
    klog("starting");
    kmsg("phase 0: starting");

    # Phase 1: Mount devtmpfs first (needed for /dev/console, /dev/kmsg)
    mount_devtmpfs();
    kmsg("phase 1: devtmpfs mounted");

    # Phase 2: Console
    var con_r = setup_console();
    if (is_err_result(con_r) == 1) {
        kmsg("phase 2: console setup failed (continuing)");
    } else {
        kmsg("phase 2: console ready");
    }

    # Phase 3: Mount remaining essential filesystems
    var mount_r = mount_essential();
    if (is_ok(mount_r) == 1) {
        kmsg("phase 3: filesystems mounted");
        klog("filesystems mounted");
    } else {
        # Required-mount failure: log and continue to emergency shell
        # below rather than wedging without a recovery path. The Err
        # branch returns errno; we drop it on the floor here because
        # klog2 is best-effort (emergency boot may have no console).
        kmsg("phase 3: FATAL required mount failed");
        klog("FATAL: required mount failed");
    }
    # Surface any optional mounts that were skipped so the operator
    # knows why /dev/pts or /dev/shm aren't available without having
    # to read /proc/self/mounts. Boot continues either way.
    for (var smi = 0; smi < mount_skipped_count(); smi = smi + 1) {
        klog2("skipped optional mount: ", mount_skipped_target(smi));
    }

    # Phase 3a: Enable cgroup v2 controllers (1.5.5). Must come after the
    # cgroup2 mount in phase 3 and before any service starts.
    #
    # Without this, per-service limit files do not EXIST. A cgroup v2
    # controller's interface files appear in a cgroup only if its PARENT
    # lists that controller in cgroup.subtree_control, and kybernet never
    # wrote it — so kybernet.slice/<svc>/memory.max was always ENOENT.
    # Confirmed in the QEMU PID-1 harness before this was written; see
    # cgroup_enable_controllers in src/lib/cgroup.cyr.
    #
    # Non-fatal. A kernel built without the memory controller should run
    # services uncapped, not fail to boot.
    var cg_en = cgroup_enable_controllers();
    if (cg_en > 0) {
        klog2("cgroup controllers enabled: ", _u64_str(cg_en));
    } else {
        klog("cgroup controllers: none enabled (limits will not apply)");
    }

    # Phase 3b: Initialize structured logging (needs /var/log)
    slog_init();

    # Phase 4: Signals
    var sfd_r = setup_signals();
    if (is_err_result(sfd_r) == 1) {
        kmsg("phase 4: FATAL signal setup failed");
        klog("FATAL: signal setup failed - entering shutdown");
        do_shutdown(SHUTDOWN_POWEROFF);
        sys_pause();
        return 1;
    }
    g_sfd = result_unwrap(sfd_r);
    kmsg("phase 4: signals ready");

    # Phase 5: Event loop. Production intervals are health 30s / watchdog
    # 10s; the reactor harness shortens them so ticks occur inside its 5s
    # window (and so the gate exercises real timer drains, not just idle).
    g_loop_harness = kybernet_harness_loop_requested();
    var health_iv = 30;
    var wdog_iv = 10;
    # The restart tick stays at 1 s in both modes: it is the resolution of
    # the deferred-restart queue, not a workload timer, and a coarser tick (CHANGELOG 1.5.4)
    # would round every backoff up.
    var restart_iv = 1;
    if (g_loop_harness == 1) { health_iv = 2; wdog_iv = 1; }
    var epfd_r = eventloop_setup(g_sfd, health_iv, wdog_iv, restart_iv);
    if (is_err_result(epfd_r) == 1) {
        kmsg("phase 5: FATAL eventloop setup failed");
        klog("FATAL: eventloop setup failed - entering shutdown");
        do_shutdown(SHUTDOWN_POWEROFF);
        sys_pause();
        return 1;
    }
    g_epfd = result_unwrap(epfd_r);

    # Phase 5b: Notify socket
    var nfd_r = notify_socket_create();
    g_nfd = 0 - 1;
    if (is_ok(nfd_r) == 1) {
        g_nfd = result_unwrap(nfd_r);
        var notify_r = eventloop_add_notify(g_epfd, g_nfd);
        if (is_err_result(notify_r) == 1) {
            klog("notify epoll registration failed (continuing)");
            sys_close(g_nfd);
            g_nfd = 0 - 1;
        } else {
            klog("notify socket bound");
            # Publish it. sd_notify discovery is by $NOTIFY_SOCKET, and
            # argonaut builds each child's envp itself, so without this no
            # service could ever find the socket kybernet just bound and
            # registered — the entire readiness/watchdog-ping path was
            # unreachable from the service side. Needs argonaut 1.12.0's
            # extra-env seam. The Rust implementation set this immediately
            # after binding; the port dropped it. 1.5.4.
            var envv = vec_new();
            vec_push(envv, notify_env_entry());
            argonaut_set_extra_env(envv);
        }
    } else {
        klog("notify socket failed (continuing)");
    }

    # Phase 6: Load config + initialize argonaut
    g_config = load_config();
    # A broken config at boot is not the same as an absent one, and it must
    # not look like one. There is nothing to fall back to this early, so the
    # board still boots on defaults — but it says so on the console AND in
    # dmesg, because on an edge deployment this is the difference between
    # booting verified and booting ordinary.
    if (g_config == 0) {
        klog("FATAL CONFIG: unusable /etc/kybernet/config.json - booting on DEFAULTS");
        kmsg("kybernet: unusable config, booting on DEFAULTS - services/boot_mode/edge are NOT as configured");
        g_config = argonaut_config_default();
    }
    g_init = argonaut_init_new(g_config);
    g_health_tracker = health_tracker_new();

    # Register the per-service sandbox before ANY service can be spawned.
    # argonaut invokes this in the child between fork and exec; see
    # kyb_pre_exec. Must precede run_boot_stages/start_services below —
    # a hook registered after the first spawn confines nothing.
    argonaut_set_pre_exec_hook(&kyb_pre_exec);
    klog("argonaut initialized");

    # Re-arm the health timer to what the services actually asked for. The
    # timer was necessarily created at phase 5, before the config existed.
    # Harness loop mode keeps its short interval so ticks land inside the 5 s
    # window — the gate needs the tick to fire, not to be realistic.
    if (g_loop_harness == 0) {
        var hiv = _health_interval_for_config();
        if (hiv != 30) {
            if (eventloop_rearm_health(hiv) == 1) {
                klog2("health poll interval (s): ", _u64_str(hiv));
            } else {
                klog("WARNING: could not re-arm the health timer - staying at 30s");
            }
        }
    }

    kmsg("phase 6: argonaut ready");

    # Phase 6c: Edge boot pre-flight (capability detect + PCR read).
    # No-op unless config_boot_mode == BOOT_EDGE && config_verify_boot.
    # Returns 0 only when a hard prerequisite is missing (TPM required
    # but absent, or dm-verity required but unsupported).
    #
    # This gate is FAIL-CLOSED and must stay that way. Pre-1.4.2 it
    # dropped to the emergency shell and then — because drop_to_emergency()
    # RETURNS once the shell exits — fell straight through to phases 7/8
    # and booted every service normally. On a device that asked for
    # tpm_attestation, pulling the TPM therefore yielded a root shell
    # followed by a fully booted, unverified system: the exact outcome
    # verified boot exists to prevent. 1.4.2 audit HIGH-2.
    #
    # The operator still gets the recovery shell; when it exits we power
    # off rather than continue. Contrast phase 7 below, where continuing
    # after a failed *boot stage* is deliberate — that is a availability
    # decision about ordinary services, not a trust decision about the
    # rootfs.
    # On an EDGE board, require authentication for the recovery shell.
    #
    # Every edge refusal below funnels into drop_to_emergency(), and
    # g_emerg_require_auth defaults to 0 — so before 1.5.7 a pulled TPM, a
    # missing veritysetup, or a corrupted rootfs handed an UNAUTHENTICATED
    # ROOT SHELL on the console to whoever caused it. On a device whose
    # whole point is verified boot, that inverts the trust model completely.
    #
    # With no password hash configured there is nothing to authenticate
    # against, and verify_emergency_auth fails closed — which would loop an
    # operator through a shell they can never enter. So in that case skip
    # the shell entirely and go straight to poweroff: refusing to boot is
    # the honest outcome, and it is what the operator asked for by setting
    # a hard prerequisite. 1.5.7.
    var edge_ok = edge_boot_run(g_config);
    if (edge_ok == 0) {
        kmsg("phase 6c: FATAL edge-boot prerequisite missing");
        klog("FATAL: edge-boot prerequisite missing - emergency shell");
        if (g_emerg_hash != 0) {
            g_emerg_require_auth = 1;
            klog("edge refusal: emergency shell requires authentication");
            drop_to_emergency();
        } else {
            klog("edge refusal: no emergency_password_hash configured - NOT opening a root shell");
            kmsg("kybernet: edge refusal, no emergency auth configured - shell suppressed");
        }
        klog("FATAL: refusing to continue boot without edge prerequisites");
        kmsg("phase 6c: powering off - edge prerequisites unmet");
        do_shutdown(SHUTDOWN_POWEROFF);
        sys_pause();
    } else {
        kmsg("phase 6c: edge boot pre-flight complete");
    }

    # Phase 7: Run boot stages
    var boot_r = run_boot_stages();
    if (boot_r < 0) {
        klog("boot stages failed");
        if (init_should_drop_to_emergency(g_init) == 1) {
            drop_to_emergency();
        }
        # After emergency shell exits, try to continue boot
        klog("continuing after emergency shell");
    }

    # Phase 8: Start services. Usually already done — a service-group boot
    # stage above starts them on demand so those stages can report real
    # status. This covers modes whose sequence has no service stage.
    ensure_services_started();
    kmsg("phase 8: services started");
    klog("services started");

    # 1.1.4 harness gate: if `kybernet.harness=1` was on /proc/cmdline,
    # the boot-test scaffold has seen everything it needs (markers
    # phase 0..8 + services_started). Shut down clean instead of
    # entering the event loop — qemu's `-no-reboot` then terminates
    # the VM cleanly and the test script asserts on the marker set.
    if (kybernet_harness_requested() == 1) {
        kmsg("phase 9: harness done - shutting down clean");
        klog("harness done - shutting down clean");
        do_shutdown(SHUTDOWN_POWEROFF);
        return 0;
    }

    kmsg("phase 9: ready - entering event loop");
    klog("ready - entering event loop");

    # 1.4.2 reactor gate — see kybernet_harness_loop_requested(). In loop
    # mode the epoll timeout is bounded so the deadline is actually checked
    # (a blocking wait would never reach it), and the timers were armed
    # short back at phase 5 so several ticks land inside the window.
    var loop_deadline = 0;
    var ep_timeout = 0 - 1;
    var wakeups = 0;
    if (g_loop_harness == 1) {
        loop_deadline = monotonic_ms() + 5000;
        ep_timeout = 250;
        klog("harness: reactor mode - 5s bounded loop");
    }

    # Phase 9: Event loop
    var running = 1;
    while (running == 1) {
        if (g_loop_harness == 1 && monotonic_ms() >= loop_deadline) {
            var wbuf = alloc(24);
            var wlen = fmt_int_buf(wakeups, wbuf);
            store8(wbuf + wlen, 0);
            klog2("harness: reactor wakeups=", wbuf);
            kmsg("phase 9: harness reactor done");
            klog("harness done - shutting down clean");
            do_shutdown(SHUTDOWN_POWEROFF);
            return 0;
        }
        wakeups = wakeups + 1;
        var events = epoll_wait_events(g_epfd, 8, ep_timeout);
        var elen = vec_len(events);
        for (var ei = 0; ei < elen; ei = ei + 1) {
            var ev = vec_get(events, ei);
            var tok = event_token(ev);
            switch (tok) {
                case 1: {
                    var sig = read_signal(g_sfd);
                    if (is_some(sig) == 1) {
                        handle_signal(unwrap(sig));
                    }
                }
                case 2: handle_health_tick();
                case 3: handle_watchdog_tick();
                case 4: handle_restart_tick();
                case 5: handle_notify_msg();
                default: {
                    # Unknown epoll event token — log and continue.
                    # Previously returned 0 here, which fell through to
                    # main → sys_exit(0) and panicked the kernel
                    # (PID 1 must NEVER return cleanly). Same class as
                    # 0.95.0's PID-1-exit-path fix; this case was
                    # missed at the time.
                    klog("WARNING: unknown epoll token - ignoring");
                }
            }
        }
    }

    return 0;
}

fn main() {
    # CMOS CP 0x30: kybernet entry. AGNOS syscall 26 = write_boot_checkpoint,
    # writes CMOS[0x50] = 0x30. Iron-boot diagnostic: if CMOS[0x50] reaches
    # 0x30, kybernet's main() executed at least one syscall after the ring-3
    # transition.
    #
    # This is a deliberate, documented exception to standing rule 1 (no
    # literal syscall numbers) — the number is an AGNOS ABI constant, not a
    # Linux one, so there is no stdlib wrapper to route it through. What the
    # number lands on when kybernet runs under Linux instead differs by arch,
    # and BOTH are inert, which is what makes the exception safe:
    #   x86_64  26 = msync(0x30, 0, 0)        -> EINVAL, 0x30 is unaligned
    #   aarch64 26 = inotify_init1(0x30)      -> EINVAL, 0x30 is not a valid
    #                                            flag set (IN_NONBLOCK|IN_CLOEXEC)
    # The aarch64 half was undocumented before 1.4.2; had 0x30 been a valid
    # flag combination it would have leaked an inotify fd on every boot.
    # Re-check both columns if this checkpoint value ever changes.
    # 1.4.2 audit LOW-2.
    syscall(26, 0x30);

    alloc_init();

    # Check if we're PID 1
    if (sys_getpid() != 1) {
        klog("WARNING: not running as PID 1");
    }

    var exit_code = kybernet_run();
    return exit_code;
}

var r = main();
sys_exit(r);
