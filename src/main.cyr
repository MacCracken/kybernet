# kybernet — AGNOS PID 1 init system
# Written in Cyrius. Manages system boot, services, and shutdown.
#
# Boot sequence:
#   1. Mount devtmpfs + console setup
#   2. Mount essential filesystems
#   3. Block signals + create signalfd
#   4. Setup epoll event loop + notify socket
#   5. Load config from /etc/kybernet/config.json (or defaults)
#   6. Initialize argonaut + execute tmpfiles
#   7. Run boot stages + start services (wave-based)
#   8. Event loop: signals, health, watchdog, notify, restarts
#   9. Shutdown on SIGTERM/SIGINT (coordinated via argonaut)

# Kybernet modules (stdlib + deps auto-included via cyrius.toml)
#
# sigil (pulled transitively via libro) banks per-thread crypto scratch and
# calls thread_local_{init,get,set}. Under cyrius 6.2.x the manifest stdlib
# pin resolves thread_local.cyr into lib/ but no longer auto-includes it into
# the sigil dependency chain — so include it explicitly here, ahead of the
# module chain that pulls sigil. Without this the binary links but SIGILLs at
# runtime on an uninitialised thread pointer (see CLAUDE.md / libro 2.7.x).
include "lib/thread_local.cyr"
include "src/lib/log.cyr"
include "src/lib/console.cyr"
include "src/lib/signals.cyr"
include "src/lib/reaper.cyr"
include "src/lib/privdrop.cyr"
include "src/lib/mount.cyr"
include "src/lib/cgroup.cyr"
include "src/lib/eventloop.cyr"
include "src/lib/notify.cyr"
include "src/lib/seccomp.cyr"
include "src/lib/sandbox.cyr"
include "src/lib/edge_boot.cyr"
include "src/lib/svc_config.cyr"
include "src/lib/service_sandbox.cyr"
include "src/lib/restart_queue.cyr"
include "src/lib/boot_stages.cyr"

# ================================================================
# Globals
# ================================================================

var g_init = 0;
var g_health_tracker = 0;
var g_epfd = 0;
var g_nfd = 0;
var g_sfd = 0;
var g_config = 0;
var g_log_fd = 0;
# `kybernet.harness=loop` — set once at phase 5 so the timer intervals and
# the reactor's epoll timeout agree. See kybernet_harness_loop_requested().
var g_loop_harness = 0;
# Guards start_services against a second run. Service-group boot stages
# trigger startup on demand (see run_boot_stages), and phase 8 then covers
# any mode whose sequence has no service stage at all — so the call can
# legitimately arrive from either side, but must only do work once.
var g_services_started = 0;

# Emergency-shell authentication, from config.json. Held as globals rather
# than on ArgonautConfig because EmergencyShellConfig is built on demand in
# drop_to_emergency and argonaut's config struct has no slot for it. 1.5.4.
var g_emerg_require_auth = 0;
var g_emerg_hash = 0;          # Str ptr, 0 = none configured

# ================================================================
# Logging is factored into src/lib/log.cyr (since 1.2.0). klog,
# klog2, kmsg, slog, slog_init, and _logbuf live there. g_log_fd
# stays in the globals block above so the shutdown path can close it.

# ================================================================
# Config loading from JSON
# ================================================================

fn load_config() {
    var buf = alloc(16384);
    var n = file_read_all("/etc/kybernet/config.json", buf, 16384);
    if (n <= 0) {
        klog("no config found, using defaults");
        return argonaut_config_default();
    }

    klog("loaded config: /etc/kybernet/config.json");

    # 1.5.0: parse the full VALUE TREE, not the flat key/value pairs.
    # `json_parse` only yields top-level scalars, which is why services
    # could never be read — the array was structurally out of reach. bayan
    # has had `json_v_parse` + arr/obj accessors the whole time.
    var root = json_v_parse_buf(buf, n);
    if (root == 0) {
        klog("config parse failed, using defaults");
        return argonaut_config_default();
    }
    if (json_v_is_obj(root) == 0) {
        klog("config root is not an object, using defaults");
        return argonaut_config_default();
    }

    var cfg = argonaut_config_default();

    # boot_mode — via argonaut's parser (1.10.0) rather than a hand-rolled
    # if-ladder. An unrecognised mode keeps the default instead of silently
    # landing on whichever branch happens to fall through.
    var mode_str = _cfg_str(root, "boot_mode", 0);
    if (mode_str != 0) {
        var mr = boot_mode_parse(mode_str);
        if (is_ok(mr) == 1) {
            store64(cfg, result_unwrap(mr));
        } else {
            klog("config: unrecognised boot_mode — keeping default");
        }
    }

    var bt = _cfg_int(root, "boot_timeout_ms", 0);
    if (bt > 0) { store64(cfg + 16, bt); }
    var st = _cfg_int(root, "shutdown_timeout_ms", 0);
    if (st > 0) { store64(cfg + 24, st); }

    # log_to_console is a real JSON bool now. The old code compared it
    # against the STRING "false", so `"log_to_console": false` — the
    # spelling any operator would actually write — was ignored entirely.
    store64(cfg + 32, _cfg_bool(root, "log_to_console", 1));

    # Emergency-shell auth. Both keys must be present for the gate to
    # engage; verify_emergency_auth FAILS CLOSED if require_auth is set
    # without a hash (argonaut 1.8.6 MEDIUM-3), so a half-configured pair
    # locks the shell rather than opening it. 1.5.4.
    g_emerg_require_auth = _cfg_bool(root, "emergency_require_auth", 0);
    g_emerg_hash = _cfg_str(root, "emergency_password_hash", 0);
    if (g_emerg_require_auth == 1) {
        klog("config: emergency shell requires authentication");
    }

    # Services (the v1.5.0 headline). See src/lib/svc_config.cyr.
    var svcs = svc_defs_from_json(root);
    var scount = vec_len(svcs);
    if (scount > 0) {
        var dst = config_services(cfg);
        for (var i = 0; i < scount; i = i + 1) { vec_push(dst, vec_get(svcs, i)); }
        klog2("config: services parsed: ", _u64_str(scount));
    }

    return cfg;
}

# Small decimal formatter for log lines — fmt_int_buf writes digits without
# a NUL, and every cstr logging path here calls strlen.
fn _u64_str(n) {
    var b = alloc(24);
    var l = fmt_int_buf(n, b);
    store8(b + l, 0);
    return b;
}

# SIGHUP config reload.
#
# What this can and cannot do, precisely — because the previous version
# claimed more than it delivered. It did `store64(g_init, new_cfg)`, which
# overwrites field 0 of ArgonautInit and nothing else, under a comment
# reading "Re-initialize argonaut with new config". But argonaut_init_new
# DERIVES two further fields from the config at construction time: the boot
# sequence (build_boot_sequence(mode)) and the service map (from
# default_services(mode) plus config services). Neither was rebuilt, so a
# reload left new config values sitting on top of derived state built from
# the OLD config — a silent mix, with no way for an operator to tell.
# 1.4.2 audit MEDIUM.
#
# Rebuilding them is not the fix. The service map holds live runtime state —
# PIDs, states, restart counts — for processes that are still running.
# Replacing it would orphan every one of them: still executing, no longer
# tracked, never reaped. In PID 1 that is far worse than a stale timeout.
#
# So the reload applies the values that are safe to change while the system
# is up, and says plainly that the rest needs a reboot. Honest and narrow
# beats a reload that appears total and is not.
fn reload_config() {
    var new_cfg = load_config();
    if (new_cfg == 0) { return 0; }

    var old_cfg = g_config;
    g_config = new_cfg;

    if (g_init != 0) {
        # Live-applicable scalars only. These are read fresh on each use,
        # so updating them in place takes effect immediately.
        var cur = load64(g_init);
        if (cur != 0) {
            store64(cur + 16, config_boot_timeout(new_cfg));
            store64(cur + 24, config_shutdown_timeout(new_cfg));
            store64(cur + 32, config_log_console(new_cfg));
        }

        # Anything structural is NOT applied — say so rather than let the
        # operator believe a reload took.
        if (old_cfg != 0) {
            if (config_boot_mode(new_cfg) != config_boot_mode(old_cfg)) {
                klog("config reload: boot_mode change requires a reboot — NOT applied");
            }
        }
        if (vec_len(config_services(new_cfg)) > 0) {
            klog("config reload: service definitions require a reboot — NOT applied");
        }
    }

    klog("config reloaded (timeouts + logging; structural changes need a reboot)");
    return 1;
}

# ================================================================
# Tmpfile directive execution
# ================================================================

enum TmpfileType {
    TMP_DIR = 0;
    TMP_SYMLINK = 1;
    TMP_TOUCH = 2;
}

fn execute_tmpfiles() {
    if (g_config == 0) { return 0; }
    var tmpfiles = config_tmpfiles(g_config);
    if (tmpfiles == 0) { return 0; }

    var count = vec_len(tmpfiles);
    var created = 0;
    for (var ti = 0; ti < count; ti = ti + 1) {
        var entry = vec_get(tmpfiles, ti);
        var etype = load64(entry);
        var path = load64(entry + 8);

        if (etype == TMP_DIR) {
            var r = sys_mkdir(path, 0x1C0);
            if (is_err(r) == 0) { created = created + 1; }
        } elif (etype == TMP_SYMLINK) {
            var target = load64(entry + 16);
            # sys_symlink() dispatches to symlinkat(AT_FDCWD,...) on
            # aarch64 (SYS_SYMLINK 88 is x86_64-only — aarch64 numbers
            # SYS_PIPE2 there). Same lesson as the 1.0.0 sandbox.cyr
            # SYS_OPEN fix.
            sys_symlink(target, path);
            created = created + 1;
        } elif (etype == TMP_TOUCH) {
            var mode = load64(entry + 16);
            # O_CLOEXEC: tmpfile touch — fd is closed immediately after
            # creation; CLOEXEC guards against fork-between-open-and-close.
            var fd = sys_open(path, O_WRONLY | O_CREAT | O_CLOEXEC, mode);
            if (fd >= 0) {
                sys_close(fd);
                created = created + 1;
            }
        }
    }

    if (created > 0) {
        klog2("tmpfiles created: ", "ok");
    }
    return created;
}

# ================================================================
# Emergency shell
# ================================================================

# Read one line from the console into `buf`, stripping the trailing newline.
# Returns the length, or -1 on read error.
#
# Unbuffered and un-echoed-suppressed: PID 1 has no termios layer here, so
# the password IS echoed to the console. That is a real weakness and it is
# stated in the roadmap rather than hidden — an operator at a physical
# console is the threat this gate addresses, and a shoulder-surfer at that
# same console already has the machine.
fn _read_console_line(buf, cap) {
    var n = sys_read(STDIN_FD, buf, cap - 1);
    if (is_err(n) == 1) { return 0 - 1; }
    if (n <= 0) { return 0 - 1; }
    while (n > 0) {
        var c = load8(buf + n - 1);
        if (c != 10 && c != 13) { break; }
        n = n - 1;
    }
    store8(buf + n, 0);
    return n;
}

fn drop_to_emergency() {
    klog("=== ENTERING EMERGENCY MODE ===");

    var esc = emergency_shell_default();

    # Overlay the operator's auth policy onto argonaut's default config.
    # emergency_shell_default() hard-codes require_auth = 0 / hash = 0, so
    # without this the gate could never engage no matter what config.json
    # said. Rust read the same two fields off EmergencyShellConfig.
    # 1.5.4 — closes the last rust-old port gap.
    store64(esc + 24, g_emerg_require_auth);
    store64(esc + 32, g_emerg_hash);

    if (g_emerg_require_auth == 1) {
        klog("emergency shell: authentication required");
        sys_write(STDERR_FD, "Password: ", 10);
        var pbuf = alloc(256);
        var plen = _read_console_line(pbuf, 256);
        var granted = 0;
        if (plen >= 0) {
            granted = verify_emergency_auth(esc, str_new(pbuf, plen));
        }
        # Wipe the plaintext regardless of the verdict. The arena is never
        # reset in PID 1, so anything left here persists for the life of
        # the system in a process that can be core-dumped.
        for (var z = 0; z < 256; z = z + 1) { store8(pbuf + z, 0); }
        if (granted == 0) {
            klog("emergency shell: AUTHENTICATION FAILED — rebooting");
            sys_write(STDERR_FD, "Authentication failed. Rebooting.\n", 34);
            sys_reboot(RB_AUTOBOOT);
            # sys_reboot does not return on success. If it did (CAP_SYS_BOOT
            # dropped, say), fall through to a hang rather than to the
            # shell — never open an unauthenticated root shell here.
            while (1 == 1) { sys_pause(); }
        }
        klog("emergency shell: authenticated");
    }

    var shell_path = load64(esc);
    var banner = load64(esc + 16);

    # Print banner
    if (banner != 0) {
        sys_write(STDERR_FD, str_data(banner), str_len(banner));
    }

    # Fork and exec the shell
    var pid = sys_fork();
    if (pid == 0) {
        # Drop PID 1's blocked mask before exec. setup_signals blocks
        # SIGCHLD/SIGTERM/SIGINT/SIGHUP/SIGPWR so they can be read from the
        # signalfd; fork inherits that mask and execve preserves it, so
        # without this reset Ctrl-C is inert in the recovery shell and in
        # everything launched from it — the one shell where an operator
        # most needs job control. 1.4.2 audit MEDIUM-4.
        reset_child_signal_mask();
        # Child — exec the emergency shell. The raw syscall(59/60,...)
        # this replaces was x86_64-only; sys_execve / sys_exit dispatch
        # per-arch (SYS_EXECVE 59→221, SYS_EXIT 60→93 on aarch64).
        var argv = alloc(16);
        store64(argv, str_data(shell_path));
        store64(argv + 8, 0);
        sys_execve(str_data(shell_path), argv, 0);
        # If exec fails, try /bin/sh
        store64(argv, "/bin/sh");
        sys_execve("/bin/sh", argv, 0);
        sys_exit(1);
    } elif (pid > 0) {
        # Parent — wait for shell to exit
        klog("emergency shell started");
        var status = alloc(8);
        sys_waitpid(pid, status, 0);
        klog("emergency shell exited");
    } else {
        klog("FATAL: fork failed for emergency shell");
    }

    return 0;
}

# ================================================================
# Harness mode — QEMU PID-1 boot-validation gate (1.1.4)
# ================================================================
# When `kybernet.harness=1` is on the kernel cmdline, kybernet runs
# its normal boot sequence through phase 8 (services started) and
# then shuts down cleanly instead of entering the event loop. The
# qemu/boot-test.sh harness greps stdout for the phase markers and
# the "harness done" line, asserting the full sequence completed
# before the timeout fires.
#
# Pattern lifted from argonaut's pid1_harness_requested() (1.6.x).
# Substring match with start-/end-boundary checks so
# `kybernet.harness=11` or `nokybernet.harness=1` don't accidentally
# trigger harness mode.

# Scan /proc/cmdline for `needle` as a whitespace-delimited token.
# Boundary-checked so `kybernet.harness=11` or `nokybernet.harness=1`
# do not match `kybernet.harness=1`.
fn _cmdline_has(needle, nlen) {
    var fd = sys_open("/proc/cmdline", O_RDONLY | O_CLOEXEC, 0);
    if (fd < 0) { return 0; }
    var buf = alloc(1024);
    var n = sys_read(fd, buf, 1024);
    sys_close(fd);
    if (n <= 0) { return 0; }
    var i = 0;
    while (i <= n - nlen) {
        var matched = 1;
        var j = 0;
        while (j < nlen) {
            if (load8(buf + i + j) != load8(needle + j)) {
                matched = 0;
                j = nlen;
            } else {
                j = j + 1;
            }
        }
        if (matched == 1) {
            # Left boundary: start-of-buffer, space, or tab.
            var left_ok = 0;
            if (i == 0) { left_ok = 1; }
            else {
                var lb = load8(buf + i - 1);
                if (lb == 32) { left_ok = 1; }
                if (lb == 9)  { left_ok = 1; }
            }
            # Right boundary: end-of-buffer, space, tab, or newline.
            var right_ok = 0;
            var ri = i + nlen;
            if (ri >= n) { right_ok = 1; }
            else {
                var rb = load8(buf + ri);
                if (rb == 32) { right_ok = 1; }
                if (rb == 9)  { right_ok = 1; }
                if (rb == 10) { right_ok = 1; }
            }
            if (left_ok == 1 && right_ok == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

fn kybernet_harness_requested() {
    return _cmdline_has("kybernet.harness=1", 18);
}

# `kybernet.harness=loop` — the REACTOR gate (1.4.2).
#
# The boot-only harness above shuts down at phase 9 without ever entering
# the event loop, so for four audits no release gate executed a single
# reactor iteration. That is precisely how CRITICAL-1 (level-triggered
# timerfds never drained -> PID 1 spinning at 100% CPU forever, ~10 s
# after every boot) reached production and survived: the defect lives
# entirely past the boot-only gate's shutdown point.
#
# Loop mode runs the real event loop with short timer intervals for a
# bounded wall time, then prints the wakeup count and shuts down. A
# correct reactor sleeps between ticks, so the count is single digits; a
# spinning one reports hundreds of thousands. boot-test.sh asserts on it.
fn kybernet_harness_loop_requested() {
    return _cmdline_has("kybernet.harness=loop", 21);
}

# ================================================================
# Shutdown (coordinated via argonaut)
# ================================================================

fn do_shutdown(shutdown_type) {
    if (g_init != 0) {
        var plan = init_plan_shutdown(g_init, shutdown_type);
        if (plan != 0) {
            klog("stopping services...");
            var timeout = 5000;
            if (g_config != 0) {
                timeout = config_shutdown_timeout(g_config);
            }
            init_stop_all(g_init, timeout);
            remove_all_service_cgroups();
        }
    }

    klog("syncing filesystems...");
    sys_sync();

    slog("info", "shutdown complete");

    klog("shutdown");
    # Clear the global along with the close. g_log_fd doubles as slog2's
    # open-flag (src/lib/log.cyr), so a closed-but-nonzero value makes
    # every later klog write to a dead — and eventually recycled —
    # descriptor, and makes the `> 0` guard meaningless. Also note the
    # final klog now lands in the file before the fd goes away.
    # 1.4.2 audit LOW-4.
    if (g_log_fd > 0) { sys_close(g_log_fd); g_log_fd = 0; }
    # All three shutdown kinds dispatch. HALT was unmapped before 1.5.4 and
    # fell through to POWER_OFF — latent, since no caller produces it today,
    # but a silent mismatch the moment one does. Rust dispatched all three.
    if (shutdown_type == SHUTDOWN_REBOOT) {
        sys_reboot(RB_AUTOBOOT);
    } elif (shutdown_type == SHUTDOWN_HALT) {
        sys_reboot(RB_HALT_SYSTEM);
    } else {
        sys_reboot(RB_POWER_OFF);
    }
    # If reboot fails, pause forever
    sys_pause();
    return 0;
}

# ================================================================
# Signal handling
# ================================================================

fn handle_signal(signum) {
    var cls = classify_signal(signum);
    switch (cls) {
        case 1: handle_sigchld();
        case 2: klog("received SIGTERM"); do_shutdown(SHUTDOWN_POWEROFF);
        case 3: klog("received SIGINT"); do_shutdown(SHUTDOWN_REBOOT);
        case 4: handle_sighup();
        case 5: klog("received SIGPWR — power failure"); do_shutdown(SHUTDOWN_POWEROFF);
        default: return 0;
    }
    return 0;
}

fn handle_sigchld() {
    if (g_init == 0) {
        reap_and_log();
        return 0;
    }

    # Reap tracked services first
    var reaped = init_reap_services(g_init);
    var rlen = vec_len(reaped);
    for (var ri = 0; ri < rlen; ri = ri + 1) {
        var entry = vec_get(reaped, ri);
        var name = load64(entry);
        var exit_code = load64(entry + 8);
        var action = load64(entry + 16);

        # argonaut returns service names as Str (boxed); kybernet's
        # logging path expects cstr. Same fix as the 1.1.4 boot-stage
        # `desc` patch — that one was point-only, this pass closes the
        # rest of the surface (handle_sigchld, start_services, health,
        # watchdog).
        var name_cs = str_data(name);
        klog2("service exited: ", name_cs);
        slog("warn", name_cs);

        if (action != 0) {
            var action_type = load64(action);
            if (action_type == CRASH_RESTART) {
                var delay = load64(action + 8);
                # ENQUEUE, do not restart here. argonaut computed `delay`
                # as an exponential backoff; restarting synchronously threw
                # it away and relaunched a crash-looping service as fast as
                # it could die. The reactor's restart tick performs the
                # actual relaunch once the delay has elapsed — see
                # src/lib/restart_queue.cyr. 1.5.4.
                if (restart_queue_push(name_cs, monotonic_ms() + delay) == 1) {
                    klog2("  restart scheduled: ", name_cs);
                }
            } elif (action_type == CRASH_GIVE_UP) {
                var reason = load64(action + 16);
                klog2("  giving up on: ", name_cs);
                if (reason != 0) {
                    klog2("  reason: ", str_data(reason));
                }
                # The service will not be restarted, so its cgroup is dead
                # weight — and not necessarily EMPTY: the main process
                # exited, but anything it forked is still in there and still
                # counted against the slice. Kill the remainder, then remove
                # the directory. Before 1.5.3 neither call had a production
                # call site at all, so give-up left a populated cgroup behind
                # for the life of the system. 1.4.2 audit LOW.
                kill_cgroup(name_cs);
                remove_service_cgroup(name_cs);
            } elif (action_type == CRASH_IGNORE) {
                klog2("  ignoring exit: ", name_cs);
            }
        }
    }

    # Reap orphaned zombies
    reap_zombies();
    return 0;
}

fn handle_sighup() {
    klog("received SIGHUP — reloading config");
    var ok = reload_config();
    if (ok == 1) {
        klog("config reload successful");
    } else {
        klog("config reload failed, keeping current config");
    }
    return 0;
}

# ================================================================
# Boot stages
# ================================================================

fn run_boot_stages() {
    if (g_init == 0) { return 0; }

    var step = init_current_stage(g_init);
    while (step != 0) {
        var stage = load64(step);
        var desc = load64(step + 8);

        # argonaut returns description as a Str (boxed) — klog2/kmsg
        # need a cstr. str_data() reads the underlying buffer ptr.
        # Resolve ONCE here so every use below (including the failure
        # arms) is a cstr; passing the raw Str to klog2 makes strlen()
        # walk the {data,len} box instead of the text. See 1.4.2 audit
        # MEDIUM-2 — the two failure arms had exactly that bug.
        var desc_cs = str_data(desc);
        klog2("boot: ", desc_cs);
        kmsg(desc_cs);

        # Service-group stages report whether their services came up, so
        # the services have to have been attempted first. Starting them
        # here rather than in a separate later phase is what makes those
        # stages mean anything — before 1.5.1 they were evaluated before
        # any service existed, which is part of why they all returned 1.
        if (boot_stage_needs_services(stage) == 1) { ensure_services_started(); }

        var ok = execute_boot_stage_for(g_init, g_config, stage);
        if (ok == STAGE_OK) {
            init_mark_step_complete(g_init, stage);
        } elif (ok == STAGE_SKIP) {
            # Not performed by this deployment — recorded as SKIPPED, which
            # init_is_boot_complete accepts. Distinct from claiming success.
            klog2("boot: skipped (not applicable): ", desc_cs);
            init_mark_step_skipped(g_init, stage, "not performed by this deployment");
        } else {
            var required = load64(step + 16);
            if (required == 1) {
                klog2("FATAL: required boot stage failed: ", desc_cs);
                init_mark_step_failed(g_init, stage, "stage execution failed");
                return 0 - 1;
            }
            klog2("WARNING: optional boot stage failed: ", desc_cs);
            init_mark_step_failed(g_init, stage, "stage execution failed");
        }

        step = init_current_stage(g_init);
    }

    return 0;
}

# ================================================================
# Service startup
# ================================================================

# Tear down every service cgroup argonaut knows about.
#
# Called from do_shutdown after init_stop_all. Services have been SIGTERMed
# and reaped by then, but a cgroup whose last process is gone is still a
# live directory in the hierarchy — nothing removes it implicitly. Before
# 1.5.3 nothing removed it explicitly either: create_service_cgroup and
# move_to_cgroup were the only cgroup calls with production call sites, so
# directories accumulated for the life of the system across every service
# restart cycle. 1.4.2 audit LOW.
#
# kill_cgroup first, because "stopped" means the tracked PID exited, not
# that the cgroup is empty — anything the service forked and orphaned is
# still in it, and rmdir on a non-empty cgroup fails with EBUSY.
#
# Best-effort throughout: this runs on the shutdown path, where a failed
# rmdir must not stop us reaching sys_reboot. Names come from argonaut's
# registry as cstrs, which is what the cgroup helpers want.
fn remove_all_service_cgroups() {
    if (g_init == 0) { return 0; }
    var names = init_service_names(g_init);
    var n = vec_len(names);
    var removed = 0;
    for (var i = 0; i < n; i = i + 1) {
        var nm = vec_get(names, i);
        kill_cgroup(nm);
        if (is_ok(remove_service_cgroup(nm)) == 1) { removed = removed + 1; }
    }
    if (removed > 0) { klog2("removed service cgroups: ", _u64_str(removed)); }
    return removed;
}

# Idempotent wrapper — see g_services_started.
fn ensure_services_started() {
    if (g_services_started == 1) { return 0; }
    g_services_started = 1;
    return start_services();
}

fn start_services() {
    if (g_init == 0) { return 0; }

    # Resolve waves over EVERY registered service, not just the config
    # half. argonaut_init_new registers default_services(mode) AND the
    # config services; walking `config_services(config)` alone meant the
    # defaults argonaut had just registered were never started. Needs
    # argonaut 1.10.0's init_service_defs. 1.5.0.
    var svc_defs = init_service_defs(g_init);
    var waves = resolve_service_waves(svc_defs);
    if (waves == 0) {
        klog("ERROR: circular dependency in services");
        return 0 - 1;
    }

    var started = 0;
    var failed = 0;
    var nwaves = vec_len(waves);
    for (var wi = 0; wi < nwaves; wi = wi + 1) {
        var wave = vec_get(waves, wi);
        var wlen = vec_len(wave);

        klog2("starting wave ", "...");

        for (var si = 0; si < wlen; si = si + 1) {
            var name = vec_get(wave, si);
            # argonaut's service-name vec is Str; cgroup path builders
            # and klog2 both want cstr. str_data() once, reuse the
            # cstr ptr — cgroup_path's cache also keys on it so we get
            # stable cache hits within the burst.
            var name_cs = str_data(name);
            klog2("  starting: ", name_cs);

            # name_cs, NOT name. resolve_service_waves returns waves of
            # boxed Str, but argonaut's service map is keyed by cstr
            # (`str_data(svc_def_name(sd))` in argonaut_init_new), so
            # passing the Str box makes map_get miss and EVERY start
            # returns -1. Latent until 1.5.0 only because the wave list was
            # always empty. See argonaut's note on init_get_service.
            # init_start_service's return is TRI-STATE, not a plain pid:
            #   > 0  a live process (SVC_SIMPLE / SVC_FORKING)
            #   == 0 a SVC_ONESHOT that ran to completion with exit 0
            #        (init_start_oneshot waits, then returns 0 — there is no
            #        surviving process to place in a cgroup)
            #   < 0  failed to start
            # Treating this as `pid > 0` logged every SUCCESSFUL oneshot as
            # "FAILED to start". Found the first time this loop body ever
            # executed in a real boot — it was unreachable before 1.5.0
            # because the wave list was always empty. 1.5.0.
            var pid = init_start_service(g_init, name_cs);
            if (pid > 0) {
                klog2("  started: ", name_cs);
                started = started + 1;
                create_service_cgroup(name_cs);
                move_to_cgroup(name_cs, pid);
            } elif (pid == 0) {
                klog2("  completed (oneshot): ", name_cs);
                started = started + 1;
            } else {
                klog2("  FAILED to start: ", name_cs);
                failed = failed + 1;
            }
        }
    }

    # A boot in which every service failed still reached the event loop
    # before 1.5.4 — argonaut's own predicate was consulted for a failed
    # boot STAGE but never for the service waves. Ask it here too.
    if (failed > 0 && started == 0) {
        klog("all services failed to start");
        if (init_should_drop_to_emergency(g_init) == 1) {
            drop_to_emergency();
        }
    }

    return 0;
}

# ================================================================
# Event loop handlers
# ================================================================

fn handle_health_tick() {
    # Drain FIRST, and unconditionally — before the g_init guard. The
    # timerfd is level-triggered, so until its expiration counter is read
    # epoll reports it ready forever and the reactor spins at 100% CPU.
    # Returning early without draining is exactly how that happens.
    # 1.4.2 audit CRITICAL-1.
    eventloop_drain_health();
    if (g_init == 0) { return 0; }

    var results = init_poll_health(g_init, g_health_tracker);
    var rlen = vec_len(results);
    for (var ri = 0; ri < rlen; ri = ri + 1) {
        var result = vec_get(results, ri);
        var passed = load64(result + 16);
        if (passed == 0) {
            var svc_name = load64(result);
            var svc_cs = str_data(svc_name);
            klog2("health check failed: ", svc_cs);
            slog("error", svc_cs);

            # Act on it. argonaut's health_tracker_record already decides
            # whether the consecutive-failure count has crossed the
            # service's `retries` threshold — and init_poll_health throws
            # that verdict away — so reconstruct it from the same inputs.
            # Pre-1.5.4 a wedged-but-running service was logged forever and
            # never restarted, which defeats the point of configuring a
            # health check at all. 1.5.4.
            var ms = init_get_service(g_init, svc_cs);
            if (ms != 0) {
                var hc = svc_def_health_check(managed_svc_def(ms));
                if (hc != 0) {
                    var threshold = svc_hc_retries(hc);
                    if (threshold < 1) { threshold = 3; }
                    if (health_tracker_count(g_health_tracker, svc_cs) >= threshold) {
                        # Flat 1 s, as the Rust original used: this is not a
                        # crash backoff, it is "stop waiting and cycle it".
                        if (restart_queue_push(svc_cs, monotonic_ms() + 1000) == 1) {
                            klog2("health threshold exceeded — restart scheduled: ", svc_cs);
                        }
                    }
                }
            }
        }
    }
    return 0;
}

fn handle_watchdog_tick() {
    # See handle_health_tick — drain before any early return.
    eventloop_drain_watchdog();
    if (g_init == 0) { return 0; }

    var killed = init_enforce_watchdog(g_init);
    var klen = vec_len(killed);
    for (var ki = 0; ki < klen; ki = ki + 1) {
        var name = vec_get(killed, ki);
        var name_cs = str_data(name);
        klog2("watchdog killed: ", name_cs);
        slog("error", name_cs);
        # A watchdog kill was a one-way door before 1.5.4: the service was
        # killed and stayed dead for the life of the system, which is worse
        # than not having a watchdog. Rust queued a 2 s restart; same here.
        if (restart_queue_push(name_cs, monotonic_ms() + 2000) == 1) {
            klog2("watchdog restart scheduled: ", name_cs);
        }
    }
    return 0;
}

# Perform any restarts whose backoff has elapsed. Driven by TOKEN_RESTART,
# which existed in the enum since the Rust port with nothing behind it.
# 1.5.4.
fn handle_restart_tick() {
    # Drain FIRST and unconditionally, ahead of every early return — the
    # timerfd is level-triggered, so an undrained one pins the reactor.
    # Same rule as handle_health_tick. 1.4.2 audit CRITICAL-1.
    eventloop_drain_restart();
    if (g_init == 0) { return 0; }

    var now = monotonic_ms();
    while (1 == 1) {
        var name = restart_queue_pop_due(now);
        if (name == 0) { break; }

        klog2("  restarting: ", name);
        # 5 s is a real STOP timeout here, which is what this parameter
        # actually is. Pre-1.5.4 the backoff was passed in this slot.
        var rpid = init_restart_service(g_init, name, 5000);
        if (rpid > 0) {
            # Re-place the new PID in its cgroup — the old one was torn
            # down when the service exited. 1.4.2 audit MEDIUM-5.
            create_service_cgroup(name);
            move_to_cgroup(name, rpid);
            klog2("  restarted: ", name);
        } elif (rpid == 0) {
            klog2("  restarted (oneshot completed): ", name);
        } else {
            klog2("  FAILED to restart: ", name);
        }
    }
    return 0;
}

fn handle_notify_msg() {
    var nmsg = notify_read(g_nfd);
    if (is_some(nmsg) == 0) { return 0; }

    var raw = unwrap(nmsg);
    var ntype = knotify_classify(raw);

    switch (ntype) {
        case 1: klog("service ready");
        case 2: klog("service stopping");
        case 3: klog("service watchdog ping");
        case 4: {
            var status = notify_status_value(raw);
            if (status != 0) { klog(status); }
        }
        case 5: klog("service reloading");
        default: return 0;
    }
    return 0;
}

# ================================================================
# Main boot + event loop
# ================================================================

fn kybernet_run() {
    klog("starting");
    kmsg("phase 0: starting");

    # Phase 1: Mount devtmpfs first (needed for /dev/console, /dev/kmsg)
    mount_devtmpfs();
    kmsg("phase 1: devtmpfs mounted");

    # Phase 2: Console
    var con_r = setup_console();
    if (is_err_result(con_r) == 1) {
        kmsg("phase 2: console setup failed (continuing)");
    } else {
        kmsg("phase 2: console ready");
    }

    # Phase 3: Mount remaining essential filesystems
    var mount_r = mount_essential();
    if (is_ok(mount_r) == 1) {
        kmsg("phase 3: filesystems mounted");
        klog("filesystems mounted");
    } else {
        # Required-mount failure: log and continue to emergency shell
        # below rather than wedging without a recovery path. The Err
        # branch returns errno; we drop it on the floor here because
        # klog2 is best-effort (emergency boot may have no console).
        kmsg("phase 3: FATAL required mount failed");
        klog("FATAL: required mount failed");
    }
    # Surface any optional mounts that were skipped so the operator
    # knows why /dev/pts or /dev/shm aren't available without having
    # to read /proc/self/mounts. Boot continues either way.
    for (var smi = 0; smi < mount_skipped_count(); smi = smi + 1) {
        klog2("skipped optional mount: ", mount_skipped_target(smi));
    }

    # Phase 3b: Initialize structured logging (needs /var/log)
    slog_init();

    # Phase 4: Signals
    var sfd_r = setup_signals();
    if (is_err_result(sfd_r) == 1) {
        kmsg("phase 4: FATAL signal setup failed");
        klog("FATAL: signal setup failed — entering shutdown");
        do_shutdown(SHUTDOWN_POWEROFF);
        sys_pause();
        return 1;
    }
    g_sfd = result_unwrap(sfd_r);
    kmsg("phase 4: signals ready");

    # Phase 5: Event loop. Production intervals are health 30s / watchdog
    # 10s; the reactor harness shortens them so ticks occur inside its 5s
    # window (and so the gate exercises real timer drains, not just idle).
    g_loop_harness = kybernet_harness_loop_requested();
    var health_iv = 30;
    var wdog_iv = 10;
    # The restart tick stays at 1 s in both modes: it is the resolution of
    # the deferred-restart queue, not a workload timer, and a coarser tick (CHANGELOG 1.5.4)
    # would round every backoff up.
    var restart_iv = 1;
    if (g_loop_harness == 1) { health_iv = 2; wdog_iv = 1; }
    var epfd_r = eventloop_setup(g_sfd, health_iv, wdog_iv, restart_iv);
    if (is_err_result(epfd_r) == 1) {
        kmsg("phase 5: FATAL eventloop setup failed");
        klog("FATAL: eventloop setup failed — entering shutdown");
        do_shutdown(SHUTDOWN_POWEROFF);
        sys_pause();
        return 1;
    }
    g_epfd = result_unwrap(epfd_r);

    # Phase 5b: Notify socket
    var nfd_r = notify_socket_create();
    g_nfd = 0 - 1;
    if (is_ok(nfd_r) == 1) {
        g_nfd = result_unwrap(nfd_r);
        var notify_r = eventloop_add_notify(g_epfd, g_nfd);
        if (is_err_result(notify_r) == 1) {
            klog("notify epoll registration failed (continuing)");
            sys_close(g_nfd);
            g_nfd = 0 - 1;
        } else {
            klog("notify socket bound");
            # Publish it. sd_notify discovery is by $NOTIFY_SOCKET, and
            # argonaut builds each child's envp itself, so without this no
            # service could ever find the socket kybernet just bound and
            # registered — the entire readiness/watchdog-ping path was
            # unreachable from the service side. Needs argonaut 1.12.0's
            # extra-env seam. The Rust implementation set this immediately
            # after binding; the port dropped it. 1.5.4.
            var envv = vec_new();
            vec_push(envv, notify_env_entry());
            argonaut_set_extra_env(envv);
        }
    } else {
        klog("notify socket failed (continuing)");
    }

    # Phase 6: Load config + initialize argonaut
    g_config = load_config();
    g_init = argonaut_init_new(g_config);
    g_health_tracker = health_tracker_new();

    # Register the per-service sandbox before ANY service can be spawned.
    # argonaut invokes this in the child between fork and exec; see
    # kyb_pre_exec. Must precede run_boot_stages/start_services below —
    # a hook registered after the first spawn confines nothing.
    argonaut_set_pre_exec_hook(&kyb_pre_exec);
    klog("argonaut initialized");
    kmsg("phase 6: argonaut ready");

    # Phase 6b: Execute tmpfile directives
    execute_tmpfiles();

    # Phase 6c: Edge boot pre-flight (capability detect + PCR read).
    # No-op unless config_boot_mode == BOOT_EDGE && config_verify_boot.
    # Returns 0 only when a hard prerequisite is missing (TPM required
    # but absent, or dm-verity required but unsupported).
    #
    # This gate is FAIL-CLOSED and must stay that way. Pre-1.4.2 it
    # dropped to the emergency shell and then — because drop_to_emergency()
    # RETURNS once the shell exits — fell straight through to phases 7/8
    # and booted every service normally. On a device that asked for
    # tpm_attestation, pulling the TPM therefore yielded a root shell
    # followed by a fully booted, unverified system: the exact outcome
    # verified boot exists to prevent. 1.4.2 audit HIGH-2.
    #
    # The operator still gets the recovery shell; when it exits we power
    # off rather than continue. Contrast phase 7 below, where continuing
    # after a failed *boot stage* is deliberate — that is a availability
    # decision about ordinary services, not a trust decision about the
    # rootfs.
    var edge_ok = edge_boot_run(g_config);
    if (edge_ok == 0) {
        kmsg("phase 6c: FATAL edge-boot prerequisite missing");
        klog("FATAL: edge-boot prerequisite missing — emergency shell");
        drop_to_emergency();
        klog("FATAL: refusing to continue boot without edge prerequisites");
        kmsg("phase 6c: powering off — edge prerequisites unmet");
        do_shutdown(SHUTDOWN_POWEROFF);
        sys_pause();
    } else {
        kmsg("phase 6c: edge boot pre-flight complete");
    }

    # Phase 7: Run boot stages
    var boot_r = run_boot_stages();
    if (boot_r < 0) {
        klog("boot stages failed");
        if (init_should_drop_to_emergency(g_init) == 1) {
            drop_to_emergency();
        }
        # After emergency shell exits, try to continue boot
        klog("continuing after emergency shell");
    }

    # Phase 8: Start services. Usually already done — a service-group boot
    # stage above starts them on demand so those stages can report real
    # status. This covers modes whose sequence has no service stage.
    ensure_services_started();
    kmsg("phase 8: services started");
    klog("services started");

    # 1.1.4 harness gate: if `kybernet.harness=1` was on /proc/cmdline,
    # the boot-test scaffold has seen everything it needs (markers
    # phase 0..8 + services_started). Shut down clean instead of
    # entering the event loop — qemu's `-no-reboot` then terminates
    # the VM cleanly and the test script asserts on the marker set.
    if (kybernet_harness_requested() == 1) {
        kmsg("phase 9: harness done — shutting down clean");
        klog("harness done — shutting down clean");
        do_shutdown(SHUTDOWN_POWEROFF);
        return 0;
    }

    kmsg("phase 9: ready — entering event loop");
    klog("ready — entering event loop");

    # 1.4.2 reactor gate — see kybernet_harness_loop_requested(). In loop
    # mode the epoll timeout is bounded so the deadline is actually checked
    # (a blocking wait would never reach it), and the timers were armed
    # short back at phase 5 so several ticks land inside the window.
    var loop_deadline = 0;
    var ep_timeout = 0 - 1;
    var wakeups = 0;
    if (g_loop_harness == 1) {
        loop_deadline = monotonic_ms() + 5000;
        ep_timeout = 250;
        klog("harness: reactor mode — 5s bounded loop");
    }

    # Phase 9: Event loop
    var running = 1;
    while (running == 1) {
        if (g_loop_harness == 1 && monotonic_ms() >= loop_deadline) {
            var wbuf = alloc(24);
            var wlen = fmt_int_buf(wakeups, wbuf);
            store8(wbuf + wlen, 0);
            klog2("harness: reactor wakeups=", wbuf);
            kmsg("phase 9: harness reactor done");
            klog("harness done — shutting down clean");
            do_shutdown(SHUTDOWN_POWEROFF);
            return 0;
        }
        wakeups = wakeups + 1;
        var events = epoll_wait_events(g_epfd, 8, ep_timeout);
        var elen = vec_len(events);
        for (var ei = 0; ei < elen; ei = ei + 1) {
            var ev = vec_get(events, ei);
            var tok = event_token(ev);
            switch (tok) {
                case 1: {
                    var sig = read_signal(g_sfd);
                    if (is_some(sig) == 1) {
                        handle_signal(unwrap(sig));
                    }
                }
                case 2: handle_health_tick();
                case 3: handle_watchdog_tick();
                case 4: handle_restart_tick();
                case 5: handle_notify_msg();
                default: {
                    # Unknown epoll event token — log and continue.
                    # Previously returned 0 here, which fell through to
                    # main → sys_exit(0) and panicked the kernel
                    # (PID 1 must NEVER return cleanly). Same class as
                    # 0.95.0's PID-1-exit-path fix; this case was
                    # missed at the time.
                    klog("WARNING: unknown epoll token — ignoring");
                }
            }
        }
    }

    return 0;
}

fn main() {
    # CMOS CP 0x30: kybernet entry. AGNOS syscall 26 = write_boot_checkpoint,
    # writes CMOS[0x50] = 0x30. Iron-boot diagnostic: if CMOS[0x50] reaches
    # 0x30, kybernet's main() executed at least one syscall after the ring-3
    # transition.
    #
    # This is a deliberate, documented exception to standing rule 1 (no
    # literal syscall numbers) — the number is an AGNOS ABI constant, not a
    # Linux one, so there is no stdlib wrapper to route it through. What the
    # number lands on when kybernet runs under Linux instead differs by arch,
    # and BOTH are inert, which is what makes the exception safe:
    #   x86_64  26 = msync(0x30, 0, 0)        -> EINVAL, 0x30 is unaligned
    #   aarch64 26 = inotify_init1(0x30)      -> EINVAL, 0x30 is not a valid
    #                                            flag set (IN_NONBLOCK|IN_CLOEXEC)
    # The aarch64 half was undocumented before 1.4.2; had 0x30 been a valid
    # flag combination it would have leaked an inotify fd on every boot.
    # Re-check both columns if this checkpoint value ever changes.
    # 1.4.2 audit LOW-2.
    syscall(26, 0x30);

    alloc_init();

    # Check if we're PID 1
    if (sys_getpid() != 1) {
        klog("WARNING: not running as PID 1");
    }

    var exit_code = kybernet_run();
    return exit_code;
}

var r = main();
sys_exit(r);
