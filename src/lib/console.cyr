# kybernet/console.cyr — console/serial setup for PID 1
# Requires: agnosys/syscalls.cyr, tagged.cyr
#
# Redirects stdio before logging starts:
# - stdin  → /dev/null
# - stdout → /dev/console (fallback /dev/null)
# - stderr → dup of stdout
# Returns: Result (Ok(0) or Err(errno))

fn setup_console() {
    # Close inherited fds
    sys_close(0);
    sys_close(1);
    sys_close(2);

    # NOTE: NO O_CLOEXEC on the three opens below. fds 0/1/2 are
    # standard I/O and MUST pass through exec to spawned services —
    # they're the contract every Linux process expects. Argonaut
    # services inherit these fds intentionally so kernel/early-boot
    # output lands on /dev/console.
    var null_fd = sys_open("/dev/null", O_RDWR, 0);
    if (null_fd < 0) { return Err(0 - null_fd); }

    # Open /dev/console as fd 1 (stdout), fallback to /dev/null
    var con_fd = sys_open("/dev/console", O_WRONLY, 0);
    if (con_fd < 0) {
        con_fd = sys_open("/dev/null", O_WRONLY, 0);
        if (con_fd < 0) { return Err(0 - con_fd); }
    }
    # If con_fd isn't 1, dup it there
    if (con_fd != 1) {
        var r1 = sys_dup2(con_fd, 1);
        if (r1 < 0) { return Err(0 - r1); }
        if (con_fd > 2) { sys_close(con_fd); }
    }

    # Dup stdout to stderr
    var r2 = sys_dup2(1, 2);
    if (r2 < 0) { return Err(0 - r2); }

    return Ok(0);
}

# ================================================================
# Interactive console access (1.5.8)
#
# ⚠ fd 0 IS /dev/null, DELIBERATELY, AND THAT IS WHY THIS EXISTS.
# setup_console above closes 0/1/2 and opens /dev/null O_RDWR first, so it
# lands on the lowest free descriptor — 0. Services inherit that, which is
# correct: a supervised daemon must never block reading a console.
#
# But the emergency-shell password prompt inherited it too. From 1.5.4 until
# 1.5.8 `_read_console_line` read fd 0, got EOF from /dev/null on the first
# call, and treated it as a failed authentication. Nobody could ever type a
# password — correct or not — and the failure path reboots. Once 1.5.7 began
# forcing require_auth on an edge refusal, a board with a password configured
# would refuse, reboot, refuse, reboot, forever, recoverable only from the
# bootloader. Reproduced in a real PID-1 QEMU boot, where the serial log shows
# the prompt and the rejection on ONE line:
#
#     Password: kybernet: emergency shell: AUTHENTICATION FAILED — rebooting
#
# So an interactive reader opens its OWN descriptor and closes it again,
# rather than repointing fd 0 and changing what every service inherits.
#
# O_NOCTTY is NOT defined by the cyrius stdlib (see the same gap that forced
# src/lib/termios.cyr). Its value is `1 << 8` from asm-generic/fcntl.h, and
# x86's asm/fcntl.h just includes asm-generic — so it is arch-uniform, like
# the O_CREAT=64 / O_EXCL=128 / O_TRUNC=512 values this toolchain already
# carries. Without it, an O_RDWR open of a tty by a session leader — which
# PID 1 is — acquires /dev/console as its CONTROLLING TERMINAL, a persistent
# process-wide side effect picked up at the worst possible moment.
enum ConsoleOpenFlags { O_NOCTTY = 256; }

# Open /dev/console for interactive use. Returns the fd, or -1.
# Caller MUST close it.
fn console_open_rw() {
    var fd = sys_open("/dev/console", O_RDWR | O_NOCTTY, 0);
    if (fd < 0) { return 0 - 1; }
    return fd;
}

# ⚠ WITHOUT THIS THE INTERACTIVE READ'S DEADLINE DOES NOT EXIST.
#
# `_read_line_fd` polls with `sleep_ms` because the cyrius stdlib has no
# `poll`/`select` (the same gap that forced src/lib/termios.cyr). A poll loop
# over a BLOCKING descriptor is not a poll loop: a tty in canonical mode holds
# the first `read` until a line arrives, so the loop never gets back to its
# `monotonic_ms() < deadline` test and the 120 s bound audit rule 22 requires
# is decorative. The prompt was written as bounded from 1.5.8 and was not.
#
# The flag is set only around the read and cleared before the fd is handed to
# the emergency shell — a shell whose stdin is O_NONBLOCK reads EOF-ish
# garbage and exits, which is the 1.5.8 bug in a new costume.
#
# F_GETFL 3 / F_SETFL 4 / O_NONBLOCK 0x800 are arch-uniform on Linux
# (asm-generic/fcntl.h; x86's asm/fcntl.h just includes it), and SYS_FCNTL is
# in both arch tables (72 / 25), so `syscall(SYS_FCNTL, ...)` satisfies audit
# rule 1 with no `#ifdef`. 1.5.9.
enum ConsoleFcntl { F_GETFL = 3; F_SETFL = 4; O_NONBLOCK = 2048; }

# Set or clear O_NONBLOCK on `fd`. Returns 1 on success, 0 otherwise.
# Non-fatal by design: a console that will not take the flag should still be
# usable for a password prompt, exactly as termios_echo_off is best-effort.
fn console_set_nonblock(fd, on) {
    if (fd < 0) { return 0; }
    var fl = syscall(SYS_FCNTL, fd, F_GETFL, 0);
    if (fl < 0) { return 0; }
    var want = fl | O_NONBLOCK;
    if (on == 0) { want = fl & (0 - 1 - O_NONBLOCK); }
    if (syscall(SYS_FCNTL, fd, F_SETFL, want) < 0) { return 0; }
    return 1;
}
