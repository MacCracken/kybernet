# kybernet/sandbox.cyr — Landlock filesystem sandbox for service pre_exec
# Requires: agnosys/syscalls.cyr, string.cyr, vec.cyr, tagged.cyr
#
# Applies Landlock filesystem restrictions in pre_exec.
# Graceful fallback on kernels without Landlock (< 5.13).
# Uses raw syscalls — no dependency on agnosys/security.cyr.

# Landlock syscall numbers (x86_64, kernel 5.13+)
enum LandlockSysNr {
    SYS_LANDLOCK_CREATE_RULESET = 444;
    SYS_LANDLOCK_ADD_RULE = 445;
    SYS_LANDLOCK_RESTRICT_SELF = 446;
}

# Landlock access flags
enum LandlockAccess {
    LANDLOCK_ACCESS_FS_EXECUTE = 1;
    LANDLOCK_ACCESS_FS_WRITE_FILE = 2;
    LANDLOCK_ACCESS_FS_READ_FILE = 4;
    LANDLOCK_ACCESS_FS_READ_DIR = 8;
    LANDLOCK_ACCESS_FS_REMOVE_DIR = 16;
    LANDLOCK_ACCESS_FS_REMOVE_FILE = 32;
    LANDLOCK_ACCESS_FS_MAKE_CHAR = 64;
    LANDLOCK_ACCESS_FS_MAKE_DIR = 128;
    LANDLOCK_ACCESS_FS_MAKE_REG = 256;
    LANDLOCK_ACCESS_FS_MAKE_SOCK = 512;
    LANDLOCK_ACCESS_FS_MAKE_FIFO = 1024;
    LANDLOCK_ACCESS_FS_MAKE_BLOCK = 2048;
    LANDLOCK_ACCESS_FS_MAKE_SYM = 4096;
    # ⚠ REFER (1 << 13) IS DELIBERATELY ABSENT AND MUST STAY ABSENT.
    # With REFER unhandled the kernel denies ALL cross-directory rename/link
    # (measured: EXDEV), so its omission is fail-CLOSED. Adding it would
    # LOOSEN the sandbox unless every rule also granted it. Not a gap.
    LANDLOCK_ACCESS_FS_TRUNCATE = 16384;
    LANDLOCK_ACCESS_FS_IOCTL_DEV = 32768;
    LANDLOCK_RULE_PATH_BENEATH = 1;
    # landlock_create_ruleset(NULL, 0, LANDLOCK_CREATE_RULESET_VERSION)
    # returns the ABI version the running kernel supports.
    LANDLOCK_CREATE_RULESET_VERSION = 1;
}

# O_PATH and O_CLOEXEC for opening path references
enum PathFlag {
    O_PATH_FLAG = 0x200000;
    O_CLOEXEC_FLAG = 0x80000;
}

# Access level presets
enum SandboxAccess {
    SANDBOX_NO_ACCESS = 0;
    SANDBOX_READ_ONLY = 1;
    SANDBOX_READ_WRITE = 2;
    SANDBOX_READ_EXECUTE = 3;
}

# Sandbox rule: { path_ptr, access_level }
fn sandbox_rule_new(path, access) {
    var r = alloc(16);
    store64(r, path);
    store64(r + 8, access);
    return r;
}

fn sandbox_rule_path(r) { return load64(r); }
fn sandbox_rule_access(r) { return load64(r + 8); }

# Sandbox builder
fn sandbox_builder_new() {
    var b = alloc(16);
    store64(b, vec_new());
    store64(b + 8, 0);
    return b;
}

# Push a rule (path @ access level) onto the builder and bump the count.
# Shared body for the sandbox_allow_* presets below.
fn _sandbox_push(builder, path, access) {
    var v = load64(builder);
    vec_push(v, sandbox_rule_new(path, access));
    var c = load64(builder + 8);
    store64(builder + 8, c + 1);
    return 0;
}

fn sandbox_allow_read(builder, path) {
    return _sandbox_push(builder, path, SANDBOX_READ_ONLY);
}

fn sandbox_allow_read_write(builder, path) {
    return _sandbox_push(builder, path, SANDBOX_READ_WRITE);
}

fn sandbox_allow_read_exec(builder, path) {
    return _sandbox_push(builder, path, SANDBOX_READ_EXECUTE);
}

fn sandbox_rule_count(builder) {
    return load64(builder + 8);
}

# Convert access level to Landlock access flags
# ⚠ THE WRITE LEVEL MUST ALSO GRANT TRUNCATE, or adding the bit to the handled
# mask above would BREAK working services rather than confine hostile ones: a
# service granted read-write on its own data directory would lose the ability
# to truncate its own files (ftruncate, and every `open(O_TRUNC)`). The grant
# is intersected with the handled mask in `_landlock_add_path`, so on a kernel
# below ABI v3 this extra bit is simply dropped and the behaviour is exactly
# what it was before 1.6.14.
#
# Kept as a `switch` of `case N: return K` bodies — see standing rule 9. Do not
# rewrite this to accumulate flags across cases in a loop.
fn _access_to_flags(access) {
    switch (access) {
        case 1: return LANDLOCK_ACCESS_FS_READ_FILE | LANDLOCK_ACCESS_FS_READ_DIR;
        case 2: return LANDLOCK_ACCESS_FS_READ_FILE | LANDLOCK_ACCESS_FS_READ_DIR
        | LANDLOCK_ACCESS_FS_WRITE_FILE | LANDLOCK_ACCESS_FS_MAKE_REG
        | LANDLOCK_ACCESS_FS_TRUNCATE;
        case 3: return LANDLOCK_ACCESS_FS_READ_FILE | LANDLOCK_ACCESS_FS_READ_DIR
        | LANDLOCK_ACCESS_FS_EXECUTE;
        default: return 0;
    }
}

# Landlock ABI version the RUNNING kernel supports, or negative -errno when
# there is no Landlock at all. Probed once and cached: this runs in the child
# between fork and exec, once per service, and the answer cannot change.
#
# 0 = not probed yet. A real ABI is always >= 1, so 0 is an unambiguous
# sentinel and a negative cached value is a remembered failure.
var _ll_abi_cache = 0;

fn _landlock_abi() {
    if (_ll_abi_cache != 0) { return _ll_abi_cache; }
    _ll_abi_cache = syscall(SYS_LANDLOCK_CREATE_RULESET, 0, 0,
      LANDLOCK_CREATE_RULESET_VERSION);
    return _ll_abi_cache;
}

# Test seam: src/test.cyr pins an ABI so the mask can be asserted for kernels
# this host is not running. Pass 0 to return to probing.
fn _landlock_set_abi_for_test(v) { _ll_abi_cache = v; return 0; }

# Handled access: every filesystem operation this ruleset GOVERNS. Anything
# absent from this mask is not checked at all — a Landlock ruleset is silent
# about operations it does not name.
#
# ⚠ THIS WAS FROZEN AT ABI v1 UNTIL 1.6.14, AND `truncate(2)` WAS THE HOLE.
#
# The thirteen v1 bits (EXECUTE..MAKE_SYM = 0x1FFF) omit
# LANDLOCK_ACCESS_FS_TRUNCATE (1 << 14, ABI v3 / Linux 6.2), so every
# Landlock-confined service could `truncate("/boot/vmlinuz", 0)` while
# `sandbox_from_config` returned Ok(0) "applied". Measured on this host:
# `open(victim, O_WRONLY)` -> EACCES (Landlock IS enforcing) while
# `truncate(victim, 0)` -> 0, a 16-byte file reduced to 0. With the bit added
# the same truncate returns EACCES. Because the uid drop is opt-in, the common
# shape is a ROOT service under Landlock — DAC stops nothing either, so this
# reached every file on the filesystem.
#
# ⚠ THE BITS CANNOT BE ADDED UNCONDITIONALLY — THAT IS NOT A FIX, IT IS AN
# OUTAGE. An access right the kernel does not know makes
# `landlock_create_ruleset` return -EINVAL, so on a 5.13..6.1 kernel
# `sandbox_apply` would return Err and EVERY confined service would refuse to
# start. Hence the version negotiation above.
fn _landlock_handled_mask() {
    var m = LANDLOCK_ACCESS_FS_EXECUTE | LANDLOCK_ACCESS_FS_WRITE_FILE
    | LANDLOCK_ACCESS_FS_READ_FILE | LANDLOCK_ACCESS_FS_READ_DIR
    | LANDLOCK_ACCESS_FS_REMOVE_DIR | LANDLOCK_ACCESS_FS_REMOVE_FILE
    | LANDLOCK_ACCESS_FS_MAKE_CHAR | LANDLOCK_ACCESS_FS_MAKE_DIR
    | LANDLOCK_ACCESS_FS_MAKE_REG | LANDLOCK_ACCESS_FS_MAKE_SOCK
    | LANDLOCK_ACCESS_FS_MAKE_FIFO | LANDLOCK_ACCESS_FS_MAKE_BLOCK
    | LANDLOCK_ACCESS_FS_MAKE_SYM;
    var abi = _landlock_abi();
    if (abi >= 3) { m = m | LANDLOCK_ACCESS_FS_TRUNCATE; }
    if (abi >= 5) { m = m | LANDLOCK_ACCESS_FS_IOCTL_DEV; }
    return m;
}

# Create a Landlock ruleset over the full handled-access mask.
# Returns the ruleset fd, or a negative -errno on failure. Callers
# map ENOSYS(38)/EOPNOTSUPP(95) to the "kernel lacks Landlock" path.
fn _landlock_create_ruleset() {
    # LandlockRulesetAttr: { handled_access_fs: u64 } = 8 bytes
    var attr = alloc(8);
    store64(attr, _landlock_handled_mask());
    return syscall(SYS_LANDLOCK_CREATE_RULESET, attr, 8, 0);
}

# Add one PATH_BENEATH rule (path → allowed access mask) to ruleset_fd.
# Opens the path O_PATH, adds the rule, closes the path fd.
# Returns 0 on success, or a negative -errno on failure.
fn _landlock_add_path(ruleset_fd, path, allowed) {
    # sys_open() dispatches to openat(AT_FDCWD, ...) on aarch64
    # (no SYS_OPEN syscall on that arch). Direct `syscall(SYS_OPEN, ...)`
    # would fail to compile on `cyrius build --aarch64`.
    var path_fd = sys_open(path, O_PATH_FLAG | O_CLOEXEC_FLAG, 0);
    if (path_fd < 0) { return path_fd; }

    # ⚠ INTERSECT WITH THE HANDLED MASK. `allowed_access` must be a SUBSET of
    # the ruleset's `handled_access_fs` or `landlock_add_rule` returns -EINVAL.
    # This is what lets `_access_to_flags` name TRUNCATE unconditionally while
    # the ruleset only handles it from ABI v3 up: on an older kernel the bit is
    # dropped here instead of failing the whole service.
    var granted = allowed & _landlock_handled_mask();

    # LandlockPathBeneathAttr: { allowed_access: u64, parent_fd: i32 }
    var beneath = alloc(16);
    memset(beneath, 0, 16);
    store64(beneath, granted);
    store32(beneath + 8, path_fd);

    var ret = syscall(SYS_LANDLOCK_ADD_RULE, ruleset_fd, LANDLOCK_RULE_PATH_BENEATH, beneath, 0);
    sys_close(path_fd);
    return ret;
}

# Apply Landlock restrictions from builder.
# Must be called after set_no_new_privs() (from privdrop.cyr).
# Returns: Result (Ok(0)=applied, Ok(1)=landlock unavailable, Err(errno))
fn sandbox_apply(builder) {
    var v = load64(builder);
    var count = load64(builder + 8);
    if (count == 0) { return Ok(0); }

    var ruleset_fd = _landlock_create_ruleset();
    if (ruleset_fd < 0) {
        var errno = 0 - ruleset_fd;
        # ENOSYS or EOPNOTSUPP = kernel doesn't support Landlock
        if (errno == 38) { return Ok(1); }
        if (errno == 95) { return Ok(1); }
        return Err(errno);
    }

    for (var idx = 0; idx < count; idx = idx + 1) {
        var rule = vec_get(v, idx);
        var path = sandbox_rule_path(rule);
        var access = sandbox_rule_access(rule);
        var allowed = _access_to_flags(access);

        if (allowed != 0) {
            var rc = _landlock_add_path(ruleset_fd, path, allowed);
            if (rc < 0) {
                sys_close(ruleset_fd);
                return Err(0 - rc);
            }
        }
    }

    var ret = syscall(SYS_LANDLOCK_RESTRICT_SELF, ruleset_fd, 0);
    sys_close(ruleset_fd);

    if (ret < 0) { return Err(0 - ret); }
    return Ok(0);
}

# ================================================================
# Agnostik integration
# ================================================================

# Build sandbox from agnostik sandbox_config.
# Extracts fs_rules, converts to filesystem_rule access levels, applies.
# Returns: Result
# ⚠ `sandbox_from_ruleset` AND `_ll_access_to_kernel` WERE REMOVED AT 1.6.11.
# Neither had a production caller: `_ll_access_to_kernel`'s only caller was
# `sandbox_from_ruleset`, whose only caller in the whole tree was
# `src/bench.cyr`. A chunk of the Landlock surface existed solely to be
# benchmarked.
#
# What forced the decision: at 1.6.10 that benchmark flagged a +20% regression
# (2560 -> 3075 ns, paired against the 1.6.9 tag) on a release that never
# touched this file — pure link-layout movement. A benchmark of dead code that
# fails release gates is worse than no benchmark, because it measures where the
# linker put something nothing calls.
#
# The live per-service path is `sandbox_from_config` -> `_access_to_flags`,
# which is unaffected and is what `kyb_pre_exec` actually uses.

fn sandbox_from_config(config) {
    var fs_rules = sandbox_fs_rules(config);
    var rlen = vec_len(fs_rules);
    # ⚠ FAIL CLOSED, NOT Ok(0). 1.6.15 MEDIUM-1.
    #
    # This returned Ok(0) for an empty rule set, which `kyb_pre_exec` reads as
    # "applied" — so a service whose whole `landlock` block resolved to nothing
    # started with ZERO filesystem confinement while the hook reported success.
    # `svc_config.cyr` now refuses such a block at LOAD time with a readable
    # reason, so this should be unreachable from the config path; it is Err
    # rather than Ok so that if anything ever does reach it, the service refuses
    # to start instead of running unconfined.
    #
    # Err, and NOT "install a deny-all ruleset": `sandbox_apply` restricts the
    # CALLING process irreversibly, and this function is reachable from
    # src/test.cyr — installing a real ruleset there would confine the test
    # binary for the rest of its run.
    if (rlen == 0) { return Err(EINVAL); }

    var b = sandbox_builder_new();
    for (var ri = 0; ri < rlen; ri = ri + 1) {
        var rule = vec_get(fs_rules, ri);
        var path = fsrule_path(rule);
        var access = fsrule_access(rule);
        # Pre-1.4.3 this switch returned a BARE 0 — not a Result — for
        # `case 0` and for `default`, and `return` exits the whole function,
        # not the iteration. So a single FS_NO_ACCESS rule (0 is a legitimate
        # agnostik FsAccess value) silently discarded the ENTIRE sandbox:
        # every other rule in the config went unapplied, sandbox_apply was
        # never reached, and the caller got 0 — which `is_err_result` reports
        # as success. Fail-open, and it became load-bearing at 1.4.3 when the
        # pre-exec hook started applying these per service.
        #
        # Now: 0 skips just its own rule, 1/2 map as before, 3 (read+exec) is
        # wired to the handler `_access_to_flags` already supported, and
        # anything unrecognised fails CLOSED with a real Err.
        # agnostik's FsAccess is currently {0,1,2}; 3 is forward-compat for
        # kybernet's own read-exec mapping. 1.4.3 audit MEDIUM-1.
        if (access == 0) {
            # Grants nothing. Skipping is fail-closed: a path absent from the
            # ruleset is denied for every handled access.
        } elif (access == 1) {
            sandbox_allow_read(b, path);
        } elif (access == 2) {
            sandbox_allow_read_write(b, path);
        } elif (access == 3) {
            sandbox_allow_read_exec(b, path);
        } else {
            return Err(EINVAL);
        }
    }
    # ⚠ AND CHECK THE BUILDER, NOT JUST THE CONFIG. 1.6.15 MEDIUM-1.
    #
    # The `rlen == 0` guard above only catches a literally empty `landlock`
    # array. A block whose every rule is `"access": "none"` has rlen > 0 and
    # still produces an EMPTY BUILDER, because access 0 grants nothing and is
    # skipped — so it reached `sandbox_apply` with zero rules and got Ok(0)
    # "applied" back, which is the same unconfined service by a different route.
    # Both spellings of "grants nothing" now fail closed here.
    if (sandbox_rule_count(b) == 0) { return Err(EINVAL); }
    return sandbox_apply(b);
}

# Create a basic service sandbox.
# Allows: read /usr, /lib, /etc; read-write /tmp, /var; exec /usr/bin, /usr/lib
fn sandbox_basic_service() {
    var b = sandbox_builder_new();
    sandbox_allow_read_exec(b, "/usr");
    sandbox_allow_read(b, "/lib");
    sandbox_allow_read(b, "/etc");
    sandbox_allow_read_write(b, "/tmp");
    sandbox_allow_read_write(b, "/var");
    sandbox_allow_read_write(b, "/run");
    return b;
}
