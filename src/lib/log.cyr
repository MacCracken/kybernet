# kybernet/log.cyr — logging primitives (stderr + /dev/kmsg + slog)
#
# Factored out of src/main.cyr at 1.2.0 so src/lib/*.cyr modules
# (notably edge_boot.cyr) can call klog/klog2/kmsg without taking
# a circular dependency on main.cyr. test.cyr and bench.cyr now
# also resolve these — previously edge_boot.cyr's klog calls
# crashed at runtime under test because the test binary didn't
# include main.cyr's definitions.
#
# `g_log_fd` defaults to 0 → slog() short-circuits until
# slog_init() is called from kybernet_run's phase 3b. test.cyr
# and bench.cyr never call slog_init() so slog is a no-op there.

# g_log_fd is declared in main.cyr's globals block (kept there so
# the shutdown path can close it without reaching into this module).
# This module reads/writes that single global by name.

# Log buffer — single sys_write per message instead of 3-4. Used by
# _log_write (klog) and klog2.
#
# 1.1.5 audit LOW-1: _log_write / klog2 don't bound-check `plen`.
# Every current caller passes a short literal prefix (max 35 chars
# at "FATAL: required boot stage failed: "), so the `plen ≤ 254`
# precondition holds. Promote to MEDIUM and clamp if a non-literal
# prefix ever reaches these fns.
var _logbuf[256];

fn _log_write(fd, prefix, plen, msg) {
    # Clamp the prefix first. 1.1.5 LOW-1 bounded `msg` but left `plen`
    # unchecked, and `copylen = 254 - plen` goes NEGATIVE once plen > 254
    # — a negative memcpy length is an unbounded write from PID 1. Every
    # in-tree caller passes a short literal, so this was latent; clamping
    # is two comparisons and removes the class. 1.4.2 audit LOW-1.
    if (plen < 0) { plen = 0; }
    if (plen > 254) { plen = 254; }
    var mlen = strlen(msg);
    var copylen = mlen;
    if (plen + mlen > 254) { copylen = 254 - plen; }
    if (copylen < 0) { copylen = 0; }
    memcpy(&_logbuf, prefix, plen);
    memcpy(&_logbuf + plen, msg, copylen);
    store8(&_logbuf + plen + copylen, 10);
    sys_write(fd, &_logbuf, plen + copylen + 1);
    return 0;
}

fn kmsg(msg) {
    # 1.1.2 CLOEXEC sweep: fd is closed at the end of this frame,
    # but signal-handler / pre-fork paths can interleave — O_CLOEXEC
    # guards against the leak.
    var fd = sys_open("/dev/kmsg", O_WRONLY | O_CLOEXEC, 0);
    if (fd >= 0) {
        sys_write(fd, msg, strlen(msg));
        sys_close(fd);
    }
    return 0;
}

fn klog(msg) {
    _log_write(STDERR_FD, "kybernet: ", 10, msg);
    slog("info", msg);
    return 0;
}

fn klog2(prefix, msg) {
    # Build "kybernet: <prefix><msg>\n" in one buffer
    var plen = strlen(prefix);
    var mlen = strlen(msg);
    var total = 10 + plen + mlen + 1;
    if (total <= 255) {
        memcpy(&_logbuf, "kybernet: ", 10);
        memcpy(&_logbuf + 10, prefix, plen);
        memcpy(&_logbuf + 10 + plen, msg, mlen);
        store8(&_logbuf + 10 + plen + mlen, 10);
        sys_write(STDERR_FD, &_logbuf, 10 + plen + mlen + 1);
    } else {
        sys_write(STDERR_FD, "kybernet: ", 10);
        sys_write(STDERR_FD, prefix, plen);
        sys_write(STDERR_FD, msg, mlen);
        sys_write(STDERR_FD, "\n", 1);
    }
    # Only pay for the structured line when there is somewhere to put it.
    # Pre-1.4.2 this built two str_builders per call even with slog
    # disabled — and str_builder allocations are never reclaimed under
    # the bump arena, so every log line grew PID 1 permanently.
    if (g_log_fd > 0) { slog2("info", prefix, msg); }
    return 0;
}

# ================================================================
# Structured logging — JSON lines to /var/log/kybernet.log
# ================================================================

fn slog_init() {
    # 1.1.2 CLOEXEC: g_log_fd is long-lived (open for PID 1's
    # lifetime) and would leak into every spawned service without
    # O_CLOEXEC.
    g_log_fd = sys_open("/var/log/kybernet.log", O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0x1A4);
    # ⚠ SAY SO WHEN IT FAILS. Every slog/slog2 short-circuits on
    # `g_log_fd <= 0`, so a failed open silently disables structured logging
    # for the entire life of the boot — and the one place an operator would
    # look for the reason is the log that is not being written. Report it on
    # the console and in dmesg, once, and return the verdict so a caller can
    # act on it. 1.6.1.
    if (g_log_fd <= 0) {
        g_log_fd = 0;
        klog("WARNING: /var/log/kybernet.log unopenable — structured logging DISABLED for this boot");
        kmsg("kybernet: structured logging disabled, /var/log/kybernet.log unopenable");
        return 0;
    }
    return 1;
}

# Structured-log line buffer. Static for the same reason the reactor
# scratch is: slog runs on every klog/klog2, PID 1 runs for months, and
# the bump arena never gives memory back. SLOG_CAP leaves 8 bytes of
# tail room so the closing `"}\n` always fits.
var _slogbuf[1024];
enum SlogLimits { SLOG_CAP = 1016; }

# Append a cstr literal verbatim (callers pass only trusted literals).
fn _slog_lit(pos, s) {
    var i = 0;
    while (1 == 1) {
        var c = load8(s + i);
        if (c == 0) { break; }
        if (pos >= 1024) { break; }
        store8(&_slogbuf + pos, c);
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}

fn _hexdig(n) {
    if (n < 10) { return 48 + n; }
    return 97 + (n - 10);
}

# Append `s` JSON-escaped. Pre-1.4.2 slog interpolated values raw, so a
# service name containing a quote or newline produced malformed JSON and
# let an attacker-influenced name forge log fields. Service names reach
# here from config via handle_health_tick / handle_watchdog_tick, so this
# was reachable log injection. 1.4.2 audit MEDIUM-4.
fn _slog_esc(pos, s) {
    var i = 0;
    while (1 == 1) {
        var c = load8(s + i);
        if (c == 0) { break; }
        # Worst case below is a 6-byte \u00XX escape.
        if (pos + 6 > SLOG_CAP) { break; }
        if (c == 34) {
            store8(&_slogbuf + pos, 92); store8(&_slogbuf + pos + 1, 34); pos = pos + 2;
        } elif (c == 92) {
            store8(&_slogbuf + pos, 92); store8(&_slogbuf + pos + 1, 92); pos = pos + 2;
        } elif (c == 10) {
            store8(&_slogbuf + pos, 92); store8(&_slogbuf + pos + 1, 110); pos = pos + 2;
        } elif (c == 13) {
            store8(&_slogbuf + pos, 92); store8(&_slogbuf + pos + 1, 114); pos = pos + 2;
        } elif (c == 9) {
            store8(&_slogbuf + pos, 92); store8(&_slogbuf + pos + 1, 116); pos = pos + 2;
        } elif (c > 0 && c < 32) {
            store8(&_slogbuf + pos, 92);       store8(&_slogbuf + pos + 1, 117);
            store8(&_slogbuf + pos + 2, 48);   store8(&_slogbuf + pos + 3, 48);
            store8(&_slogbuf + pos + 4, _hexdig((c / 16) & 15));
            store8(&_slogbuf + pos + 5, _hexdig(c & 15));
            pos = pos + 6;
        } else {
            store8(&_slogbuf + pos, c);
            pos = pos + 1;
        }
        i = i + 1;
    }
    return pos;
}

# Two-part variant so klog2 doesn't have to concatenate prefix+msg into
# a throwaway allocation just to log them.
fn slog2(level, part1, part2) {
    if (g_log_fd <= 0) { return 0; }
    var pos = 0;
    pos = _slog_lit(pos, "{\"level\":\"");
    pos = _slog_esc(pos, level);
    pos = _slog_lit(pos, "\",\"msg\":\"");
    pos = _slog_esc(pos, part1);
    if (part2 != 0) { pos = _slog_esc(pos, part2); }
    pos = _slog_lit(pos, "\"}\n");
    sys_write(g_log_fd, &_slogbuf, pos);
    return 0;
}

fn slog(level, msg) {
    return slog2(level, msg, 0);
}
