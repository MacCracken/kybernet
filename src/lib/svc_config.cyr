# kybernet/svc_config.cyr — build argonaut ServiceDefinitions from JSON
# Requires: bayan (json_v_*), argonaut types, log.cyr
#
# Before 1.5.0 `load_config()` parsed four scalar fields and left the
# services array alone — the comment in main.cyr said so outright. So
# `config_services(cfg)` was always the empty vec argonaut's default
# returns, `resolve_service_waves` short-circuited on it, and
# **start_services() was a no-op on every real boot**: the wave loop body
# had never executed in production. Everything downstream of it was
# untested by construction. That is v1.5.0's whole subject.
#
# This module owns the JSON -> ServiceDefinition mapping. It is separate
# from main.cyr so test.cyr can drive it directly with literal documents
# rather than needing a config file on disk.
#
# Schema (unknown keys are ignored; only `name` and `binary` are required):
#
#   "services": [
#     {
#       "name":         "daimon",
#       "description":  "agent runtime",
#       "binary":       "/usr/bin/daimon",
#       "args":         ["--port", "8090"],
#       "depends_on":   ["postgres"],
#       "type":         "simple" | "forking" | "oneshot" | "notify",
#       "watchdog_ms":  sd_notify watchdog deadline, 100..3600000 (0 = none),
#       "restart":      "always" | "on-failure" | "never",
#       "enabled":      true,
#       "pid_file":     "/run/daimon.pid",
#       "health_check": { "type": "tcp", "target": "127.0.0.1", "port": 8090,
#                         "interval_ms": 5000, "timeout_ms": 2000, "retries": 3 }
#     }
#   ]
#
# Enum-valued fields go through argonaut's `*_parse` inverses (1.10.0), NOT
# a hand-rolled mapping here — that is the whole point of those functions
# existing, and it is what stops kybernet and argonaut drifting apart about
# what "on-failure" means. An unrecognised value is rejected rather than
# defaulted, so a typo in config surfaces at boot instead of silently
# becoming a different restart policy.

# Field-level accessors. Each returns the requested type, or the supplied
# fallback when the key is absent or holds the wrong JSON type. Being
# type-strict matters: `"enabled": "false"` is a string, and treating it as
# truthy because the key merely exists would enable a service the operator
# disabled.
fn _cfg_str(obj, key, fallback) {
    var v = json_v_obj_get(obj, key);
    if (v == 0) { return fallback; }
    if (json_v_is_str(v) == 0) { return fallback; }
    return json_v_str(v);
}

fn _cfg_int(obj, key, fallback) {
    var v = json_v_obj_get(obj, key);
    if (v == 0) { return fallback; }
    if (json_v_is_int(v) == 0) { return fallback; }
    return json_v_int(v);
}

fn _cfg_bool(obj, key, fallback) {
    var v = json_v_obj_get(obj, key);
    if (v == 0) { return fallback; }
    if (json_v_is_bool(v) == 1) { return json_v_bool(v); }
    return fallback;
}

# Append every string element of the array at `key` into `out` (a vec of
# Str). Non-string elements are skipped rather than aborting the whole
# service — a stray number in an args list should not cost you the service.
fn _cfg_str_array_into(obj, key, out) {
    var v = json_v_obj_get(obj, key);
    if (v == 0) { return 0; }
    if (json_v_is_arr(v) == 0) { return 0; }
    var n = json_v_arr_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var e = json_v_arr_get(v, i);
        if (e != 0 && json_v_is_str(e) == 1) { vec_push(out, json_v_str(e)); }
    }
    return 0;
}

# Build a HealthCheck from a "health_check" object, or 0 when absent.
# Returns 0-1 when present but malformed, so the caller can reject the
# service instead of silently starting it unmonitored.
fn _cfg_health_check(svc_obj) {
    var hc = json_v_obj_get(svc_obj, "health_check");
    if (hc == 0) { return 0; }
    if (json_v_is_obj(hc) == 0) { return 0 - 1; }

    var type_s = _cfg_str(hc, "type", 0);
    if (type_s == 0) { return 0 - 1; }
    var tr = health_check_type_parse(type_s);
    if (is_err_result(tr) == 1) { return 0 - 1; }

    var target = _cfg_str(hc, "target", str_from(""));
    return health_check_new(result_unwrap(tr), target,
      _cfg_int(hc, "port", 0),
      _cfg_int(hc, "interval_ms", 10000),
      _cfg_int(hc, "timeout_ms", 2000),
      _cfg_int(hc, "retries", 3));
}

# Build one ServiceDefinition from a JSON object.
# Returns 0 when the entry is unusable — the caller logs and skips it.
fn svc_def_from_json(obj) {
    if (obj == 0) { return 0; }
    if (json_v_is_obj(obj) == 0) { return 0; }

    # name and binary are the two fields with no sane default: a service
    # without them cannot be registered or executed.
    var name = _cfg_str(obj, "name", 0);
    if (name == 0) { return 0; }
    if (str_len(name) == 0) { return 0; }
    # ⚠ REJECTED HERE, not just at the cgroup call. The service name is
    # interpolated into /sys/fs/cgroup/kybernet.slice/{name}, so a `/` or
    # `..` walks out of the slice. 1.4.2's MEDIUM-3 added the predicate at
    # create_service_cgroup and move_to_cgroup and left the teardown paths
    # and the registry open, which meant an unsafe name still parsed, still
    # registered, and still reached kill/rmdir. A name kybernet cannot
    # safely operate on is a config error, and the whole service is refused.
    if (cgroup_name_is_safe(str_data(name)) == 0) { return 0; }
    var binary = _cfg_str(obj, "binary", 0);
    if (binary == 0) { return 0; }
    if (str_len(binary) == 0) { return 0; }

    var sd = svc_def_new(name, _cfg_str(obj, "description", str_from("")), binary);

    _cfg_str_array_into(obj, "args", svc_def_args(sd));
    _cfg_str_array_into(obj, "depends_on", svc_def_deps(sd));

    # Enum fields: reject an unrecognised value rather than defaulting.
    var type_s = _cfg_str(obj, "type", 0);
    if (type_s != 0) {
        var tr = service_type_parse(type_s);
        if (is_err_result(tr) == 1) { return 0; }
        svc_def_set_service_type(sd, result_unwrap(tr));
    }

    # sd_notify watchdog interval — a deadline INDEPENDENT of health_check
    # (argonaut 1.13.6). 0 or absent = no notify watchdog, which is the default
    # and preserves pre-1.6.8 behaviour exactly.
    #
    # ⚠ REJECTED, NOT CLAMPED, and bounded on both ends. A watchdog is a
    # kill decision: too small and a healthy service is killed for not pinging
    # fast enough, too large and it is no watchdog at all. Silently clamping a
    # typo'd value would produce a board that kills its own services on a
    # schedule the operator never wrote — the same reasoning as the Argon2
    # bounds at 1.5.9 (rule 25). The floor is 100 ms because the reactor's own
    # tick resolution makes anything finer meaningless; the ceiling is one hour.
    var wd_ms = _cfg_int(obj, "watchdog_ms", 0);
    if (wd_ms != 0) {
        if (wd_ms < 100 || wd_ms > 3600000) {
            klog2("config: watchdog_ms must be 100..3600000 ms - service REFUSED: ",
              str_data(svc_def_name(sd)));
            kmsg("kybernet: config: watchdog_ms out of range, service refused");
            return 0;
        }
        svc_def_set_watchdog_ms(sd, wd_ms);
    }

    var restart_s = _cfg_str(obj, "restart", 0);
    if (restart_s != 0) {
        var rr = restart_policy_parse(restart_s);
        if (is_err_result(rr) == 1) { return 0; }
        svc_def_set_restart_policy(sd, result_unwrap(rr));
    }

    svc_def_set_enabled(sd, _cfg_bool(obj, "enabled", 1));

    var pid_file = _cfg_str(obj, "pid_file", 0);
    if (pid_file != 0) { svc_def_set_pid_file(sd, pid_file); }

    var hc = _cfg_health_check(obj);
    if (hc == 0 - 1) { return 0; }
    if (hc != 0) { svc_def_set_health_check(sd, hc); }

    # A malformed security block rejects the service. Starting a service
    # whose confinement could not be parsed is strictly worse than not
    # starting it. 1.5.2.
    if (svc_apply_security_json(sd, obj) == 0) { return 0; }

    # Same contract for resource limits — an operator who configured a
    # memory cap and got a service without one is in the same position as
    # one whose capability drop silently vanished. 1.5.5.
    if (svc_apply_resources_json(sd, obj) == 0) { return 0; }

    return sd;
}

# Read a non-negative limit value for `key`.
# Returns the value, 0 if absent, or -1 if present but not a non-negative int.
#
# Rejecting a negative is not pedantry: cgroup v2 limit files take an
# unsigned value or the literal "max", and _cgroup_write_u64 formats with
# fmt_int_buf — so a -1 would be written as the string "-1", which the
# kernel rejects with EINVAL, silently leaving the limit unset. Catching it
# at parse time turns a silently-unlimited service into a rejected config.
fn _cfg_limit(obj, key) {
    var v = json_v_obj_get(obj, key);
    if (v == 0) { return 0; }
    if (json_v_is_int(v) == 0) { return 0 - 1; }
    var n = json_v_int(v);
    if (n < 0) { return 0 - 1; }
    return n;
}

# Parse a per-service "limits" block into agnostik's cgroup_limits and hang
# it off the ServiceDefinition (argonaut 1.13.0's cgroup_limits field).
# Returns 1 on success (including "no block"), 0 if the block is malformed.
#
# WHY cgroup_limits AND NOT ResourceLimits. ServiceDefinition also has a
# `resource_limits` slot, and the roadmap originally said to use it. Doing
# so would have been a live bug: argonaut's `struct ResourceLimits` is
# {nofile, address_space, nproc, core} while **agnostik independently
# defines a different struct with the same name** —
# {max_memory, max_cpu_time, max_fds, max_procs, max_disk, net_bw} — and
# ships the only rlim_* accessors. kybernet links both. cyrius warns about
# duplicate fns and symbols but NOT duplicate structs, so the collision is
# silent; a probe on 6.5.35 confirms sizeof(ResourceLimits) == 48, agnostik's.
# Reading an argonaut-built ResourceLimits through rlim_max_memory returns
# its `nofile` field, so a service configured for 1024 open files would have
# had memory.max set to 1024 BYTES and been OOM-killed on its first page.
# cgroup_limits has no such twin, and all five of its fields are real cgroup
# v2 control files. 1.5.5.
fn svc_apply_resources_json(sd, obj) {
    var lim = json_v_obj_get(obj, "limits");
    if (lim == 0) { return 1; }
    if (json_v_is_obj(lim) == 0) { return 0; }

    var mem_max   = _cfg_limit(lim, "memory_max");
    var mem_high  = _cfg_limit(lim, "memory_high");
    var cpu_wt    = _cfg_limit(lim, "cpu_weight");
    var pids_max  = _cfg_limit(lim, "pids_max");
    if (mem_max < 0 || mem_high < 0 || cpu_wt < 0 || pids_max < 0) { return 0; }

    # cpu.weight is 1..10000 in cgroup v2; anything else is EINVAL at the
    # kernel. 0 stays "unset" — that is the sentinel every field uses.
    if (cpu_wt != 0) {
        if (cpu_wt < 1 || cpu_wt > 10000) { return 0; }
    }

    # An empty or all-zero block carries no policy. Attaching a
    # cgroup_limits of all zeros would be harmless but misleading — every
    # write is skipped on the 0 sentinel — so leave the field null and let
    # the start path see "no limits" rather than "limits, none set".
    if (mem_max == 0 && mem_high == 0 && cpu_wt == 0 && pids_max == 0) { return 1; }

    # memory.high is a throttling watermark; above memory.max it can never
    # take effect, which is a config error worth surfacing rather than
    # quietly writing.
    if (mem_high != 0 && mem_max != 0) {
        if (mem_high > mem_max) { return 0; }
    }

    # cgroup_limits_new is all-zero (verified in agnostik's suite), so every
    # field left unset stays 0 = "do not write this control file".
    var cl = cgroup_limits_new();
    cglim_set_memory_max(cl, mem_max);
    cglim_set_memory_high(cl, mem_high);
    cglim_set_cpu_weight(cl, cpu_wt);
    cglim_set_pids_max(cl, pids_max);
    svc_def_set_cgroup_limits(sd, cl);
    return 1;
}

# ================================================================
# Edge-boot policy from config.json (1.5.7)
#
# ⚠ THIS EXISTS TO FIX A LIVE FOOT-GUN, not just to add a knob.
#
# Before 1.5.7 kybernet parsed NO edge config at all, so config_edge()
# always returned argonaut's edge_config_default() — readonly_rootfs = 1,
# luks_enabled = 1, tpm_attestation = 1 — with verify_boot defaulting to 1
# as well. Writing `"boot_mode": "edge"` in config.json was therefore an
# unconditional, un-overridable demand for a TPM *and* dm-verity, and the
# refusal path in main.cyr phase 6c drops to the emergency shell and then
# POWERS THE MACHINE OFF. On a headless board without a TPM that is a
# poweroff loop with no way out.
#
# So the default is FLIPPED here: an absent `edge` block now means
# detection-only. An operator who wants a hard prerequisite must say so.
# Refusing to boot is a policy an operator opts into, never one they
# inherit from a struct default they never saw.
# ⚠ ALL FIVE FIELDS, not three. `EdgeBootConfig` is
# {readonly_rootfs, luks_enabled, tpm_attestation, max_boot_ms, pcr_bindings}
# and this used to clear only the booleans — so `max_boot_ms` silently kept
# argonaut's `edge_config_default()` value of **3000** on every path: absent
# block, partial block, and the malformed-block reset in load_config.
#
# That is the same defect this function was written to fix, one field over.
# An operator who never configured a budget inherited a 3-SECOND one, and
# `veritysetup verify` hashes the entire rootfs image against it — so the
# refusal path (poweroff, when readonly_rootfs is set) was reachable by
# omission. 1.5.7 flipped the three booleans and stopped.
#
# 0 means "no budget configured": `_eb_over_budget` treats `max_ms <= 0` as
# unbounded, which is the only honest reading of a key the operator never
# wrote. A board that wants a boot deadline asks for one.
fn edge_apply_defaults(ec) {
    store64(ec, 0);        # readonly_rootfs
    store64(ec + 8, 0);    # luks_enabled
    store64(ec + 16, 0);   # tpm_attestation
    store64(ec + 24, 0);   # max_boot_ms — 0 = unbounded, NOT argonaut's 3000
    store64(ec + 32, 0);   # pcr_bindings — 0 = none, NOT argonaut's "7+14"
    return 0;
}

# Parse the "edge" block into argonaut's EdgeBootConfig plus kybernet's
# device/baseline globals. Returns 1 on success (including "no block"),
# 0 if the block is malformed.
#
# Everything is validated HERE, at load time, with a loud reason — never
# mid-boot. A typo in a device path or a truncated root hash must be a
# config error the operator can read, not a phase-6c poweroff.
fn edge_config_from_json(root, ec) {
    if (ec == 0) { return 1; }
    edge_apply_defaults(ec);

    var eb = json_v_obj_get(root, "edge");
    if (eb == 0) { return 1; }
    if (json_v_is_obj(eb) == 0) { return 0; }

    store64(ec, _cfg_bool(eb, "readonly_rootfs", 0));
    store64(ec + 8, _cfg_bool(eb, "luks_enabled", 0));
    store64(ec + 16, _cfg_bool(eb, "tpm_attestation", 0));

    var mb = _cfg_int(eb, "max_boot_ms", 0);
    if (mb < 0) { return 0; }
    if (mb > 0) { store64(ec + 24, mb); }

    var spec = _cfg_str(eb, "pcr_bindings", 0);
    if (spec != 0) {
        # Validate the indices now. TPM 2.0 has PCRs 0-23; an out-of-range
        # index handed to tpm_read_pcr yields nothing for that bank, and on
        # an attestation path "read nothing, found nothing wrong" is the
        # same failure shape as 1.4.2's MEDIUM-2 (a tool that never ran
        # counting as a pass).
        var idx = _eb_parse_pcr_indices(spec);
        for (var i = 0; i < vec_len(idx); i = i + 1) {
            var v = vec_get(idx, i);
            if (v < 0 || v > 23) { return 0; }
        }
        store64(ec + 32, spec);
    }

    # --- device paths ---
    var rd = _cfg_str(eb, "root_device", 0);
    var hd = _cfg_str(eb, "hash_device", 0);
    var rh = _cfg_str(eb, "root_hash", 0);
    var ld = _cfg_str(eb, "luks_device", 0);

    if (rd != 0 && edge_device_path_ok(rd) == 0) { return 0; }
    if (hd != 0 && edge_device_path_ok(hd) == 0) { return 0; }
    if (ld != 0 && edge_device_path_ok(ld) == 0) { return 0; }
    if (rh != 0 && edge_is_hex64_str(rh) == 0) { return 0; }

    # dm-verity needs all three or none — a half-specified triple would
    # silently degrade to "no verification" on a box that asked for it.
    var have = 0;
    if (rd != 0) { have = have + 1; }
    if (hd != 0) { have = have + 1; }
    if (rh != 0) { have = have + 1; }
    if (have != 0 && have != 3) { return 0; }

    edge_set_devices(rd, hd, rh, ld);

    # --- expected PCR baselines ---
    var ex = json_v_obj_get(eb, "expected_pcrs");
    if (ex != 0) {
        if (json_v_is_arr(ex) == 0) { return 0; }
        var pv = vec_new();
        var n = json_v_arr_len(ex);
        for (var k = 0; k < n; k = k + 1) {
            var e = json_v_arr_get(ex, k);
            if (e == 0 || json_v_is_str(e) == 0) { return 0; }
            var d = json_v_str(e);
            if (edge_is_hex64_str(d) == 0) { return 0; }
            # An all-zero baseline would match sigil's zero-fill for a PCR
            # it could not read — attestation that can never fail.
            if (edge_is_all_zero_hex(d) == 1) { return 0; }
            vec_push(pv, d);
        }
        edge_set_expected_pcrs(pv);
    }

    return 1;
}

# Parse the "services" array of an already-parsed config document into a
# vec of ServiceDefinition. Always returns a vec (possibly empty) so the
# caller never has to null-check.
#
# A malformed entry is skipped with a log line rather than aborting the
# whole config: losing one misconfigured service is recoverable, losing
# every service because of one typo is a dead boot.
fn svc_defs_from_json(root) {
    var out = vec_new();
    if (root == 0) { return out; }
    if (json_v_is_obj(root) == 0) { return out; }

    var arr = json_v_obj_get(root, "services");
    if (arr == 0) { return out; }
    if (json_v_is_arr(arr) == 0) {
        klog("config: \"services\" is not an array — ignoring");
        return out;
    }

    var n = json_v_arr_len(arr);
    for (var i = 0; i < n; i = i + 1) {
        var sd = svc_def_from_json(json_v_arr_get(arr, i));
        if (sd == 0) {
            klog("config: skipping malformed service entry");
        } else {
            vec_push(out, sd);
        }
    }
    return out;
}

# =======================================================================
# Per-service security policy (1.5.2)
# =======================================================================
#
# 1.4.3 delivered the mechanism — argonaut's pre-exec hook plus
# kyb_pre_exec — but no service carried a policy, so the hook was a no-op
# in practice. This is where profiles become real, and deliberately as
# DATA: a profile lives in /etc/kybernet/config.json, not in kybernet's
# source, so changing what a service may do does not mean rebuilding PID 1.
#
#   "security": {
#     "no_new_privs": true,
#     "capabilities": ["cap_net_bind_service"],
#     "landlock":     [ {"path": "/usr", "access": "read-exec"},
#                       {"path": "/var/lib/daimon", "access": "read-write"} ],
#     "landlock_optional": false,
#     "seccomp":      "basic"
#   }
#
# `capabilities` is a KEEP-list: present-and-empty means drop everything,
# absent means no capability policy at all. Names are the lowercase kernel
# spelling (`cap_sys_admin`) that capsh(1) and capability(7) use, parsed by
# agnostik's capability_parse — so a config written against Linux
# documentation works unmodified, and an unrecognised name is rejected
# rather than silently ignored. Silently ignoring a capability name is how
# you end up believing a service is confined when it is not.

enum SeccompKind {
    SECCOMP_NONE = 0;
    SECCOMP_BASIC = 1;
}

# kybernet's own policy object; argonaut treats svc_def_seccomp as opaque.
#
# `landlock_optional` rides here rather than on the landlock block because
# that block is a JSON ARRAY of rules with nowhere to hang a scalar, and this
# object is already the per-service policy kyb_pre_exec reads.
# ⚠ uid/gid RIDE HERE, on kybernet's own policy struct, rather than on
# argonaut's ServiceDefinition — which has no such field and would need a dep
# change and a tag to gain one. This is the same reason `landlock_optional`
# lives here: the struct is kybernet's, hung off `svc_def_seccomp`, so a new
# per-service policy field costs nothing outside this repo.
#
# -1 means "not configured", NOT uid 0. That distinction is load-bearing: 0 is
# a legitimate value meaning root, and conflating the two would make an absent
# key indistinguishable from an explicit request to stay root.
struct KybSeccompPolicy { kind; no_new_privs; landlock_optional; uid; gid; }

fn kyb_seccomp_policy_new(kind, nnp, ll_opt) {
    var p = alloc(40);
    store64(p, kind);
    store64(p + 8, nnp);
    store64(p + 16, ll_opt);
    store64(p + 24, 0 - 1);          # uid: -1 = not configured (0 means root)
    store64(p + 32, 0 - 1);          # gid: -1 = not configured
    return p;
}

fn kyb_policy_set_ids(p, uid, gid) {
    store64(p + 24, uid);
    store64(p + 32, gid);
    return p;
}

fn kyb_policy_uid(p) { return load64(p + 24); }
fn kyb_policy_gid(p) { return load64(p + 32); }

fn kyb_policy_kind(p)              { return load64(p); }
fn kyb_policy_no_new_privs(p)      { return load64(p + 8); }
fn kyb_policy_landlock_optional(p) { return load64(p + 16); }

fn _access_from_name(s) {
    if (str_eq_cstr(s, "none") == 1)       { return 0; }
    if (str_eq_cstr(s, "read") == 1)       { return 1; }
    if (str_eq_cstr(s, "read-write") == 1) { return 2; }
    if (str_eq_cstr(s, "read-exec") == 1)  { return 3; }
    return 0 - 1;
}

fn _seccomp_kind_from_name(s) {
    if (str_eq_cstr(s, "none") == 1)  { return SECCOMP_NONE; }
    if (str_eq_cstr(s, "basic") == 1) { return SECCOMP_BASIC; }
    return 0 - 1;
}

# Apply a "security" block to `sd`. Returns 1 on success, 0 if the block is
# malformed — the caller then rejects the whole service. Refusing to start a
# service whose confinement could not be understood is the only safe
# reading: the alternative is running it unconfined.
fn svc_apply_security_json(sd, obj) {
    var sec = json_v_obj_get(obj, "security");
    if (sec == 0) { return 1; }
    if (json_v_is_obj(sec) == 0) { return 0; }

    # --- capabilities (keep-list) ---
    var capv = json_v_obj_get(sec, "capabilities");
    if (capv != 0) {
        if (json_v_is_arr(capv) == 0) { return 0; }
        var caps = capability_set_new();
        var keep = capset_bounding(caps);
        var cn = json_v_arr_len(capv);
        for (var ci = 0; ci < cn; ci = ci + 1) {
            var e = json_v_arr_get(capv, ci);
            if (e == 0) { return 0; }
            if (json_v_is_str(e) == 0) { return 0; }
            var cr = capability_parse(json_v_str(e));
            if (is_err_result(cr) == 1) { return 0; }
            vec_push(keep, result_unwrap(cr));
        }
        svc_def_set_capabilities(sd, caps);
    }

    # --- user / group: run the service as a non-root uid ---
    #
    # ⚠ NUMERIC ONLY, AND THAT IS DELIBERATE. This tree has no /etc/passwd
    # reader and PID 1 is the wrong place to acquire one: name resolution at
    # boot means parsing a file that may live on a filesystem still unmounted
    # at that point, on the path where a failure is unrecoverable. A numeric uid is
    # unambiguous and needs nothing outside the config.
    #
    # Bounded and REFUSED out of range rather than clamped. A uid is an
    # identity, and silently substituting a different one is worse than
    # refusing the service: 0 would silently keep root (the exact thing the key
    # exists to avoid), and a wrapped or truncated value would run the service
    # as somebody unrelated. Ceiling is 2^31-1, the kernel's uid_t range;
    # nobody/nogroup at 65534 is comfortably inside it.
    var uid_v = _cfg_int(sec, "uid", 0 - 1);
    var gid_v = _cfg_int(sec, "gid", 0 - 1);
    if (uid_v != 0 - 1) {
        if (uid_v < 0 || uid_v > 2147483647) {
            klog("config: security.uid out of range — service REFUSED");
            return 0;
        }
    }
    if (gid_v != 0 - 1) {
        if (gid_v < 0 || gid_v > 2147483647) {
            klog("config: security.gid out of range — service REFUSED");
            return 0;
        }
    }
    # --- landlock filesystem rules ---
    var llv = json_v_obj_get(sec, "landlock");
    if (llv != 0) {
        if (json_v_is_arr(llv) == 0) { return 0; }
        var sbx = sandbox_config_new();
        var rules = sandbox_fs_rules(sbx);
        var ln = json_v_arr_len(llv);
        for (var li = 0; li < ln; li = li + 1) {
            var r = json_v_arr_get(llv, li);
            if (r == 0) { return 0; }
            if (json_v_is_obj(r) == 0) { return 0; }
            var path = _cfg_str(r, "path", 0);
            if (path == 0) { return 0; }
            if (str_len(path) == 0) { return 0; }
            var acc_s = _cfg_str(r, "access", 0);
            if (acc_s == 0) { return 0; }
            var acc = _access_from_name(acc_s);
            if (acc < 0) { return 0; }
            vec_push(rules, filesystem_rule_new(str_data(path), acc));
        }
        svc_def_set_landlock(sd, sbx);
    }

    # --- seccomp profile + no_new_privs ---
    var kind = SECCOMP_NONE;
    var sc_s = _cfg_str(sec, "seccomp", 0);
    if (sc_s != 0) {
        kind = _seccomp_kind_from_name(sc_s);
        if (kind < 0) { return 0; }
    }
    # Defaults to on: a service that asked to be confined at all wants the
    # setuid-escalation door shut, and both Landlock and seccomp require it.
    var nnp = _cfg_bool(sec, "no_new_privs", 1);

    # ⚠ DEFAULTS TO REQUIRED. A service that configured Landlock rules and
    # then ran on a kernel without Landlock used to start with NO filesystem
    # confinement while kyb_pre_exec reported success — `sandbox_apply`
    # answers Ok(1) for "kernel lacks Landlock" and the hook only tested for
    # Err. That is the outcome service_sandbox.cyr's own header calls "worse
    # than not running it", and what README calls failing closed.
    #
    # An operator who genuinely wants best-effort confinement on an old
    # kernel says so with `"landlock_optional": true`. Inheriting a refusal
    # is rule 19's complaint; inheriting a SILENT LOSS OF POLICY is worse,
    # so the default goes the other way here and says so in the log.
    var ll_opt = _cfg_bool(sec, "landlock_optional", 0);
    var pol = kyb_seccomp_policy_new(kind, nnp, ll_opt);
    # uid/gid were validated at the top of this function; carry them onto the
    # policy that is actually stored. (An earlier draft built a second policy
    # object there and dropped it on the floor — the parse succeeded and the
    # ids silently never reached kyb_pre_exec.)
    kyb_policy_set_ids(pol, uid_v, gid_v);
    svc_def_set_seccomp(sd, pol);
    return 1;
}

# The health-poll interval the configured services actually asked for.
#
# ⚠ THIS IS A POLL FLOOR, NOT PER-SERVICE SCHEDULING, AND THE DIFFERENCE IS
# STATED SO NOBODY READS MORE INTO IT. argonaut's `init_poll_health` checks
# EVERY service with a health_check on each tick; kybernet cannot ask it for a
# subset. So the timer is set to the SMALLEST interval any service requested,
# which means:
#   - no service is polled more slowly than it asked for (the defect being
#     fixed: a 5 s service was polled at the hardcoded 30 s), and
#   - a service that asked for a LONGER interval is polled more often than it
#     requested. Over-polling a health check is wasteful, not wrong.
# True per-service scheduling needs argonaut to accept a due-time filter; that
# is roadmapped rather than faked here.
#
# Why it matters beyond latency: argonaut sizes the runtime watchdog deadline
# as `interval * retries + timeout` from the service's OWN configured interval.
# A service polled six times slower than it asked for has a watchdog sized for
# a cadence it never receives, and can be killed for being late when it is the
# POLLER that was late.
#
# Clamped to [1, 30] seconds: below 1 s the reactor spends its life polling
# (and the harness bounds wakeups at 500), and 30 s is the historical default
# so a config with no health checks at all behaves exactly as before.
fn health_interval_from_services(svcs) {
    if (svcs == 0) { return 30; }
    var n = vec_len(svcs);
    var best = 0;
    for (var i = 0; i < n; i = i + 1) {
        var sd = vec_get(svcs, i);
        if (sd == 0) { continue; }
        var hc = svc_def_health_check(sd);
        if (hc == 0) { continue; }
        var ivms = svc_hc_interval_ms(hc);
        if (ivms <= 0) { continue; }
        # Round UP to whole seconds: rounding down would poll faster than the
        # clamp intends and a sub-second request is already below the floor.
        var ivs = (ivms + 999) / 1000;
        if (ivs < 1) { ivs = 1; }
        if (best == 0 || ivs < best) { best = ivs; }
    }
    if (best == 0) { return 30; }
    if (best < 1) { best = 1; }
    if (best > 30) { best = 30; }
    return best;
}

