# kybernet/cmdline.cyr — /proc/cmdline token scanning
# Requires: syscalls.cyr, alloc.cyr
#
# Factored out of main.cyr at 1.5.7. It had lived beside the harness
# helpers, which was fine while harness detection was its only caller — but
# edge_boot.cyr's `kybernet.edge=off` / `=permissive` escape hatches need it
# too, and a src/lib module reaching into main.cyr links in the real binary
# while breaking `cyrius test src/test.cyr`, which includes only src/lib.

# Scan /proc/cmdline for `needle` as a whitespace-delimited token.
# Boundary-checked so `kybernet.harness=11` or `nokybernet.harness=1`
# do not match `kybernet.harness=1`.
fn _cmdline_has(needle, nlen) {
    var fd = sys_open("/proc/cmdline", O_RDONLY | O_CLOEXEC, 0);
    if (fd < 0) { return 0; }
    var buf = alloc(1024);
    var n = sys_read(fd, buf, 1024);
    sys_close(fd);
    if (n <= 0) { return 0; }
    var i = 0;
    while (i <= n - nlen) {
        var matched = 1;
        var j = 0;
        while (j < nlen) {
            if (load8(buf + i + j) != load8(needle + j)) {
                matched = 0;
                j = nlen;
            } else {
                j = j + 1;
            }
        }
        if (matched == 1) {
            # Left boundary: start-of-buffer, space, or tab.
            var left_ok = 0;
            if (i == 0) { left_ok = 1; }
            else {
                var lb = load8(buf + i - 1);
                if (lb == 32) { left_ok = 1; }
                if (lb == 9)  { left_ok = 1; }
            }
            # Right boundary: end-of-buffer, space, tab, or newline.
            var right_ok = 0;
            var ri = i + nlen;
            if (ri >= n) { right_ok = 1; }
            else {
                var rb = load8(buf + ri);
                if (rb == 32) { right_ok = 1; }
                if (rb == 9)  { right_ok = 1; }
                if (rb == 10) { right_ok = 1; }
            }
            if (left_ok == 1 && right_ok == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}
