# kybernet/seccomp.cyr — seccomp BPF for service pre_exec
# Requires: agnosys/syscalls.cyr, tagged.cyr
#
# Builds and loads seccomp-BPF allowlist filters for child services.
# Applied in pre_exec (after fork, before exec).
# Uses raw prctl — no dependency on agnosys/security.cyr.

# BPF instruction constants
enum BpfConst {
    BPF_LD_W_ABS = 0x20;
    BPF_JMP_JEQ_K = 0x15;
    BPF_RET_K = 0x06;
    SECCOMP_RET_ALLOW = 0x7FFF0000;
    SECCOMP_RET_KILL_PROCESS = 0x80000000;
    SECCOMP_RET_LOG = 0x7FFC0000;
    BPF_MAXINSNS = 4096;
    SECCOMP_MODE_FILTER = 2;
    PR_SET_SECCOMP_NR = 22;
}

# struct seccomp_data field offsets (stable kernel ABI, all arches):
#   +0 int nr, +4 __u32 arch, +8 __u64 instruction_pointer, +16 args[6]
enum SeccompData {
    SECCOMP_DATA_NR_OFF = 0;
    SECCOMP_DATA_ARCH_OFF = 4;
}

# AUDIT_ARCH_* — the value seccomp_data.arch carries for the ABI the
# syscall was issued under. A filter that does not pin this is not a
# filter: syscall NUMBERS are per-ABI, so a process that switches ABI
# (on x86_64, `int 0x80` for i386, or the x32 ABI) is suddenly matched
# against a table built for a different numbering. x86_64 nr 11 is
# munmap; i386 nr 11 is execve. Pre-1.4.2 kybernet's filter loaded
# seccomp_data.nr as instruction 0 with no arch check at all — the
# textbook seccomp bypass, and the reason the kernel documentation
# leads with it. 1.4.2 audit HIGH-3.
#
# Jump offsets below cap `num` at 254 for a related reason: BPF jt/jf
# are u8. See seccomp_build.
#ifdef CYRIUS_ARCH_X86
enum SeccompArch { SECCOMP_AUDIT_ARCH = 0xC000003E; }
#endif
#ifdef CYRIUS_ARCH_AARCH64
enum SeccompArch { SECCOMP_AUDIT_ARCH = 0xC00000B7; }
#endif

# Seccomp filter builder: accumulates allowed syscall numbers
struct SeccompBuilder { syscalls; count; }

fn seccomp_builder_new() {
    var b = alloc(16);
    store64(b, vec_new());
    store64(b + 8, 0);
    return b;
}

fn seccomp_allow(builder, syscall_nr) {
    var v = load64(builder);
    vec_push(v, syscall_nr);
    var c = load64(builder + 8);
    store64(builder + 8, c + 1);
    return 0;
}

fn seccomp_count(builder) {
    return load64(builder + 8);
}

# Write a BPF sock_filter instruction (8 bytes) to buf at offset.
# Layout: u16 code, u8 jt, u8 jf, u32 k (little-endian)
fn _bpf_insn(buf, offset, code, jt, jf, k) {
    store16(buf + offset, code);
    store8(buf + offset + 2, jt);
    store8(buf + offset + 3, jf);
    store32(buf + offset + 4, k);
    return 0;
}

# Maximum allowed syscalls in one filter.
#
# BPF jt/jf are u8 fields. The widest jump this layout emits is the arch
# check's jf = num + 1, so num must stay <= 254 or _bpf_insn's store8
# silently truncates the offset and the filter jumps somewhere arbitrary
# — allowing or killing the wrong syscalls with no diagnostic. Pre-1.4.2
# the only guard was `num + 3 > BPF_MAXINSNS` (4096), so any filter with
# more than ~254 entries was quietly wrong. 1.4.2 audit HIGH-4.
enum SeccompLimits { SECCOMP_MAX_ALLOW = 254; }

# Build the BPF filter bytecode from the builder.
# Returns: Result(info_ptr) where info = { filter_ptr, filter_len }
fn seccomp_build(builder) {
    var v = load64(builder);
    var num = load64(builder + 8);
    if (num == 0) { return Err(EINVAL); }
    if (num > SECCOMP_MAX_ALLOW) { return Err(EINVAL); }
    if (num + 5 > BPF_MAXINSNS) { return Err(EINVAL); }

    # Layout (indices):
    #   0            LD  seccomp_data.arch
    #   1            JEQ AUDIT_ARCH   jt=0  jf=num+1   -> mismatch falls to KILL
    #   2            LD  seccomp_data.nr
    #   3 .. 3+num-1 JEQ nr_i         jt=num-i jf=0    -> match jumps to ALLOW
    #   3+num        RET KILL_PROCESS
    #   4+num        RET ALLOW
    var num_insns = num + 5;
    var filter_size = num_insns * 8;
    var filter = alloc(filter_size);
    if (filter == 0) { return Err(ENOMEM); }
    memset(filter, 0, filter_size);

    # 0: load the ABI the syscall was issued under.
    _bpf_insn(filter, 0, BPF_LD_W_ABS, 0, 0, SECCOMP_DATA_ARCH_OFF);
    # 1: wrong ABI -> skip the whole allowlist and land on RET KILL.
    _bpf_insn(filter, 8, BPF_JMP_JEQ_K, 0, num + 1, SECCOMP_AUDIT_ARCH);
    # 2: load the syscall number.
    _bpf_insn(filter, 16, BPF_LD_W_ABS, 0, 0, SECCOMP_DATA_NR_OFF);

    # 3..: each allowed syscall jumps forward to the ALLOW return.
    var off = 24;
    for (var i = 0; i < num; i = i + 1) {
        var nr = vec_get(v, i);
        _bpf_insn(filter, off, BPF_JMP_JEQ_K, num - i, 0, nr);
        off = off + 8;
    }

    # Default: KILL_PROCESS
    _bpf_insn(filter, off, BPF_RET_K, 0, 0, SECCOMP_RET_KILL_PROCESS);
    off = off + 8;

    # ALLOW return
    _bpf_insn(filter, off, BPF_RET_K, 0, 0, SECCOMP_RET_ALLOW);

    var info = alloc(16);
    if (info == 0) { return Err(ENOMEM); }
    store64(info, filter);
    store64(info + 8, filter_size);
    return Ok(info);
}

fn seccomp_filter_ptr(info) { return load64(info); }
fn seccomp_filter_len(info) { return load64(info + 8); }

# Load a seccomp filter into the calling process.
# Must be called after set_no_new_privs() (from privdrop.cyr).
# filter_ptr: pointer to BPF bytecode, filter_len: total bytes.
# Returns: Result
fn seccomp_load(filter_ptr, filter_len) {
    if (filter_len == 0) { return Err(EINVAL); }
    if (filter_len % 8 != 0) { return Err(EINVAL); }
    var num_insns = filter_len / 8;

    # sock_fprog: { u16 len, [6 pad], u64 filter_ptr } = 16 bytes
    var prog = alloc(16);
    memset(prog, 0, 16);
    store16(prog, num_insns);
    store64(prog + 8, filter_ptr);

    var r = syscall(SYS_PRCTL, PR_SET_SECCOMP_NR, SECCOMP_MODE_FILTER, prog, 0, 0);
    if (r < 0) { return Err(0 - r); }
    return Ok(0);
}

# Convenience: build and load a seccomp filter.
# Must be called after set_no_new_privs().
# Returns: Result
fn seccomp_apply(builder) {
    var info_r = seccomp_build(builder);
    if (is_err_result(info_r) == 1) { return info_r; }
    var info = result_unwrap(info_r);
    return seccomp_load(seccomp_filter_ptr(info), seccomp_filter_len(info));
}

# ================================================================
# Agnostik integration
# ================================================================

# Build a seccomp filter from an agnostik seccomp_profile.
# Iterates profile's syscall rules and adds allowed syscalls to builder.
# Returns: SeccompBuilder ready for seccomp_apply()
fn seccomp_from_profile(profile) {
    var b = seccomp_builder_new();
    var rules = scprof_syscalls(profile);
    var rlen = vec_len(rules);
    for (var ri = 0; ri < rlen; ri = ri + 1) {
        var rule = vec_get(rules, ri);
        if (scrule_action(rule) == SECCOMP_ALLOW) {
            var names = scrule_names(rule);
            var nlen = vec_len(names);
            for (var ni = 0; ni < nlen; ni = ni + 1) {
                seccomp_allow(b, vec_get(names, ni));
            }
        }
    }
    return b;
}

# Build and load a seccomp filter from an agnostik seccomp_profile.
# Must be called after set_no_new_privs().
# Returns: Result
fn seccomp_apply_profile(profile) {
    var b = seccomp_from_profile(profile);
    if (seccomp_count(b) == 0) { return Ok(0); }
    return seccomp_apply(b);
}

# Create a basic service seccomp filter.
# Allows: read, write, close, fstat, mmap, mprotect, munmap, brk,
#         rt_sigreturn, exit, exit_group, sigaltstack, arch_prctl,
#         gettid, futex, set_tid_address, set_robust_list,
#         getrandom, clock_gettime, rseq, openat, ioctl, pipe2,
#         dup, dup2, fcntl, lseek, epoll_create1, epoll_ctl,
#         epoll_wait, socket, bind, listen, accept, sendto, recvfrom
# Per-arch syscall numbers for the basic-service allowlist.
#
# These MUST be arch-dispatched. Pre-1.4.2 the list below was a flat set
# of x86_64 numbers, so on aarch64 the filter allowed a semantically
# unrelated set (x86_64 read=0 is io_setup on aarch64, write=1 is
# io_destroy) while denying read/write/exit — every sandboxed service
# would be killed by SECCOMP_RET_KILL_PROCESS on its first read().
# Standing rule 1 applied to a data table rather than a call site.
# 1.4.2 audit HIGH-5.
#
# aarch64 values are the asm-generic/unistd.h numbering; every entry the
# cyrius stdlib also exports was cross-checked against it. The handful the
# stdlib does not export (mprotect, rt_sigreturn, accept, sendto,
# sigaltstack, clock_gettime, set_robust_list, rseq) come from the kernel
# table and are pending validation on real aarch64 hardware — this whole
# module is not yet wired into the boot path (see the header note), so
# that validation gates enabling it, not this release.
#
# Note the ABI differences, not just renumbering: aarch64 has no dup2
# (dup3 only), no arch_prctl, and epoll_pwait instead of epoll_wait.
#ifdef CYRIUS_ARCH_X86
enum BasicSyscalls {
    BS_READ = 0;      BS_WRITE = 1;     BS_CLOSE = 3;     BS_FSTAT = 5;
    BS_LSEEK = 8;     BS_MMAP = 9;      BS_MPROTECT = 10; BS_MUNMAP = 11;
    BS_BRK = 12;      BS_RT_SIGRETURN = 15; BS_IOCTL = 16; BS_DUP = 32;
    BS_DUPX = 33;     BS_SOCKET = 41;   BS_CONNECT = 42;  BS_ACCEPT = 43;
    BS_SENDTO = 44;   BS_RECVFROM = 45; BS_BIND = 49;     BS_LISTEN = 50;
    BS_EXIT = 60;     BS_FCNTL = 72;    BS_SIGALTSTACK = 131;
    BS_ARCH_PRCTL = 158; BS_GETTID = 186; BS_FUTEX = 202;
    BS_EPOLL_WAIT = 232; BS_EPOLL_CTL = 233; BS_SET_TID_ADDRESS = 218;
    BS_CLOCK_GETTIME = 228; BS_EXIT_GROUP = 231; BS_OPENAT = 257;
    BS_SET_ROBUST_LIST = 273; BS_EPOLL_CREATE1 = 291; BS_PIPE2 = 293;
    BS_GETRANDOM = 318; BS_RSEQ = 334;
}
#endif
#ifdef CYRIUS_ARCH_AARCH64
enum BasicSyscalls {
    BS_READ = 63;     BS_WRITE = 64;    BS_CLOSE = 57;    BS_FSTAT = 80;
    BS_LSEEK = 62;    BS_MMAP = 222;    BS_MPROTECT = 226; BS_MUNMAP = 215;
    BS_BRK = 214;     BS_RT_SIGRETURN = 139; BS_IOCTL = 29; BS_DUP = 23;
    BS_DUPX = 24;     BS_SOCKET = 198;  BS_CONNECT = 203; BS_ACCEPT = 202;
    BS_SENDTO = 206;  BS_RECVFROM = 207; BS_BIND = 200;   BS_LISTEN = 201;
    BS_EXIT = 93;     BS_FCNTL = 25;    BS_SIGALTSTACK = 132;
    BS_GETTID = 178; BS_FUTEX = 98;
    BS_EPOLL_WAIT = 22; BS_EPOLL_CTL = 21; BS_SET_TID_ADDRESS = 96;
    BS_CLOCK_GETTIME = 113; BS_EXIT_GROUP = 94; BS_OPENAT = 56;
    BS_SET_ROBUST_LIST = 99; BS_EPOLL_CREATE1 = 20; BS_PIPE2 = 59;
    BS_GETRANDOM = 278; BS_RSEQ = 293;
}
#endif

fn seccomp_basic_service() {
    var b = seccomp_builder_new();
    seccomp_allow(b, BS_READ);
    seccomp_allow(b, BS_WRITE);
    seccomp_allow(b, BS_CLOSE);
    seccomp_allow(b, BS_FSTAT);
    seccomp_allow(b, BS_LSEEK);
    seccomp_allow(b, BS_MMAP);
    seccomp_allow(b, BS_MPROTECT);
    seccomp_allow(b, BS_MUNMAP);
    seccomp_allow(b, BS_BRK);
    seccomp_allow(b, BS_RT_SIGRETURN);
    seccomp_allow(b, BS_IOCTL);
    seccomp_allow(b, BS_DUP);
    seccomp_allow(b, BS_DUPX);
    seccomp_allow(b, BS_SOCKET);
    seccomp_allow(b, BS_CONNECT);
    seccomp_allow(b, BS_ACCEPT);
    seccomp_allow(b, BS_SENDTO);
    seccomp_allow(b, BS_RECVFROM);
    seccomp_allow(b, BS_BIND);
    seccomp_allow(b, BS_LISTEN);
    seccomp_allow(b, BS_EXIT);
    seccomp_allow(b, BS_FCNTL);
    seccomp_allow(b, BS_SIGALTSTACK);
    #ifdef CYRIUS_ARCH_X86
    seccomp_allow(b, BS_ARCH_PRCTL);
    #endif
    seccomp_allow(b, BS_GETTID);
    seccomp_allow(b, BS_FUTEX);
    seccomp_allow(b, BS_SET_TID_ADDRESS);
    seccomp_allow(b, BS_CLOCK_GETTIME);
    seccomp_allow(b, BS_EXIT_GROUP);
    seccomp_allow(b, BS_OPENAT);
    seccomp_allow(b, BS_SET_ROBUST_LIST);
    seccomp_allow(b, BS_EPOLL_CREATE1);
    seccomp_allow(b, BS_EPOLL_WAIT);
    seccomp_allow(b, BS_EPOLL_CTL);
    seccomp_allow(b, BS_PIPE2);
    seccomp_allow(b, BS_GETRANDOM);
    seccomp_allow(b, BS_RSEQ);
    return b;
}
