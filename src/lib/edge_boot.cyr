# kybernet/edge_boot.cyr — edge boot orchestration (verified + sealed)
#
# Reads `EdgeBootConfig` from the argonaut config and gates the
# extra trust-platform checks on `boot_mode == BOOT_EDGE` +
# `verify_on_boot`. TPM (`tpm_detect` / `tpm_read_pcr` / `TPM_SHA256`)
# resolves from sigil's `tpm` distlib profile (dist/sigil-tpm.cyr — 1.4.0).
# dm-verity capability detection is a LOCAL probe (`_eb_dmverity_supported`,
# below): sigil has no dm-verity distlib profile and pulling the full bundle
# for one syscall would drag in 13 MB of unused crypto `.bss`. The deferred
# dm-verity *verify* + LUKS unlock (1.2.1) will source sigil's storage surface
# when their device-path wiring lands.
#
# 1.2.0 SCOPE (this file):
#   - Capability detection: tpm_detect (sigil), dm-verity (local probe)
#   - PCR read per `pcr_bindings` spec ("7+14" → indices 7, 14)
#   - Honor `tpm_attestation` / `readonly_rootfs` flags as hard
#     prerequisites — boot aborts to emergency if required-but-missing.
#     Every refusal reason goes to /dev/kmsg as well as klog (1.5.3): on a
#     headless board dmesg is the only sink an operator still has.
#   - max_boot_ms wall-budget: checked BEFORE each exec-backed step and
#     enforced at the end when a hard prerequisite is set (1.5.3; was
#     warn-only and measured after all the work it bounded)
#   - LUKS unlock + dm-verity verify stubs that log "config land
#     in 1.2.1" and skip. Real-device wiring needs argonaut to extend
#     EdgeBootConfig with `data_device` / `hash_device` / `root_hash` /
#     LUKS device paths — out of scope for this cut.
#
# 1.2.1 SCOPE (deferred):
#   - argonaut EdgeBootConfig extension with device paths + expected
#     PCR baseline vec
#   - tpm_verify_measured_boot against the expected baseline
#   - dmverity_verify with concrete data/hash devices
#   - luks_open + luks_mount with TPM-unsealed or passphrase key
#   - Real hardware boot validation (RPi4, NUC)

# Status accessible after edge_boot_run completes — boot-phase logger
# reads these to surface the detected platform shape.
var _eb_tpm_present = 0;
var _eb_dmverity_supp = 0;
var _eb_pcr_count = 0;
var _eb_elapsed_ms = 0;

# Parse a `pcr_bindings` spec like "7+14" or "0,7,14" into a vec of
# i64 indices. Accepts any non-digit separator (`+`, `,`, ` `, `:`)
# so we tolerate the convention drift between consumers.
fn _eb_parse_pcr_indices(spec) {
    var out = vec_new();
    if (spec == 0) { return out; }
    var s = str_data(spec);
    var slen = strlen(s);
    var i = 0;
    var cur = 0;
    var have = 0;
    while (i < slen) {
        var c = load8(s + i);
        if (c >= 48 && c <= 57) {
            cur = cur * 10 + (c - 48);
            have = 1;
        } else {
            if (have == 1) { vec_push(out, cur); cur = 0; have = 0; }
        }
        i = i + 1;
    }
    if (have == 1) { vec_push(out, cur); }
    return out;
}

# dm-verity kernel-capability probe. Byte-for-byte the same check sigil's
# `dmverity_supported()` performs — kept LOCAL so kybernet's edge-boot trust
# surface pulls only sigil's `tpm` distlib profile (dist/sigil-tpm.cyr), not
# the full crypto bundle. sigil ships no dm-verity/LUKS distlib profile, and
# its raw src/dmverity.cyr can't be pulled cross-repo (unguarded internal
# `include "src/error.cyr"`). This is a 1-syscall + optional-exec probe, so
# reproducing it here is far cheaper than dragging in 13 MB of unused x509/RSA
# `.bss`. When 1.2.1 wires real dm-verity *verify* (which needs sigil's
# dmverity_open/verify with device paths), revisit sourcing a sigil dm-verity
# profile then. Semantics preserved: probe sysfs first, veritysetup fallback.
fn _eb_dmverity_supported() {
    if (sys_access("/sys/module/dm_verity", 0) == 0) { return 1; }
    var args = vec_new();
    vec_push(args, "/usr/sbin/veritysetup");
    vec_push(args, "--version");
    return exec_vec(args) == 0;
}

# Has the wall-clock budget been spent?
#
# The pre-1.5.3 budget check ran ONCE, after every step it was meant to
# bound — a post-mortem, and warn-only besides. It could not prevent
# anything: by the time it noticed, the two unbounded operations
# (_eb_dmverity_supported's `veritysetup --version` exec, and tpm_read_pcr's
# `tpm2_pcrread` exec, both blocking waits on external programs with no
# timeout of their own) had already run to completion.
#
# It still cannot interrupt a call that is already blocked — that needs a
# timeout inside sigil's exec path, which is not kybernet's to add. What it
# CAN do is refuse to START the next expensive step once the budget is
# spent, which is what this gives. Checked before each exec-backed step.
#
# Returns 1 when over budget. max_ms <= 0 means no budget configured.
fn _eb_over_budget(start_ms, max_ms) {
    if (max_ms <= 0) { return 0; }
    return (monotonic_ms() - start_ms) > max_ms;
}

# Run the edge-boot pre-flight. Returns 1 to continue boot, 0 to
# abort (caller should drop_to_emergency). Caller is responsible for
# the boot_mode gate — this is a no-op if the config doesn't request
# edge verification.
fn edge_boot_run(config) {
    if (config == 0) { return 1; }
    # Only the EDGE boot mode invokes this layer. Other modes
    # (server, desktop, minimal) skip the whole subsystem.
    if (config_boot_mode(config) != BOOT_EDGE) { return 1; }
    if (config_verify_boot(config) == 0) { return 1; }

    var ec = config_edge(config);
    if (ec == 0) {
        klog("edge boot: no EdgeBootConfig — skipping");
        return 1;
    }

    var start_ms = monotonic_ms();
    var readonly_req = load64(ec);            # readonly_rootfs
    var luks_req     = load64(ec + 8);        # luks_enabled
    var tpm_req      = load64(ec + 16);       # tpm_attestation
    var max_ms       = load64(ec + 24);       # max_boot_ms
    var pcr_spec     = load64(ec + 32);       # pcr_bindings (Str)

    klog("edge boot: capability detection");

    # ---- TPM detection ----
    _eb_tpm_present = tpm_detect();
    if (_eb_tpm_present == 1) {
        klog("edge boot: TPM detected (/dev/tpm{rm,}0)");
    } else {
        klog("edge boot: TPM not present");
        if (tpm_req == 1) {
            # kmsg, not just klog. klog reaches stderr and slog; neither
            # survives on a headless board with no console and no writable
            # /var. /dev/kmsg lands in dmesg, which is what an operator
            # actually has after a refused boot. Before 1.5.3 the only kmsg
            # line on this path was main.cyr's generic "phase 6c: FATAL
            # edge-boot prerequisite missing" — the operator got the fact of
            # a refusal but never the reason. 1.4.2 audit MEDIUM.
            klog("FATAL: tpm_attestation required but TPM unavailable");
            kmsg("edge-boot REFUSED: tpm_attestation required, no TPM present");
            return 0;
        }
    }

    # ---- dm-verity capability ----
    # Budget checkpoint BEFORE the probe: _eb_dmverity_supported may exec
    # veritysetup and block on it.
    if (_eb_over_budget(start_ms, max_ms) == 1) {
        klog("FATAL: edge boot exceeded max_boot_ms before dm-verity probe");
        kmsg("edge-boot REFUSED: max_boot_ms exceeded before dm-verity probe");
        return 0;
    }
    _eb_dmverity_supp = _eb_dmverity_supported();
    if (_eb_dmverity_supp == 1) {
        klog("edge boot: dm-verity supported");
    } else {
        klog("edge boot: dm-verity not supported");
        if (readonly_req == 1) {
            klog("FATAL: readonly_rootfs required but dm-verity unavailable");
            kmsg("edge-boot REFUSED: readonly_rootfs required, dm-verity unsupported");
            return 0;
        }
    }

    # ---- PCR read (measurement; comparison vs baseline is 1.2.1) ----
    if (_eb_tpm_present == 1 && tpm_req == 1) {
        var indices = _eb_parse_pcr_indices(pcr_spec);
        _eb_pcr_count = vec_len(indices);
        if (_eb_pcr_count > 0) {
            klog2("edge boot: reading PCRs ", "(measurement only — baseline compare lands in 1.2.1)");
            # sigil cannot report tool failure here, so check consumer-side.
            # tpm_read_pcr shells out to /usr/bin/tpm2_pcrread via
            # exec_capture, which returns the captured BYTE COUNT and
            # discards the child's wait status — so a missing or failing
            # tpm2_pcrread comes back as Ok(0) and sigil zero-fills every
            # unparsed PCR. On a box that asked for tpm_attestation, that
            # is an attestation "pass" derived from a tool that never ran.
            # Fail closed on a missing binary. 1.4.2 audit MEDIUM-2.
            if (sys_access("/usr/bin/tpm2_pcrread", 0) != 0) {
                klog("FATAL: tpm_attestation required but /usr/bin/tpm2_pcrread missing");
                kmsg("edge-boot REFUSED: /usr/bin/tpm2_pcrread missing");
                return 0;
            }
            # Budget checkpoint BEFORE the exec — tpm_read_pcr shells out
            # to tpm2_pcrread and blocks on it with no timeout.
            if (_eb_over_budget(start_ms, max_ms) == 1) {
                klog("FATAL: edge boot exceeded max_boot_ms before PCR read");
                kmsg("edge-boot REFUSED: max_boot_ms exceeded before PCR read");
                return 0;
            }
            var pcr_res = tpm_read_pcr(TPM_SHA256, indices);
            if (is_err_result(pcr_res) == 1) {
                klog("FATAL: tpm_read_pcr failed");
                kmsg("edge-boot REFUSED: tpm_read_pcr failed");
                return 0;
            }
            klog("edge boot: PCR read complete");
        } else {
            klog("edge boot: pcr_bindings empty — skipping PCR read");
        }
    }

    # ---- LUKS unlock — deferred to 1.2.1 ----
    if (luks_req == 1) {
        klog("edge boot: LUKS unlock — device-path config lands in 1.2.1; skipped");
    }

    # ---- dm-verity verify — deferred to 1.2.1 ----
    if (readonly_req == 1 && _eb_dmverity_supp == 1) {
        klog("edge boot: dm-verity verify — device-path config lands in 1.2.1; skipped");
    }

    # ---- Budget check ----
    _eb_elapsed_ms = monotonic_ms() - start_ms;
    if (max_ms > 0 && _eb_elapsed_ms > max_ms) {
        # Terminal check. Still reached only after the work, so it cannot
        # prevent the overrun — but on a device that set a boot budget AND
        # requires attestation, silently continuing past it is the wrong
        # default: a verified boot that took far longer than the operator
        # allowed is a signal, not a curiosity. Refuse when verification is
        # actually required; warn otherwise.
        klog("edge boot: exceeded max_boot_ms budget");
        if (tpm_req == 1 || readonly_req == 1) {
            kmsg("edge-boot REFUSED: max_boot_ms budget exceeded");
            return 0;
        }
        klog("WARNING: over budget, but no hard prerequisite set — continuing");
    }

    klog("edge boot: pre-flight complete");
    return 1;
}

# Accessors — main reads these after edge_boot_run() to surface the
# detected platform shape in the boot summary.
fn edge_boot_tpm_present()    { return _eb_tpm_present; }
fn edge_boot_dmverity_supp()  { return _eb_dmverity_supp; }
fn edge_boot_pcr_count()      { return _eb_pcr_count; }
fn edge_boot_elapsed_ms()     { return _eb_elapsed_ms; }
