# kybernet/edge_boot.cyr — edge boot orchestration (verified + sealed)
#
# Reads `EdgeBootConfig` from the argonaut config and gates the
# extra trust-platform checks on `boot_mode == BOOT_EDGE` +
# `verify_on_boot`. TPM (`tpm_detect` / `tpm_read_pcr_timeout` / `TPM_SHA256`)
# resolves from sigil's `tpm` distlib profile (dist/sigil-tpm.cyr — 1.4.0).
# dm-verity capability detection is a LOCAL probe (`_eb_dmverity_supported`,
# below): sigil has no dm-verity distlib profile and pulling the full bundle
# for one syscall would drag in 13 MB of unused crypto `.bss`. What CHANGELOG
# 1.5.7 calls the dm-verity *verify* is done by shelling out to `veritysetup verify`
# rather than by pulling sigil's storage surface — see _eb_verity_verify.
#
# WHAT THIS FILE DOES (as of 1.5.7):
#   - Capability detection: tpm_detect (sigil), dm-verity (local probe)
#   - PCR read per `pcr_bindings` ("7+14" -> indices 7, 14), indices
#     validated 0-23 at config load
#   - **dm-verity INTEGRITY VERIFICATION** via `veritysetup verify`, which
#     walks the hash tree in pure userspace — no device-mapper, no kernel
#     module, no /dev/mapper node. Bounded through argonaut 1.13.2's
#     run_safe_cmd_timeout (1.5.7)
#   - Per-flag hard prerequisites (`tpm_attestation` / `readonly_rootfs`),
#     each refusal reason to /dev/kmsg as well as klog (1.5.3): on a
#     headless board dmesg is the only sink an operator still has
#   - max_boot_ms wall-budget, checked BEFORE each exec-backed step and
#     enforced at the end when a hard prerequisite is set (1.5.3)
#   - `kybernet.edge=off` / `=permissive` cmdline escape hatches (1.5.7)
#
# SINCE 1.11.0, gated under swtpm by the x86 harness's TPM pass:
#   - `veritysetup open` + a read-only mount of the verified target at
#     `root_mount`, which catches corruption at READ time rather than once at
#     boot. A corrupted block reads as EIO: `--restart-on-corruption`, which
#     argonaut's verify_rootfs_integrity uses, would reboot a board with one bad
#     block into the same bad block for ever.
#   - LUKS unlock, with argonaut architecture note 005's key policy: the verified
#     root hash is measured into PCR 15 before the unlock and PCR 15 is capped
#     after it, so a token enrolled to PCR 7 + 15 releases its key only for this
#     root, and only once per boot.
# The modules these need are loaded before PID 1 starts, never by it.
#
# STILL OPEN:
#   - PCR baseline ENFORCEMENT against `expected_pcrs`. ⚠ Note the word:
#     COMPARISON is done and is live — `_eb_compare_pcrs` runs at every edge
#     boot with a TPM and reports drift to dmesg. What is left is acting on a
#     mismatch, which is only meaningful once the baseline is rooted in TPM
#     sealing rather than in a userspace tool living on the filesystem being
#     verified.
#
# ⚠ The header this replaces claimed all of the above "lands in 1.2.1" and
# that it was blocked on argonaut extending EdgeBootConfig with device
# paths. Both were false: 1.2.1 shipped long ago, and argonaut's
# execute_edge_boot has always taken the device paths as PARAMETERS. The
# real blockers were that argonaut's exec path could never succeed (bare
# binary names against an execve that does not search PATH — fixed in
# argonaut 1.13.2) and that a QEMU initramfs cannot load a dm module.

# ================================================================
# Edge policy source (1.5.7)
#
# Device paths and PCR baselines live here rather than on argonaut's
# EdgeBootConfig. argonaut's execute_edge_boot takes them as PARAMETERS,
# so the struct never needed extending — the roadmap's "blocked on an
# argonaut EdgeBootConfig extension" claim, carried since 1.2.0, was simply
# wrong. Same precedent as the emergency-shell credentials at 1.5.4.
var _eb_root_device = 0;      # Str, 0 = unset
var _eb_hash_device = 0;      # Str
var _eb_root_hash = 0;        # Str, 64 hex chars
var _eb_luks_device = 0;      # Str
# 1.11.0. Str, 0 = unset. The mapper name of the unlocked volume (validated like
# argonaut's validate_mapper_name), where to mount the verified root read-only (0 =
# verify only, as before 1.11.0), and its filesystem type.
var _eb_luks_name = 0;
var _eb_root_mount = 0;
var _eb_root_fstype = 0;
# ⚠ dm-verity VERIFICATION GETS ITS OWN BOUND. 1.6.14 HIGH-8.
#
# It used to borrow `max_boot_ms`, with `var vbudget = 10000;` as the
# UNCONDITIONAL initialiser — so `max_boot_ms` unset did NOT mean unbounded
# here, it meant exactly 10 seconds, with no comment justifying the number and
# no way to change it. That contradicted the contract svc_config.cyr spends
# eleven lines establishing ("0 means no budget configured") and that
# `_eb_over_budget` honours everywhere else.
#
# The consequence was a correctly-provisioned board that powers off and stays
# off: `veritysetup verify` walks the whole image, and 10 s buys roughly
# 200-450 MB off an SD card. veritysetup was SIGKILLed, `run_safe_cmd_timeout`
# returned -1, that folded into the tool-missing bucket, and the operator's
# only diagnostic was "veritysetup missing or unrunnable" — actively wrong,
# on the one path where they have no filesystem to debug from.
#
# The default is NOT unbounded. Standing rules 17 and 22 require every PID-1
# exec to be bounded, and phase 6c runs before the reactor with nothing reaping
# and nothing servicing a watchdog. 300 s is generous enough that a slow device
# finishes (~6 GB at SD speeds) and still bounds the stall; an operator who
# needs more asks for more, and gets a config error at LOAD time if they ask
# for something absurd (rule 19).
var _EB_VERIFY_TIMEOUT_DEFAULT = 300000;
var _eb_verify_timeout_ms = 300000;
var _eb_expected_pcrs = 0;    # vec of Str (64-hex digests), 0 = none

# Escape hatches, resolved once from /proc/cmdline at phase 6c.
#   kybernet.edge=off         — skip the edge layer entirely
#   kybernet.edge=permissive  — run every check, refuse for none of them
# An operator locked out by a hardware change or a bad baseline has no
# config file they can reach (the rootfs may be the thing that failed to
# verify), so the recovery path has to be on the kernel cmdline. 1.5.7.
var _eb_mode_off = 0;
var _eb_mode_permissive = 0;
# Set when phase 6c examined the verification result, found it NOT verified,
# and DELIBERATELY allowed the boot to continue — either because
# readonly_rootfs was not required, or because permissive mode suppressed the
# refusal. Phase 7's STAGE_VERIFY_ROOTFS must honour that decision instead of
# reaching the opposite verdict on the same fact. 1.6.13 HIGH-7.
var _eb_verity_waived = 0;

fn edge_set_devices(root_dev, hash_dev, root_hash, luks_dev) {
    _eb_root_device = root_dev;
    _eb_hash_device = hash_dev;
    _eb_root_hash = root_hash;
    _eb_luks_device = luks_dev;
    return 0;
}

fn edge_set_expected_pcrs(v) { _eb_expected_pcrs = v; return 0; }

fn edge_set_mounts(luks_name, root_mount, root_fstype) {
    _eb_luks_name = luks_name;
    _eb_root_mount = root_mount;
    _eb_root_fstype = root_fstype;
    return 0;
}

# Clear every piece of edge state kybernet owns. 1.6.16 LOW-1.
#
# `edge_apply_defaults` resets argonaut's EdgeBootConfig; these five globals are
# kybernet's and were reset by nothing, so a rejected or removed `edge` block
# left the previous values live and verification ran on a board that had just
# been told edge verification was disabled.
fn edge_reset_devices() {
    _eb_root_device = 0;
    _eb_hash_device = 0;
    _eb_root_hash = 0;
    _eb_luks_device = 0;
    _eb_expected_pcrs = 0;
    _eb_luks_name = 0;
    _eb_root_mount = 0;
    _eb_root_fstype = 0;
    return 0;
}
fn edge_set_verify_timeout(ms) { _eb_verify_timeout_ms = ms; return 0; }
fn edge_verify_timeout() { return _eb_verify_timeout_ms; }
fn edge_root_device()   { return _eb_root_device; }
fn edge_root_hash()     { return _eb_root_hash; }

# A device path must be absolute, under /dev, traversal-free and drawn from
# a conservative charset. Reimplemented locally rather than importing
# argonaut's validate_device_path, for the same reason
# _eb_dmverity_supported reimplements sigil's probe: it is ~20 lines against
# a whole module whose entry point kybernet deliberately does not call.
fn edge_device_path_ok(p) {
    if (p == 0) { return 0; }
    var len = str_len(p);
    if (len < 6 || len > 128) { return 0; }
    var d = str_data(p);
    if (load8(d) != 47) { return 0; }
    # Not str_starts_with: a literal handed to a Str parameter is boxed in the arena, 16
    # bytes per path per SIGHUP (1.10.0).
    if (memeq(d, "/dev/", 5) == 0) { return 0; }
    for (var i = 0; i < len; i = i + 1) {
        var c = load8(d + i);
        var ok = 0;
        if (c >= 48 && c <= 57)  { ok = 1; }
        if (c >= 65 && c <= 90)  { ok = 1; }
        if (c >= 97 && c <= 122) { ok = 1; }
        if (c == 47 || c == 45 || c == 95) { ok = 1; }
        if (ok == 0) { return 0; }
        # No "..", even though the charset above already excludes '.'.
        # Kept explicit so relaxing the charset cannot silently reopen it.
        if (c == 46) { return 0; }
    }
    return 1;
}

# Where the verified root may be mounted (1.11.0): absolute, at most 255 bytes,
# [A-Za-z0-9/_.-], not "/" itself, and no "..".
fn edge_mount_path_ok(p) {
    if (p == 0) { return 0; }
    var len = str_len(p);
    if (len < 2 || len > 255) { return 0; }
    var d = str_data(p);
    if (load8(d) != 47) { return 0; }
    for (var i = 0; i < len; i = i + 1) {
        var c = load8(d + i);
        var ok = 0;
        if (c >= 48 && c <= 57)  { ok = 1; }
        if (c >= 65 && c <= 90)  { ok = 1; }
        if (c >= 97 && c <= 122) { ok = 1; }
        if (c == 47 || c == 45 || c == 95 || c == 46) { ok = 1; }
        if (ok == 0) { return 0; }
        if (c == 46 && i + 1 < len && load8(d + i + 1) == 46) { return 0; }
    }
    return 1;
}

# A filesystem type the kernel is asked to mount: [a-z0-9], 1..16 bytes.
fn edge_fstype_ok(f) {
    if (f == 0) { return 0; }
    var len = str_len(f);
    if (len < 1 || len > 16) { return 0; }
    var d = str_data(f);
    for (var i = 0; i < len; i = i + 1) {
        var c = load8(d + i);
        var ok = 0;
        if (c >= 48 && c <= 57)  { ok = 1; }
        if (c >= 97 && c <= 122) { ok = 1; }
        if (ok == 0) { return 0; }
    }
    return 1;
}

# 1 if two hex Strs are the same digest, whatever their case. ⚠ IT WAS str_eq UNTIL
# 1.11.0, AND NO LOWERCASE BASELINE COULD MATCH. tpm2_pcrread prints uppercase hex and
# sigil keeps its bytes as printed, while an operator writes a baseline the way
# sha256sum does, lowercase. So the comparison reported a MISMATCH for the right PCR,
# found the first time anything ran it (the TPM board, standing rule 27).
fn edge_hex_eq(a, b) {
    if (a == 0 || b == 0) { return 0; }
    var n = str_len(a);
    if (str_len(b) != n) { return 0; }
    var da = str_data(a);
    var db = str_data(b);
    for (var i = 0; i < n; i = i + 1) {
        var ca = load8(da + i);
        var cb = load8(db + i);
        if (ca >= 65 && ca <= 70) { ca = ca + 32; }
        if (cb >= 65 && cb <= 70) { cb = cb + 32; }
        if (ca != cb) { return 0; }
    }
    return 1;
}

# 1 if every character is ASCII '0'. sigil's PCR parser ZERO-FILLS any
# PCR it could not parse out of tpm2_pcrread's output, so an all-zero
# expected baseline would match a PCR that was never actually read —
# attestation that can never fail. Rejected at config load, and treated as
# UNREADABLE rather than MATCH when it comes back from a live read.
fn edge_is_all_zero_hex(h) {
    if (h == 0) { return 0; }
    var n = str_len(h);
    if (n == 0) { return 0; }
    var d = str_data(h);
    for (var i = 0; i < n; i = i + 1) {
        if (load8(d + i) != 48) { return 0; }
    }
    return 1;
}

# Exactly 64 hex characters. dm-verity root hashes and SHA-256 PCR digests
# are both this shape.
fn edge_is_hex64_str(h) {
    if (h == 0) { return 0; }
    if (str_len(h) != 64) { return 0; }
    var d = str_data(h);
    for (var i = 0; i < 64; i = i + 1) {
        var c = load8(d + i);
        var ok = 0;
        if (c >= 48 && c <= 57)  { ok = 1; }
        if (c >= 65 && c <= 70)  { ok = 1; }
        if (c >= 97 && c <= 102) { ok = 1; }
        if (ok == 0) { return 0; }
    }
    return 1;
}

# Status accessible after edge_boot_run completes — boot-phase logger
# reads these to surface the detected platform shape.
var _eb_tpm_present = 0;
var _eb_dmverity_supp = 0;
var _eb_pcr_count = 0;
var _eb_elapsed_ms = 0;
var _eb_verity_verified = 0;
var _eb_pcr_mismatches = 0;

# Parse a `pcr_bindings` spec like "7+14" or "0,7,14" into a vec of
# i64 indices. Accepts any non-digit separator (`+`, `,`, ` `, `:`)
# so we tolerate the convention drift between consumers. `a` is where the vec
# goes: a reload validates this on every SIGHUP (1.10.0).
fn _eb_parse_pcr_indices_a(a, spec) {
    var out = vec_new_a(a);
    if (spec == 0) { return out; }
    var s = str_data(spec);
    var slen = strlen(s);
    var i = 0;
    var cur = 0;
    var have = 0;
    while (i < slen) {
        var c = load8(s + i);
        if (c >= 48 && c <= 57) {
            cur = cur * 10 + (c - 48);
            have = 1;
        } else {
            if (have == 1) { vec_push_a(a, out, cur); cur = 0; have = 0; }
        }
        i = i + 1;
    }
    if (have == 1) { vec_push_a(a, out, cur); }
    return out;
}

fn _eb_parse_pcr_indices(spec) { return _eb_parse_pcr_indices_a(default_alloc(), spec); }

# dm-verity kernel-capability probe. Byte-for-byte the same check sigil's
# `dmverity_supported()` performs — kept LOCAL so kybernet's edge-boot trust
# surface pulls only sigil's `tpm` distlib profile (dist/sigil-tpm.cyr), not
# the full crypto bundle. sigil ships no dm-verity/LUKS distlib profile, and
# its raw src/dmverity.cyr can't be pulled cross-repo (unguarded internal
# `include "src/error.cyr"`). This is a 1-syscall + optional-exec probe, so
# reproducing it here is far cheaper than dragging in 13 MB of unused x509/RSA
# `.bss`. 1.5.7 verifies integrity through `veritysetup verify` instead, so
# a sigil dm-verity profile is still not needed; revisit only if
# `veritysetup open` (which needs a real device-mapper stack) is ever wired.
# Semantics preserved: probe sysfs first, veritysetup fallback.
fn _eb_dmverity_supported() {
    if (sys_access("/sys/module/dm_verity", 0) == 0) { return 1; }
    # 1.5.7: was `exec_vec(["/usr/sbin/veritysetup", "--version"]) == 0`,
    # which had two defects. The path was hardcoded to /usr/sbin, so on a
    # split-usr system — or anywhere veritysetup ships only in /usr/bin —
    # the probe reported "unsupported" for a box that supports it. And
    # `exec_vec` is the same stdlib family as exec_vec_str: an unbounded
    # `sys_waitpid(pid, &stbuf, 0)` that discards its own return value and
    # reads a STATIC status buffer, so a wait that does not land reports
    # exit 0 — here, a false "dm-verity supported". Unbounded matters most:
    # this runs at phase 6c in PID 1, where a stalled child is a dead board.
    #
    # run_safe_cmd_timeout (argonaut 1.13.2) resolves the binary across
    # /usr/sbin, /sbin, /usr/bin, /bin and bounds the wait. 3 s is generous
    # for `--version`.
    var cmd = safe_cmd_new(str_from("veritysetup"));
    safe_cmd_add_arg(cmd, str_from("--version"));
    return run_safe_cmd_timeout(cmd, 3000) == 0;
}

# Has the wall-clock budget been spent?
#
# The pre-1.5.3 budget check ran ONCE, after every step it was meant to
# bound — a post-mortem, and warn-only besides. It could not prevent
# anything: by the time it noticed, the unbounded operations had already run
# to completion.
#
# Every exec here is bounded now: _eb_dmverity_supported and _eb_verity_verify
# go through argonaut's run_safe_cmd_timeout (1.5.7), and the PCR read through
# sigil's tpm_read_pcr_timeout (1.6.16). So this checkpoint refuses to START
# the next expensive step once the budget is spent, and each step carries a
# deadline of its own. Checked before each exec-backed step.
#
# Returns 1 when over budget. max_ms <= 0 means no budget configured.
fn _eb_over_budget(start_ms, max_ms) {
    if (max_ms <= 0) { return 0; }
    return (monotonic_ms() - start_ms) > max_ms;
}

# dm-verity INTEGRITY VERIFICATION, without instantiating a dm target.
#
# `veritysetup verify <data> <hash> <root_hash>` walks the hash tree in pure
# userspace and exits 0 only if every block hashes up to root_hash. It needs
# no device-mapper, no kernel module and no /dev/mapper node — which is what
# makes it usable here, and testable in an initramfs where dm is a module
# that nothing can load. `veritysetup open` (which argonaut's
# verify_rootfs_integrity builds) does need all of that. Since 1.11.0 a board
# with `root_mount` also opens and mounts the root, after this verify
# (_eb_mount_root), and the x86 harness's TPM pass gates it.
#
# This is the honest half of the 1.2.0 deferral: kybernet can now say "the
# rootfs image matches the root hash the operator pinned", which is the
# actual trust question. Mounting it read-only through dm-verity so that
# LATER corruption is caught at read time is the other half, and needs a
# device-mapper stack this init cannot assume.
#
# Bounded through argonaut 1.13.2's run_safe_cmd_timeout, NOT the stdlib's
# exec_vec_str — the latter waits forever and fails OPEN (it discards
# waitpid's return and reads a static status buffer, so a wait that does not
# land reports success). On a verify path that would be a verification that
# never ran, reported as verified.
#
# Returns: 0 verified, 1 not configured, 2 verification FAILED,
#          3 tool missing or unrunnable.
fn _eb_verity_verify(budget_ms) {
    if (_eb_root_device == 0 || _eb_hash_device == 0 || _eb_root_hash == 0) {
        return 1;
    }
    var cmd = safe_cmd_new(str_from("veritysetup"));
    safe_cmd_add_arg(cmd, str_from("verify"));
    safe_cmd_add_arg(cmd, _eb_root_device);
    safe_cmd_add_arg(cmd, _eb_hash_device);
    safe_cmd_add_arg(cmd, _eb_root_hash);

    # ⚠ TIME THE CALL, BECAUSE -1 MEANS TWO DIFFERENT THINGS. 1.6.14 HIGH-8.
    #
    # `run_safe_cmd_timeout` returns -1 both for a spawn failure and for a
    # child it SIGKILLed at the deadline, and those have opposite diagnoses:
    # one is "the tool is missing", the other is "the tool was working and we
    # did not wait long enough". Conflating them told operators to go looking
    # for an absent veritysetup that was present the whole time. argonaut does
    # not distinguish them, but the caller can: if we spent the whole budget,
    # it was the deadline.
    var t0 = monotonic_ms();
    var rc = run_safe_cmd_timeout(cmd, budget_ms);
    var spent = monotonic_ms() - t0;
    if (rc == 0) { return 0; }
    if (rc < 0 && budget_ms > 0 && spent >= budget_ms) { return 4; }
    # 127 is "binary not found" from _resolve_safe_binary; a remaining -1 is a
    # spawn failure. Neither is a verification verdict, and neither may be
    # reported as one.
    if (rc == 127 || rc < 0) { return 3; }
    return 2;
}

# ================================================================
# The verified root, mounted; and the data volume, unlocked (1.11.0)
# ================================================================
#
# argonaut architecture note 005 (CVE-2026-32606 class): a LUKS key sealed only to
# PCR 7 + 11 is released to ANY root that boots under the same signed kernel, so an
# attacker who swaps the root partition gets the data unlocked. Two steps close it:
#   1. after dm-verity has verified the root, extend SHA-256 of its 32-byte root
#      hash into PCR 15 before the unlock, and enrol the token to PCR 7 + 15, so a
#      different root reproduces no PCR 15 the token accepts;
#   2. after the unlock, extend PCR 15 again with a fixed marker, so nothing later
#      in the same boot, the emergency shell included, can unseal it a second time.
# The PCR value a token is enrolled to is therefore
#   PCR15 = SHA-256(32 zero bytes || edge_root_measurement(root_hash)).
var EB_PCR_ROOT = 15;
var EB_ROOT_MAPPER = "verified-root";
# SHA-256 of the ASCII "kybernet: data volume unlocked".
var EB_PCR_CAP = "217f4bd060b1c04be04de5146ed209d54068b162c60260e55a2bea9803360e6e";
var EB_MS_RDONLY = 1;
var EB_TPM_TIMEOUT_MS = 10000;
var EB_OPEN_TIMEOUT_MS = 30000;

# The digest kybernet extends into PCR 15 for a verified root: SHA-256 of the root
# hash's 32 bytes, as a 64-hex cstr, or 0 for anything that is not a 64-hex Str.
fn edge_root_measurement(root_hash) {
    if (edge_is_hex64_str(root_hash) == 0) { return 0; }
    var raw[32];
    if (hex_decode_into(str_data(root_hash), 64, &raw) != 1) { return 0; }   # 1 = decoded
    return sha256_hex(&raw, 32);
}

# The time a step may take: its own bound, cut down to what `max_boot_ms` leaves.
fn _eb_step_budget(start_ms, max_ms, own) {
    if (max_ms <= 0) { return own; }
    var remain = max_ms - (monotonic_ms() - start_ms);
    if (remain < 500) { remain = 500; }
    if (remain < own) { return remain; }
    return own;
}

# tpm2_pcrextend <index>:sha256=<hex>, bounded. 0 on success.
fn _eb_pcr_extend(index, hex, budget_ms) {
    var sb = str_builder_new();
    str_builder_add_int(sb, index);
    str_builder_add_cstr(sb, ":sha256=");
    str_builder_add_cstr(sb, hex);
    var cmd = safe_cmd_new(str_from("tpm2_pcrextend"));
    safe_cmd_add_arg(cmd, str_builder_build(sb));
    return run_safe_cmd_timeout(cmd, budget_ms);
}

# veritysetup open: the verified root as a device-mapper target that checks every
# block it reads. 0 on success.
fn _eb_verity_open(budget_ms) {
    var cmd = safe_cmd_new(str_from("veritysetup"));
    safe_cmd_add_arg(cmd, str_from("open"));
    safe_cmd_add_arg(cmd, str_from("--"));
    safe_cmd_add_arg(cmd, _eb_root_device);
    safe_cmd_add_arg(cmd, str_from(EB_ROOT_MAPPER));
    safe_cmd_add_arg(cmd, _eb_hash_device);
    safe_cmd_add_arg(cmd, _eb_root_hash);
    return run_safe_cmd_timeout(cmd, budget_ms);
}

# argonaut's unlock_luks, built here because its module is not in the link: one
# attempt, the token's key only, no passphrase fallback. 0 on success.
fn _eb_luks_open(budget_ms) {
    var cmd = safe_cmd_new(str_from("cryptsetup"));
    safe_cmd_add_arg(cmd, str_from("open"));
    safe_cmd_add_arg(cmd, str_from("--type"));
    safe_cmd_add_arg(cmd, str_from("luks2"));
    safe_cmd_add_arg(cmd, str_from("--token-only"));
    safe_cmd_add_arg(cmd, str_from("--token-id"));
    safe_cmd_add_arg(cmd, str_from("0"));
    safe_cmd_add_arg(cmd, str_from("--tries"));
    safe_cmd_add_arg(cmd, str_from("1"));
    safe_cmd_add_arg(cmd, str_from("--"));
    safe_cmd_add_arg(cmd, _eb_luks_device);
    safe_cmd_add_arg(cmd, _eb_luks_name);
    return run_safe_cmd_timeout(cmd, budget_ms);
}

# Open the verified root and mount it read-only at `root_mount`. 1 on success.
fn _eb_mount_root(budget_ms) {
    var rc = _eb_verity_open(budget_ms);
    if (rc != 0) {
        klog2("edge boot: veritysetup open FAILED, exit ", _u64_str(rc));
        return 0;
    }
    sys_mkdir(str_data(_eb_root_mount), 0x1ED);   # 0755; an existing directory is fine
    var m = sys_mount("/dev/mapper/verified-root", str_data(_eb_root_mount),
      str_data(_eb_root_fstype), EB_MS_RDONLY, 0);
    if (m != 0) {
        klog2("edge boot: read-only mount of the verified root FAILED, errno ", _u64_str(0 - m));
        return 0;
    }
    klog2("edge boot: verified root mounted read-only at ", str_data(_eb_root_mount));
    return 1;
}

# Measure, unlock, cap. 0 when every step succeeded, else which failed:
# 1 measure, 2 unlock, 3 cap (after a successful unlock).
fn _eb_unlock_measured(start_ms, max_ms) {
    var meas = edge_root_measurement(_eb_root_hash);
    if (meas == 0) { return 1; }
    if (_eb_pcr_extend(EB_PCR_ROOT, meas, _eb_step_budget(start_ms, max_ms, EB_TPM_TIMEOUT_MS)) != 0) {
        return 1;
    }
    klog("edge boot: verified root measured into PCR 15");
    var u = _eb_luks_open(_eb_step_budget(start_ms, max_ms, EB_OPEN_TIMEOUT_MS));
    # The cap runs whatever the unlock did: after this point no state of this boot
    # may unseal the key, and a refused unlock is still an attempt something could
    # repeat from a shell.
    var c = _eb_pcr_extend(EB_PCR_ROOT, EB_PCR_CAP, _eb_step_budget(start_ms, max_ms, EB_TPM_TIMEOUT_MS));
    if (u != 0) { return 2; }
    if (c != 0) { return 3; }
    klog("edge boot: PCR 15 capped");
    return 0;
}

# Compare the live PCR readings against the configured baselines.
#
# REPORT-ONLY, deliberately, and this is a policy decision rather than an
# unfinished one. PCR 7 and 14 legitimately change on any firmware or
# kernel update, so an enforcing comparison turns a routine signed upgrade
# into a fleet-wide refusal to boot. Worse, the oracle here is
# /usr/bin/tpm2_pcrread — a file living on the very rootfs under
# verification, whose output sigil's parser zero-fills wherever it cannot
# read it. A control that is defeated by replacing a file must not be able
# to permanently brick a board. The hardware-rooted version of this is TPM
# *sealing*: since 1.11.0 the LUKS key is sealed to PCR 7 + 15, and a board whose
# PCRs moved gets no key and refuses, without this compare deciding anything.
#
# So: operators get fleet drift in dmesg, before it can cost them a boot.
# Returns the number of MISMATCHES (0 = all matched or nothing to compare).
# ⚠ `indices` IS NOT OPTIONAL AND THE `str_from` BELOW IS NOT COSMETIC.
#
# 1.6.13 CRITICAL-2. sigil does NOT hand back a boxed `Str` here. Its producer
# (lib/sigil-tpm.cyr:676-679) builds the digest as a RAW NUL-terminated cstr —
# `alloc(hlen + 1)` + `memcpy` + `store8(p + hlen, 0)` — and
# `tpm_pcr_value_new` stores that pointer verbatim. This function then handed
# it to `edge_is_all_zero_hex` and `str_eq`, both of which are `Str` readers:
# `str_len(s)` is `load64(s + 8)` and `str_data(s)` is `load64(s)`. On a
# 64-character hex buffer that reads eight ASCII digits AS A POINTER
# (0x3434333332323131 ~ 3.76e18, far above the x86_64 canonical user-VA
# ceiling) and dereferences it. Measured: EXIT=139, SIGSEGV — in PID 1 at
# phase 6c that is "Attempted to kill init".
#
# It fired on the SUCCESS path, not an error path: the crash needs only a
# configured baseline and a readable TPM, not a mismatch. Standing rule 3, and
# the reason it survived is standing rule 27 — no qemu fixture sets
# `tpm_attestation: true`, so this function had never executed anywhere.
#
# 2. Baselines were matched POSITIONALLY against whatever order sigil returned,
# and `tpm_pcr_value_index` was never consulted — so `pcr_bindings: "14+7"`
# compared PCR 14's digest against PCR 7's baseline and reported two mismatches
# that were really one transposition. sigil's own comparator
# (lib/sigil-tpm.cyr:987-997) matches on index; kybernet was the outlier.
# `indices` is the configured index list, in the order it was handed to
# `tpm_read_pcr_timeout`, so entry i is the baseline for index i.
fn _eb_compare_pcrs(values, indices) {
    if (_eb_expected_pcrs == 0) { return 0; }
    var n = vec_len(_eb_expected_pcrs);
    if (n == 0) { return 0; }
    if (values == 0) { return 0; }

    var have = vec_len(values);
    var nidx = 0;
    if (indices != 0) { nidx = vec_len(indices); }
    var mismatches = 0;
    for (var i = 0; i < n; i = i + 1) {
        if (i >= have) {
            klog("edge boot: PCR baseline configured for an index that was not read");
            mismatches = mismatches + 1;
        } else {
            var pv = vec_get(values, i);
            # str_from(cstr) computes strlen and boxes it (16 bytes, once per
            # configured PCR at boot — not a hot path).
            var got = str_from(tpm_pcr_value_value(pv));
            var want = vec_get(_eb_expected_pcrs, i);
            # Refuse to compare a digest that is not the index this baseline
            # was written for. Mis-attributed attestation is worse than none:
            # it reports a mismatch the operator cannot explain, or — with two
            # equal digests — a MATCH for a PCR that was never checked.
            if (i < nidx && tpm_pcr_value_index(pv) != vec_get(indices, i)) {
                klog("edge boot: PCR index mismatch - read order does not match pcr_bindings");
                kmsg("kybernet: edge boot: PCR index mismatch vs pcr_bindings order");
                mismatches = mismatches + 1;
            } elif (edge_is_all_zero_hex(got) == 1) {
                # Never a match. sigil zero-fills a PCR it could not parse,
                # so all-zero means "unread", not "read as zero".
                klog("edge boot: PCR read back all-zero - UNREADABLE, not a match");
                mismatches = mismatches + 1;
            } elif (edge_hex_eq(got, want) == 0) {
                klog("edge boot: PCR MISMATCH vs configured baseline");
                kmsg("kybernet: edge boot: PCR mismatch vs baseline (report-only)");
                mismatches = mismatches + 1;
            }
        }
    }
    if (mismatches == 0) {
        klog("edge boot: all configured PCR baselines MATCH");
    } else {
        klog2("edge boot: PCR baselines not matching (report-only): ", _eb_u64(mismatches));
    }
    return mismatches;
}

# Small decimal formatter — klog2 takes cstr.
fn _eb_u64(n) {
    var b = alloc(24);
    var l = fmt_int_buf(n, b);
    store8(b + l, 0);
    return b;
}

# Refuse the boot for `reason` — or, under kybernet.edge=permissive, log it
# loudly and continue. Returns the value edge_boot_run should return, so
# every refusal site is `return _eb_refuse(...)` and none can forget the
# permissive check.
fn _eb_refuse(klog_msg, kmsg_msg) {
    klog(klog_msg);
    kmsg(kmsg_msg);
    if (_eb_mode_permissive == 1) {
        # A suppressed refusal is a DECISION TO CONTINUE, and phase 7 must not
        # re-litigate it (1.6.13 HIGH-7). Without this, kybernet.edge=permissive
        # printed "continuing despite the above" and then dropped the board into
        # an emergency shell three lines later — the documented recovery path
        # for a stale root hash failing to recover the board.
        _eb_verity_waived = 1;
        klog("edge boot: PERMISSIVE - continuing despite the above");
        return 1;
    }
    return 0;
}

# ⚠ FIVE ACCESSORS WERE REMOVED HERE AT 1.6.4, ALL WITH ZERO CALLERS:
# edge_boot_elapsed_ms, edge_boot_pcr_mismatches, edge_hash_device,
# edge_luks_device, edge_expected_pcrs. Two of them carried comments claiming
# "main reads these ... in the boot summary" — there has never been a boot
# summary. A getter with no consumer is not an API, it is a promise the code
# does not keep, and in this file the promises were load-bearing enough to be
# quoted back as evidence the feature existed.
#
# `edge_boot_verity_ok` is NOT in that list and stays: it has been live since
# 1.5.7, read by boot_stages.cyr's verify arm.

# Run the edge-boot pre-flight. Returns 1 to continue boot, 0 to
# abort (caller should drop_to_emergency). Caller is responsible for
# the boot_mode gate — this is a no-op if the config doesn't request
# edge verification.
fn edge_boot_run(config) {
    if (config == 0) { return 1; }
    # Only the EDGE boot mode invokes this layer. Other modes
    # (server, desktop, minimal) skip the whole subsystem.
    if (config_boot_mode(config) != BOOT_EDGE) { return 1; }
    if (config_verify_boot(config) == 0) { return 1; }

    var ec = config_edge(config);
    if (ec == 0) {
        klog("edge boot: no EdgeBootConfig - skipping");
        return 1;
    }

    # Cmdline escape hatches, resolved once. An operator locked out by a
    # hardware change or a stale baseline cannot edit a config file on a
    # rootfs that is itself what failed to verify, so the way back in has
    # to be the kernel cmdline. 1.5.7.
    _eb_mode_off = _cmdline_has("kybernet.edge=off", 17);
    _eb_mode_permissive = _cmdline_has("kybernet.edge=permissive", 24);
    if (_eb_mode_off == 1) {
        # NARROWED at 1.5.7. /proc/cmdline is only as trustworthy as the
        # bootloader — which is exactly the surface verified boot exists to
        # protect — so a total, silent bypass is the wrong thing to ship.
        # An operator who pinned a root_hash gets `off` DOWNGRADED to
        # permissive: every check still runs and every result still reaches
        # dmesg, it just does not refuse. The recovery property is kept
        # (the board boots) without the audit trail disappearing.
        #
        # On a board with no root_hash configured there is nothing to
        # bypass, so `off` is honoured as written.
        if (_eb_root_hash != 0) {
            klog("edge boot: kybernet.edge=off DOWNGRADED to permissive - root_hash is configured");
            kmsg("kybernet: edge boot: cmdline off downgraded to permissive, checks still run");
            _eb_mode_off = 0;
            _eb_mode_permissive = 1;
        } else {
            klog("edge boot: DISABLED by kybernet.edge=off - skipping");
            kmsg("kybernet: edge boot disabled by cmdline");
            return 1;
        }
    }
    if (_eb_mode_permissive == 1) {
        klog("edge boot: PERMISSIVE (kybernet.edge=permissive) - checks run, refusals suppressed");
        kmsg("kybernet: edge boot PERMISSIVE - refusals suppressed");
    }

    var start_ms = monotonic_ms();
    var readonly_req = load64(ec);            # readonly_rootfs
    var luks_req     = load64(ec + 8);        # luks_enabled
    var tpm_req      = load64(ec + 16);       # tpm_attestation
    var max_ms       = load64(ec + 24);       # max_boot_ms
    var pcr_spec     = load64(ec + 32);       # pcr_bindings (Str)

    klog("edge boot: capability detection");

    # ---- TPM detection ----
    _eb_tpm_present = tpm_detect();
    if (_eb_tpm_present == 1) {
        klog("edge boot: TPM detected (/dev/tpm{rm,}0)");
    } else {
        klog("edge boot: TPM not present");
        if (tpm_req == 1) {
            # kmsg, not just klog. klog reaches stderr and slog; neither
            # survives on a headless board with no console and no writable
            # /var. /dev/kmsg lands in dmesg, which is what an operator
            # actually has after a refused boot. Before 1.5.3 the only kmsg
            # line on this path was main.cyr's generic "phase 6c: FATAL
            # edge-boot prerequisite missing" — the operator got the fact of
            # a refusal but never the reason. 1.4.2 audit MEDIUM.
            return _eb_refuse("FATAL: tpm_attestation required but TPM unavailable",
              "edge-boot REFUSED: tpm_attestation required, no TPM present");
        }
    }

    # ---- dm-verity capability ----
    # Budget checkpoint BEFORE the probe: _eb_dmverity_supported may exec
    # veritysetup and block on it.
    if (_eb_over_budget(start_ms, max_ms) == 1) {
        return _eb_refuse("FATAL: edge boot exceeded max_boot_ms before dm-verity probe",
          "edge-boot REFUSED: max_boot_ms exceeded before dm-verity probe");
    }
    _eb_dmverity_supp = _eb_dmverity_supported();
    if (_eb_dmverity_supp == 1) {
        klog("edge boot: dm-verity supported");
    } else {
        # NOT a refusal any more (1.5.7). This probe answers "can the kernel
        # instantiate a dm-verity target", which is what `veritysetup open`
        # needs — and kybernet does not call open. It verifies with
        # `veritysetup verify`, which walks the hash tree in pure userspace
        # and works fine on a kernel with no dm at all. Refusing here failed
        # boards that could verify perfectly well. The refusal now keys on
        # the actual verification RESULT below, which is the thing that
        # answers the trust question.
        klog("edge boot: dm-verity target instantiation unavailable (verify does not need it)");
    }

    # ---- PCR read (measurement only; see the header on baseline compare) ----
    if (_eb_tpm_present == 1 && tpm_req == 1) {
        var indices = _eb_parse_pcr_indices(pcr_spec);
        _eb_pcr_count = vec_len(indices);
        if (_eb_pcr_count > 0) {
            klog2("edge boot: reading PCRs ",
              "(measurement only; a mismatch is reported, not enforced)");
            # Fail closed on a missing binary, before spending the budget on it.
            # Until sigil 3.12.11 this was the only check: exec_capture discarded
            # the child's wait status, so a missing tpm2_pcrread came back as
            # Ok(0), sigil zero-filled every PCR, and a box that asked for
            # tpm_attestation got a "pass" from a tool that never ran. 1.4.2
            # audit MEDIUM-2.
            # ⚠ X_OK (1), NOT F_OK (0). 1.6.16 LOW-3.
            #
            # A guard whose stated purpose is fail-closed was passing a binary
            # that cannot run: F_OK only asks whether the path exists. chmod 000
            # passes it — and as uid 0 `access(X_OK)` still fails when no execute
            # bit is set, so X_OK catches exactly that case. Missing tpm2-tss
            # libraries (execve -> 127) and a busy resource manager are caught by
            # sigil 3.12.11's status check instead, which no longer reports a
            # tool that exited non-zero as a successful capture.
            if (sys_access("/usr/bin/tpm2_pcrread", 1) != 0) {
                return _eb_refuse("FATAL: tpm_attestation required but /usr/bin/tpm2_pcrread missing or not executable",
                  "edge-boot REFUSED: /usr/bin/tpm2_pcrread missing or not executable");
            }
            # Budget checkpoint BEFORE the exec.
            if (_eb_over_budget(start_ms, max_ms) == 1) {
                return _eb_refuse("FATAL: edge boot exceeded max_boot_ms before PCR read",
                  "edge-boot REFUSED: max_boot_ms exceeded before PCR read");
            }
            # ⚠ THE PCR READ IS NOW BOUNDED. 1.6.16 — audit MEDIUM-8.
            #
            # `tpm_read_pcr` shelled out to tpm2_pcrread through sigil's
            # `agnosys_run_capture`, i.e. the stdlib's `exec_capture`: a blocking
            # drain and an unbounded `waitpid` whose status was then discarded. A
            # wedged TPM — /dev/tpm0 held open by another consumer, a tabrmd/D-Bus
            # TCTI wait, bad firmware — therefore hung PID 1 here FOREVER. This is
            # phase 6c: before the reactor, so nothing reaps, nothing services a
            # watchdog, no service has started, and every signal is blocked. The
            # board looks dead with `edge boot: reading PCRs` as its last line.
            #
            # sigil 3.12.11 added the bounded, status-checked form. Give it the
            # same treatment the verity verify already gets: its own budget,
            # capped by whatever remains of `max_boot_ms` when one is configured.
            # The default when none is (`_EB_VERIFY_TIMEOUT_DEFAULT`) is generous
            # for a device read and still bounded, per rules 17 and 22.
            var pbudget = _eb_verify_timeout_ms;
            if (max_ms > 0) {
                var premain = max_ms - (monotonic_ms() - start_ms);
                if (premain < 500) { premain = 500; }
                if (premain < pbudget) { pbudget = premain; }
            }
            var pcr_rest, pcr_resv = tpm_read_pcr_timeout(TPM_SHA256, indices, pbudget);
            if (is_err_result(pcr_rest) == 1) {
                # Now covers a TIMEOUT and a non-zero exit as well as a parse
                # failure — sigil no longer reports a tool that never ran, or one
                # that was killed at its deadline, as a successful capture.
                return _eb_refuse("FATAL: tpm_read_pcr failed, timed out, or the tool exited non-zero",
                  "edge-boot REFUSED: tpm_read_pcr failed or timed out");
            }
            # ⚠ "COMPLETE" ONLY IF IT ACTUALLY READ SOMETHING. 1.6.16 LOW-3.
            #
            # sigil zero-fills any PCR it could not parse out of tpm2_pcrread's
            # output, so an all-ASCII-'0' digest means UNREADABLE, never "read as
            # zero". kybernet logged `PCR read complete` regardless — diagnostic
            # dishonesty rather than a bypass (nothing downstream is decisional,
            # and `_eb_compare_pcrs` already refuses to treat all-zero as a
            # match), but the next person to make the comparison enforcing would
            # inherit a line that does not mean what it says.
            #
            # Said plainly instead. Not escalated to a refusal: this module's
            # header commits to PCR comparison being REPORT-ONLY on purpose —
            # PCR 7 and 14 legitimately change on any signed firmware or kernel
            # update, and an enforcing comparison turns a routine upgrade into a
            # fleet-wide refusal to boot. The structural half of this finding is
            # sigil 3.12.11's status check, which stops a tool that never ran or
            # exited non-zero from reaching here as a successful capture at all.
            var pcr_vals = result_unwrap(pcr_rest, pcr_resv);
            var unread = 0;
            for (var pv = 0; pv < vec_len(pcr_vals); pv = pv + 1) {
                if (edge_is_all_zero_hex(str_from(tpm_pcr_value_value(vec_get(pcr_vals, pv)))) == 1) {
                    unread = unread + 1;
                }
            }
            if (unread > 0) {
                klog2("edge boot: PCR read returned UNREADABLE (all-zero) banks: ", _u64_str(unread));
                kmsg("kybernet: edge boot: one or more PCRs came back all-zero - not a reading");
            } else {
                klog("edge boot: PCR read complete");
            }
            _eb_pcr_mismatches = _eb_compare_pcrs(pcr_vals, indices);
        } else {
            klog("edge boot: pcr_bindings empty - skipping PCR read");
        }
    }

    # ---- dm-verity integrity verification (1.5.7) ----
    #
    # Runs whenever devices are configured, independently of whether the
    # kernel can instantiate a dm target — `veritysetup verify` is pure
    # userspace. That is deliberate: a board whose dm-verity module is
    # missing can still learn that its rootfs image matches the pinned root
    # hash, and that is the more useful half of the answer.
    if (_eb_root_device != 0) {
        # ⚠ THE CHECKPOINT THE HEADER CLAIMED AND THE CODE DID NOT HAVE.
        # This file's own header says the budget is "checked BEFORE each
        # exec-backed step"; before 1.6.14 there was no `_eb_over_budget` call
        # ahead of the most expensive exec in the function.
        if (_eb_over_budget(start_ms, max_ms) == 1) {
            return _eb_refuse("FATAL: edge boot exceeded max_boot_ms before dm-verity verify",
              "edge-boot REFUSED: max_boot_ms exceeded before dm-verity verify");
        }
        # The verify's OWN bound. `max_boot_ms`, when set, is an overall wall
        # budget and still caps it — but its ABSENCE no longer silently means
        # ten seconds.
        var vbudget = _eb_verify_timeout_ms;
        if (max_ms > 0) {
            var remain = max_ms - (monotonic_ms() - start_ms);
            if (remain < 500) { remain = 500; }
            if (remain < vbudget) { vbudget = remain; }
        }
        var vres = _eb_verity_verify(vbudget);
        if (vres == 0) {
            _eb_verity_verified = 1;
            klog("edge boot: dm-verity integrity VERIFIED against configured root_hash");
        } elif (vres == 2) {
            _eb_verity_verified = 0;
            if (readonly_req == 1) {
                return _eb_refuse("FATAL: dm-verity verification FAILED — rootfs does not match root_hash",
                  "edge-boot REFUSED: dm-verity verification failed");
            }
            _eb_verity_waived = 1;
            klog("WARNING: dm-verity verification FAILED, but readonly_rootfs not required");
        } elif (vres == 4) {
            # TIMEOUT — the tool was present and running. Naming it "missing"
            # here sent operators hunting for a binary that was never absent.
            _eb_verity_verified = 0;
            if (readonly_req == 1) {
                return _eb_refuse(
                  "FATAL: dm-verity verify exceeded its budget - raise edge.verify_timeout_ms",
                  "edge-boot REFUSED: dm-verity verify TIMED OUT (veritysetup was present and running)");
            }
            _eb_verity_waived = 1;
            klog("WARNING: dm-verity verify exceeded its budget - integrity NOT verified");
        } else {
            _eb_verity_verified = 0;
            if (readonly_req == 1) {
                return _eb_refuse("FATAL: dm-verity requested but veritysetup could not run",
                  "edge-boot REFUSED: veritysetup missing or unrunnable");
            }
            _eb_verity_waived = 1;
            klog("edge boot: veritysetup unavailable - integrity NOT verified");
        }
    } elif (readonly_req == 1) {
        klog("edge boot: readonly_rootfs set but no verity device config");
        klog("edge boot: integrity NOT verified");
        kmsg("kybernet: edge boot: readonly_rootfs set without device config, integrity NOT verified");
    }

    # ---- The verified root, read-only (1.11.0) ----
    #
    # Whenever it is configured and the boot got this far: verified, or not verified
    # and allowed on. dm-verity checks each block as it is read, so a root that failed
    # its boot-time verify still reads as EIO wherever it is corrupt, which is
    # strictly safer than reading the device with nothing checking it.
    if (_eb_root_mount != 0 && _eb_root_device != 0) {
        if (_eb_mount_root(_eb_step_budget(start_ms, max_ms, EB_OPEN_TIMEOUT_MS)) == 0) {
            if (readonly_req == 1) {
                return _eb_refuse("FATAL: the verified root could not be opened and mounted read-only",
                  "edge-boot REFUSED: verified root open or mount failed");
            }
            klog("WARNING: the verified root is not mounted, but readonly_rootfs not required");
        }
    }

    # ---- LUKS: measure, unlock, cap (1.11.0) ----
    #
    # Each refusal names its reason, because each has a different fix: an
    # unverified root, no TPM, a TPM that would not release the key (a different
    # root, or a token enrolled to other values), or a cap that did not land.
    if (luks_req == 1) {
        if (_eb_luks_device == 0) {
            return _eb_refuse("FATAL: luks_enabled set but no luks_device configured",
              "edge-boot REFUSED: luks_enabled without luks_device");
        }
        if (_eb_verity_verified == 0) {
            return _eb_refuse("FATAL: LUKS unlock needs a verified root - its key is bound to that root's measurement",
              "edge-boot REFUSED: no verified root to measure before the LUKS unlock");
        }
        if (_eb_tpm_present == 0) {
            return _eb_refuse("FATAL: LUKS unlock needs a TPM, and there is none",
              "edge-boot REFUSED: LUKS unlock needs a TPM");
        }
        var lu = _eb_unlock_measured(start_ms, max_ms);
        if (lu == 1) {
            return _eb_refuse("FATAL: the verified root could not be measured into PCR 15",
              "edge-boot REFUSED: PCR 15 measurement failed");
        }
        if (lu == 2) {
            return _eb_refuse("FATAL: LUKS unlock FAILED - the TPM released no key for this root",
              "edge-boot REFUSED: LUKS unlock failed (wrong root, or the token is enrolled to other PCRs)");
        }
        if (lu == 3) {
            return _eb_refuse("FATAL: PCR 15 could not be capped after the unlock - the key could be unsealed again",
              "edge-boot REFUSED: PCR 15 cap failed after the LUKS unlock");
        }
        klog2("edge boot: data volume unlocked: /dev/mapper/", str_data(_eb_luks_name));
    }

    # ---- Budget check ----
    _eb_elapsed_ms = monotonic_ms() - start_ms;
    if (max_ms > 0 && _eb_elapsed_ms > max_ms) {
        # Terminal check. Still reached only after the work, so it cannot
        # prevent the overrun — but on a device that set a boot budget AND
        # requires attestation, silently continuing past it is the wrong
        # default: a verified boot that took far longer than the operator
        # allowed is a signal, not a curiosity. Refuse when verification is
        # actually required; warn otherwise.
        klog("edge boot: exceeded max_boot_ms budget");
        if (tpm_req == 1 || readonly_req == 1) {
            return _eb_refuse("FATAL: edge boot over max_boot_ms budget",
              "edge-boot REFUSED: max_boot_ms budget exceeded");
        }
        klog("WARNING: over budget, but no hard prerequisite set - continuing");
    }

    klog("edge boot: pre-flight complete");
    return 1;
}

# Accessors — main reads these after edge_boot_run() to surface the
# detected platform shape in the boot summary.
fn edge_boot_tpm_present()    { return _eb_tpm_present; }
fn edge_boot_dmverity_supp()  { return _eb_dmverity_supp; }
fn edge_boot_pcr_count()      { return _eb_pcr_count; }
