# kybernet/reaper.cyr — zombie process reaper for PID 1
# Requires: agnosys/syscalls.cyr, vec.cyr, tagged.cyr
#
# PID 1 must reap all orphaned children to prevent zombies.
# Matches Rust: reap_zombies() -> Vec<(u32, i32)>

# Reaped process info
struct ReapedProcess { pid; exit_code; }

# Memoized empty vec for the idle path.
#
# ⚠ NEVER MUTATE THE RETURNED VEC. Every idle reap hands back this same
# object; a vec_push into it would be visible to every later caller. Callers
# only ever read it (vec_len / vec_get), which is what makes sharing safe.
var _reap_empty = 0;

fn _reap_empty_vec() {
    if (_reap_empty == 0) { _reap_empty = vec_new(); }
    return _reap_empty;
}

# Reap all zombie children (non-blocking).
# Returns a vec of ReapedProcess pointers.
#
# ⚠ THE RESULTS VEC IS ALLOCATED LAZILY, AND THAT IS A LEAK FIX, NOT A
# MICRO-OPTIMISATION. Until 1.6.5 this opened with an unconditional
# `var results = vec_new();` BEFORE the waitpid loop — so every SIGCHLD cost a
# full vec (measured: **152 bytes**, a 24-byte header plus a 128-byte 16-slot
# backing array) even when it reaped nothing at all. In the one arena PID 1
# never resets (rule 8) that is permanent growth.
#
# It is also the most reachable of the three leaks 1.6.5 fixed: driving it
# needs no socket, no credentials and no configuration — any process that forks
# a child and lets it die delivers a SIGCHLD to PID 1, and a double-fork
# reparents grandchildren here forever. The notify leaks at 1.6.3 at least
# required reaching a 0700 socket.
#
# argonaut's `proc_table_reap` already had exactly this treatment
# (`_reap_empty_vec` + lazy `exited`, "The idle path now allocates nothing.");
# kybernet's reaper was the same shape without it. Measured after: 0 B/iter
# idle, 168 B only when a process is genuinely reaped.
fn reap_zombies() {
    var results = 0;
    # sys_waitpid writes a 4-byte int (Linux `int wstatus`) to the
    # status pointer. The pre-1.1.5 `status_buf[1]` was a 1-byte
    # stack array — the kernel wrote 3 bytes past it, corrupting
    # stack. Worked in practice because cyrius's stack alignment is
    # 8 bytes and the 3-byte overflow landed in padding, but the
    # safety property was accidental. 8 bytes for the same alignment.
    var status_buf[8];
    while (1 == 1) {
        var pid = sys_waitpid(0 - 1, &status_buf, WNOHANG);
        if (pid <= 0) { break; }
        var status = load32(&status_buf);
        var code = 0;
        if (WIFEXITED(status) == 1) {
            code = WEXITSTATUS(status);
        } elif (WIFSIGNALED(status) == 1) {
            code = 128 + WTERMSIG(status);
        }
        if (results == 0) { results = vec_new(); }
        var rp = alloc(16);
        store64(rp, pid);
        store64(rp + 8, code);
        vec_push(results, rp);
    }
    if (results == 0) { return _reap_empty_vec(); }
    return results;
}

# Get pid from ReapedProcess
fn reaped_pid(rp) { return load64(rp); }
fn reaped_code(rp) { return load64(rp + 8); }

# Reap and log each process to stderr
# Returns count of reaped processes
fn reap_and_log() {
    var reaped = reap_zombies();
    var len = vec_len(reaped);
    # One buffered sys_write per process instead of five (matches the
    # _logbuf style in log.cyr). Worst-case line is "reaped pid=" (11) +
    # i64 pid (≤21) + " exit=" (6) + i64 code (≤21) + "\n" (1) = 60 BYTES;
    # 72 leaves headroom. [N] is N bytes, not slots.
    var line[72];
    for (var ri = 0; ri < len; ri = ri + 1) {
        var rp = vec_get(reaped, ri);
        memcpy(&line, "reaped pid=", 11);
        var off = 11;
        off = off + fmt_int_buf(reaped_pid(rp), &line + off);
        memcpy(&line + off, " exit=", 6);
        off = off + 6;
        off = off + fmt_int_buf(reaped_code(rp), &line + off);
        store8(&line + off, 10);
        off = off + 1;
        sys_write(STDERR_FD, &line, off);
    }
    return len;
}

# ⚠ `any_failures` was removed at 1.6.4 — zero callers since it was written.
# Reaping outcomes are reported by reap_and_log's own klog lines; a predicate
# nobody consults is a claim the tree cannot back up.

