# kybernet/service_sandbox.cyr — per-service sandbox applied at pre_exec
# Requires: privdrop.cyr, sandbox.cyr, seccomp.cyr, argonaut types
#
# This is the payload of the 2026-08-24 audit's HIGH-1. seccomp, Landlock
# and capability drops can only be installed between fork and exec, argonaut
# owns that window, and until 1.9.0 it exposed no seam — so kybernet's 686
# lines of security code were reachable from nothing. argonaut 1.9.0 added
# `argonaut_set_pre_exec_hook`; this is the hook.
#
# It runs IN THE CHILD, after fork, after the signal-mask reset, immediately
# before execve. Returning non-zero aborts the child with exit 126 and the
# service never runs — the sandbox failing is not a reason to launch the
# service unconfined.
#
# ORDER IS LOAD-BEARING:
#   0. cgroup placement — FIRST, before any confinement (1.5.5). It needs
#                       open(2)+write(2) on /sys/fs/cgroup, and every step
#                       below can take that away: dropping CAP_DAC_OVERRIDE,
#                       a Landlock ruleset that does not grant the cgroupfs
#                       path, or a seccomp filter without openat. Placing
#                       last would work only for unconfined services.
#   1. no_new_privs   — precondition for both Landlock and seccomp, and it
#                       is what stops a setuid binary handing the privileges
#                       back on exec.
#   2. capabilities   — bounding set + the live effective/permitted sets.
#   3. Landlock       — filesystem confinement.
#   4. seccomp        — LAST. An installed filter would otherwise kill the
#                       prctl/capset/landlock calls above unless every one
#                       of them were allowlisted.
#
# POLICY IS OPT-IN PER SERVICE. argonaut's ServiceDefinition carries
# `seccomp` / `landlock` / `capabilities`, all 0 by default, and argonaut
# treats them as opaque — kybernet defines them as agnostik
# seccomp_profile / sandbox_config / capability_set pointers. A service
# with no policy gets a no-op hook and behaves exactly as before 1.4.3.
# That is deliberate: a uniform allowlist applied to every service is an
# excellent way to make a system unbootable, and PID 1 is the wrong place
# to discover that. Wiring the default AGNOS services to real profiles is
# the 1.5.x arc.
# Join the service's own cgroup from inside the child, before exec.
#
# This is what makes limits real rather than approximate. The parent cannot
# place the process without a race: argonaut owns fork+exec, so kybernet only
# learns the pid after init_start_service returns — and for a SVC_SIMPLE with
# a ready_check that is after the whole readiness poll, potentially seconds.
# Worse than late: cgroup v2 memory is charged on FIRST TOUCH and charges are
# NOT migrated when a process moves, so every page the service faulted in
# before the move stays charged to the root cgroup for the life of that
# memory. And a oneshot is never placed at all — argonaut waits for it inside
# init_start_service and returns 0, so there is no surviving pid to move.
#
# Writing the literal "0" to cgroup.procs is the kernel's documented "move
# the writer" form (cgroup_procs_write_start treats pid 0 as `current`), so
# this needs no getpid and no integer formatting.
#
# Returns 1 on failure, 0 on success or when there is nothing to do.
fn _kyb_join_cgroup(svc_def) {
    var name = svc_def_name(svc_def);
    if (name == 0) { return 0; }
    var name_cs = str_data(name);
    if (name_cs == 0) { return 0; }
    # Defence in depth. create_service_cgroup validates the name before any
    # mkdir (1.4.2 MEDIUM-3); this path builds a cgroupfs path from the same
    # input in the fork window and had no such check.
    if (cgroup_name_is_safe(name_cs) == 0) { return 1; }

    var procs = cgroup_file(name_cs, "cgroup.procs");
    var fd = sys_open(str_data(procs), O_WRONLY | O_CLOEXEC, 0);
    if (fd < 0) { return 1; }
    var w = sys_write(fd, "0", 1);
    sys_close(fd);
    if (is_err(w) == 1) { return 1; }
    return 0;
}

fn kyb_pre_exec(svc_def) {
    if (svc_def == 0) { return 0; }

    # 0. cgroup placement. FAIL-CLOSED only when the operator actually
    #    configured limits: a service that asked to be capped and would
    #    instead run uncapped is a policy violation, same as a failed
    #    capability drop. A service with no limits gets best-effort
    #    placement — losing its cgroup costs accounting and the shutdown
    #    sweep, not containment, and refusing to boot over that would be
    #    a worse failure than the one it prevents.
    var cl = svc_def_cgroup_limits(svc_def);
    if (_kyb_join_cgroup(svc_def) != 0) {
        if (cl != 0) { return 1; }
    }

    var caps = svc_def_capabilities(svc_def);
    var ll   = svc_def_landlock(svc_def);
    var sc   = svc_def_seccomp(svc_def);

    # No policy at all — nothing to enforce, and no_new_privs is not
    # imposed on services that never asked to be confined. The cgroup join
    # above already happened; limits are not a security policy in this
    # sense and do not by themselves trigger no_new_privs.
    if (caps == 0 && ll == 0 && sc == 0) { return 0; }

    # 1. no_new_privs. Defaults on for any confined service (both Landlock
    #    and seccomp require it, and it is what stops a setuid binary
    #    handing the privileges straight back on exec); a policy may opt
    #    out explicitly. 1.5.2.
    var want_nnp = 1;
    if (sc != 0) { want_nnp = kyb_policy_no_new_privs(sc); }
    if (want_nnp == 1) {
        if (is_err_result(set_no_new_privs()) == 1) { return 1; }
    }

    # 2. capabilities
    if (caps != 0) {
        if (is_err_result(drop_caps_from_set(caps)) == 1) { return 1; }
    }

    # 3. Landlock
    #
    # ⚠ Ok(1) IS NOT SUCCESS. `sandbox_apply` answers Ok(0) for "applied" and
    # Ok(1) for "this kernel has no Landlock" (ENOSYS/EOPNOTSUPP). Testing
    # only `is_err_result` — which is what this did from 1.4.3 to 1.6.0 — let
    # a service that configured an explicit rule list start with NO filesystem
    # confinement while this hook reported success. That is exactly the
    # outcome the header above calls the one worse than not running at all,
    # and it is what README means by "fails closed".
    #
    # Failing closed here exits the child 126 (argonaut's pre-exec-hook
    # contract), so the operator sees a service that refuses to start rather
    # than one that quietly lost its policy. `"landlock_optional": true` is
    # the deliberate opt-out for a board on a pre-5.13 kernel.
    if (ll != 0) {
        var lr = sandbox_from_config(ll);
        if (is_err_result(lr) == 1) {
            # ⚠ SAY WHY. Until 1.6.6 this returned 1 silently, so the operator
            # saw only "FAILED to start: <service>" with nothing naming the
            # cause. The overwhelmingly common cause is a rule naming a path
            # that does not exist: `_landlock_add_path` opens each one O_PATH
            # and returns the errno, which fails the whole ruleset. That cost a
            # full CI round trip to diagnose when kyb-landlock named /lib64 on
            # an image that had none.
            #
            # kmsg() rather than klog(): this runs in the pre-exec child, whose
            # stdout/stderr belong to the service, and /dev/kmsg is opened fresh
            # so it works regardless of what the child inherited.
            kmsg("kybernet: pre-exec: LANDLOCK FAILED - a rule path is unopenable (does every path exist?)");
            return 1;
        }
        if (result_unwrap(lr) == 1) {
            var ll_opt = 0;
            if (sc != 0) { ll_opt = kyb_policy_landlock_optional(sc); }
            if (ll_opt == 0) {
                kmsg("kybernet: pre-exec: no Landlock in kernel, landlock_optional=false");
                kmsg("kybernet: pre-exec: refusing to start the service unconfined");
                return 1;
            }
        }
    }

    # 4. seccomp — last. `sc` is kybernet's KybSeccompPolicy (argonaut
    #    treats the field as opaque), naming a profile rather than carrying
    #    a raw syscall list: a filter is not something to hand-assemble in
    #    a config file, and a wrong one is a service that dies on its first
    #    read().
    if (sc != 0) {
        if (kyb_policy_kind(sc) == SECCOMP_BASIC) {
            if (is_err_result(seccomp_apply(seccomp_basic_service())) == 1) { return 1; }
        }
    }

    return 0;
}

